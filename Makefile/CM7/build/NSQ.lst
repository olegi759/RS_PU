 108:../../opus/silk/Inlines.h **** 
 109:../../opus/silk/Inlines.h ****     /* Compute number of bits head room and normalize inputs */
 110:../../opus/silk/Inlines.h ****     a_headrm = silk_CLZ32( silk_abs(a32) ) - 1;
