 129:../../opus/silk/Inlines.h ****     lshift = 29 + a_headrm - b_headrm - Qres;
 130:../../opus/silk/Inlines.h ****     if( lshift < 0 ) {
 131:../../opus/silk/Inlines.h ****         return silk_LSHIFT_SAT32(result, -lshift);
 132:../../opus/silk/Inlines.h ****     } else {
 133:../../opus/silk/Inlines.h ****         if( lshift < 32){
 134:../../opus/silk/Inlines.h ****             return silk_RSHIFT(result, lshift);
 135:../../opus/silk/Inlines.h ****         } else {
