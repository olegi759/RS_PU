  35:../../opus/celt/entdec.c **** 
  36:../../opus/celt/entdec.c **** /*A range decoder.
  37:../../opus/celt/entdec.c ****   This is an entropy decoder based upon \cite{Mar79}, which is itself a
  38:../../opus/celt/entdec.c ****    rediscovery of the FIFO arithmetic code introduced by \cite{Pas76}.
  39:../../opus/celt/entdec.c ****   It is very similar to arithmetic encoding, except that encoding is done with
  40:../../opus/celt/entdec.c ****    digits in any base, instead of with bits, and so it is faster when using
  41:../../opus/celt/entdec.c ****    larger bases (i.e.: a byte).
  42:../../opus/celt/entdec.c ****   The author claims an average waste of $\frac{1}{2}\log_b(2b)$ bits, where $b$
  43:../../opus/celt/entdec.c ****    is the base, longer than the theoretical optimum, but to my knowledge there
  44:../../opus/celt/entdec.c ****    is no published justification for this claim.
  45:../../opus/celt/entdec.c ****   This only seems true when using near-infinite precision arithmetic so that
  46:../../opus/celt/entdec.c ****    the process is carried out with no rounding errors.
  47:../../opus/celt/entdec.c **** 
  48:../../opus/celt/entdec.c ****   An excellent description of implementation details is available at
  49:../../opus/celt/entdec.c ****    http://www.arturocampos.com/ac_range.html
  50:../../opus/celt/entdec.c ****   A recent work \cite{MNW98} which proposes several changes to arithmetic
  51:../../opus/celt/entdec.c ****    encoding for efficiency actually re-discovers many of the principles
  52:../../opus/celt/entdec.c ****    behind range encoding, and presents a good theoretical analysis of them.
  53:../../opus/celt/entdec.c **** 
  54:../../opus/celt/entdec.c ****   End of stream is handled by writing out the smallest number of bits that
  55:../../opus/celt/entdec.c ****    ensures that the stream will be correctly decoded regardless of the value of
  56:../../opus/celt/entdec.c ****    any subsequent bits.
  57:../../opus/celt/entdec.c ****   ec_tell() can be used to determine how many bits were needed to decode
  58:../../opus/celt/entdec.c ****    all the symbols thus far; other data can be packed in the remaining bits of
  59:../../opus/celt/entdec.c ****    the input buffer.
  60:../../opus/celt/entdec.c ****   @PHDTHESIS{Pas76,
  61:../../opus/celt/entdec.c ****     author="Richard Clark Pasco",
  62:../../opus/celt/entdec.c ****     title="Source coding algorithms for fast data compression",
  63:../../opus/celt/entdec.c ****     school="Dept. of Electrical Engineering, Stanford University",
  64:../../opus/celt/entdec.c ****     address="Stanford, CA",
  65:../../opus/celt/entdec.c ****     month=May,
  66:../../opus/celt/entdec.c ****     year=1976
  67:../../opus/celt/entdec.c ****   }
  68:../../opus/celt/entdec.c ****   @INPROCEEDINGS{Mar79,
  69:../../opus/celt/entdec.c ****    author="Martin, G.N.N.",
  70:../../opus/celt/entdec.c ****    title="Range encoding: an algorithm for removing redundancy from a digitised
  71:../../opus/celt/entdec.c ****     message",
  72:../../opus/celt/entdec.c ****    booktitle="Video & Data Recording Conference",
  73:../../opus/celt/entdec.c ****    year=1979,
  74:../../opus/celt/entdec.c ****    address="Southampton",
  75:../../opus/celt/entdec.c ****    month=Jul
  76:../../opus/celt/entdec.c ****   }
  77:../../opus/celt/entdec.c ****   @ARTICLE{MNW98,
  78:../../opus/celt/entdec.c ****    author="Alistair Moffat and Radford Neal and Ian H. Witten",
  79:../../opus/celt/entdec.c ****    title="Arithmetic Coding Revisited",
  80:../../opus/celt/entdec.c ****    journal="{ACM} Transactions on Information Systems",
  81:../../opus/celt/entdec.c ****    year=1998,
  82:../../opus/celt/entdec.c ****    volume=16,
  83:../../opus/celt/entdec.c ****    number=3,
  84:../../opus/celt/entdec.c ****    pages="256--294",
  85:../../opus/celt/entdec.c ****    month=Jul,
  86:../../opus/celt/entdec.c ****    URL="http://www.stanford.edu/class/ee398a/handouts/papers/Moffat98ArithmCoding.pdf"
  87:../../opus/celt/entdec.c ****   }*/
  88:../../opus/celt/entdec.c **** 
