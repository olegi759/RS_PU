 557:../../CM7/Core/Src/pu.c **** //запустить трансляцию с следующим УО
 558:../../CM7/Core/Src/pu.c **** BOOL pu_start_translation_pojar_next_uo(void)
 559:../../CM7/Core/Src/pu.c **** {
 560:../../CM7/Core/Src/pu.c **** 	uint8_t cnt;
 561:../../CM7/Core/Src/pu.c **** 
 562:../../CM7/Core/Src/pu.c **** 	cnt = 9;
 563:../../CM7/Core/Src/pu.c **** 	while (cnt) {
 564:../../CM7/Core/Src/pu.c ****           pu_uo_fire++;
 565:../../CM7/Core/Src/pu.c ****           if (pu_uo_fire > 10) { //прошли все 10 УО
 566:../../CM7/Core/Src/pu.c **** 
 567:../../CM7/Core/Src/pu.c ****         	  if (setting.fire_cycle) {
 568:../../CM7/Core/Src/pu.c ****         		  pu_uo_fire = pu_last_active_fire_uo; //Сработавший УО
 569:../../CM7/Core/Src/pu.c ****         	  }
 570:../../CM7/Core/Src/pu.c ****         	  else pu_uo_fire = 1;
 571:../../CM7/Core/Src/pu.c **** 
 572:../../CM7/Core/Src/pu.c ****           }
 573:../../CM7/Core/Src/pu.c ****       	  if (pu_start_translation_pojar_now_uo())  {
 574:../../CM7/Core/Src/pu.c ****       		  pu_last_active_fire_uo = pu_uo_fire; //Сработавший УО
 575:../../CM7/Core/Src/pu.c ****       		  return TRUE;
 576:../../CM7/Core/Src/pu.c ****       	  }
 577:../../CM7/Core/Src/pu.c ****       	  cnt--;
 578:../../CM7/Core/Src/pu.c **** 	}
 579:../../CM7/Core/Src/pu.c **** 
 580:../../CM7/Core/Src/pu.c **** 	return FALSE;
 581:../../CM7/Core/Src/pu.c **** }
