  80:../../opus/celt/mathops.h **** static OPUS_INLINE opus_val32 celt_maxabs16(const opus_val16 *x, int len)
  81:../../opus/celt/mathops.h **** {
  82:../../opus/celt/mathops.h ****    int i;
  83:../../opus/celt/mathops.h ****    opus_val16 maxval = 0;
  84:../../opus/celt/mathops.h ****    opus_val16 minval = 0;
