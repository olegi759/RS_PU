  38:../../opus/celt/mathops.c **** /*Compute floor(sqrt(_val)) with exact arithmetic.
  39:../../opus/celt/mathops.c ****   _val must be greater than 0.
  40:../../opus/celt/mathops.c ****   This has been tested on all possible 32-bit inputs greater than 0.*/
  41:../../opus/celt/mathops.c **** unsigned isqrt32(opus_uint32 _val){
  42:../../opus/celt/mathops.c ****   unsigned b;
  43:../../opus/celt/mathops.c ****   unsigned g;
  44:../../opus/celt/mathops.c ****   int      bshift;
  45:../../opus/celt/mathops.c ****   /*Uses the second method from
  46:../../opus/celt/mathops.c ****      http://www.azillionmonkeys.com/qed/sqroot.html
  47:../../opus/celt/mathops.c ****     The main idea is to search for the largest binary digit b such that
  48:../../opus/celt/mathops.c ****      (g+b)*(g+b) <= _val, and add it to the solution g.*/
  49:../../opus/celt/mathops.c ****   g=0;
  50:../../opus/celt/mathops.c ****   bshift=(EC_ILOG(_val)-1)>>1;
  51:../../opus/celt/mathops.c ****   b=1U<<bshift;
  52:../../opus/celt/mathops.c ****   do{
  53:../../opus/celt/mathops.c ****     opus_uint32 t;
  54:../../opus/celt/mathops.c ****     t=(((opus_uint32)g<<1)+b)<<bshift;
  55:../../opus/celt/mathops.c ****     if(t<=_val){
  56:../../opus/celt/mathops.c ****       g+=b;
  57:../../opus/celt/mathops.c ****       _val-=t;
  58:../../opus/celt/mathops.c ****     }
  59:../../opus/celt/mathops.c ****     b>>=1;
  60:../../opus/celt/mathops.c ****     bshift--;
  61:../../opus/celt/mathops.c ****   }
  62:../../opus/celt/mathops.c ****   while(bshift>=0);
  63:../../opus/celt/mathops.c ****   return g;
  64:../../opus/celt/mathops.c **** }
  65:../../opus/celt/mathops.c **** 
  66:../../opus/celt/mathops.c **** #ifdef FIXED_POINT
  67:../../opus/celt/mathops.c **** 
  68:../../opus/celt/mathops.c **** opus_val32 frac_div32(opus_val32 a, opus_val32 b)
  69:../../opus/celt/mathops.c **** {
  70:../../opus/celt/mathops.c ****    opus_val16 rcp;
  71:../../opus/celt/mathops.c ****    opus_val32 result, rem;
  72:../../opus/celt/mathops.c ****    int shift = celt_ilog2(b)-29;
  73:../../opus/celt/mathops.c ****    a = VSHR32(a,shift);
  74:../../opus/celt/mathops.c ****    b = VSHR32(b,shift);
  75:../../opus/celt/mathops.c ****    /* 16-bit reciprocal */
  76:../../opus/celt/mathops.c ****    rcp = ROUND16(celt_rcp(ROUND16(b,16)),3);
  77:../../opus/celt/mathops.c ****    result = MULT16_32_Q15(rcp, a);
  78:../../opus/celt/mathops.c ****    rem = PSHR32(a,2)-MULT32_32_Q31(result, b);
  79:../../opus/celt/mathops.c ****    result = ADD32(result, SHL32(MULT16_32_Q15(rcp, rem),2));
  80:../../opus/celt/mathops.c ****    if (result >= 536870912)       /*  2^29 */
  81:../../opus/celt/mathops.c ****       return 2147483647;          /*  2^31 - 1 */
  82:../../opus/celt/mathops.c ****    else if (result <= -536870912) /* -2^29 */
  83:../../opus/celt/mathops.c ****       return -2147483647;         /* -2^31 */
  84:../../opus/celt/mathops.c ****    else
  85:../../opus/celt/mathops.c ****       return SHL32(result, 2);
  86:../../opus/celt/mathops.c **** }
  87:../../opus/celt/mathops.c **** 
  88:../../opus/celt/mathops.c **** /** Reciprocal sqrt approximation in the range [0.25,1) (Q16 in, Q14 out) */
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccMf9bFB.s 			page 3


  89:../../opus/celt/mathops.c **** opus_val16 celt_rsqrt_norm(opus_val32 x)
  90:../../opus/celt/mathops.c **** {
  91:../../opus/celt/mathops.c ****    opus_val16 n;
  92:../../opus/celt/mathops.c ****    opus_val16 r;
  93:../../opus/celt/mathops.c ****    opus_val16 r2;
  94:../../opus/celt/mathops.c ****    opus_val16 y;
  95:../../opus/celt/mathops.c ****    /* Range of n is [-16384,32767] ([-0.5,1) in Q15). */
  96:../../opus/celt/mathops.c ****    n = x-32768;
  97:../../opus/celt/mathops.c ****    /* Get a rough initial guess for the root.
  98:../../opus/celt/mathops.c ****       The optimal minimax quadratic approximation (using relative error) is
  99:../../opus/celt/mathops.c ****        r = 1.437799046117536+n*(-0.823394375837328+n*0.4096419668459485).
 100:../../opus/celt/mathops.c ****       Coefficients here, and the final result r, are Q14.*/
 101:../../opus/celt/mathops.c ****    r = ADD16(23557, MULT16_16_Q15(n, ADD16(-13490, MULT16_16_Q15(n, 6713))));
 102:../../opus/celt/mathops.c ****    /* We want y = x*r*r-1 in Q15, but x is 32-bit Q16 and r is Q14.
 103:../../opus/celt/mathops.c ****       We can compute the result from n and r using Q15 multiplies with some
 104:../../opus/celt/mathops.c ****        adjustment, carefully done to avoid overflow.
 105:../../opus/celt/mathops.c ****       Range of y is [-1564,1594]. */
 106:../../opus/celt/mathops.c ****    r2 = MULT16_16_Q15(r, r);
 107:../../opus/celt/mathops.c ****    y = SHL16(SUB16(ADD16(MULT16_16_Q15(r2, n), r2), 16384), 1);
 108:../../opus/celt/mathops.c ****    /* Apply a 2nd-order Householder iteration: r += r*y*(y*0.375-0.5).
 109:../../opus/celt/mathops.c ****       This yields the Q14 reciprocal square root of the Q16 x, with a maximum
 110:../../opus/celt/mathops.c ****        relative error of 1.04956E-4, a (relative) RMSE of 2.80979E-5, and a
 111:../../opus/celt/mathops.c ****        peak absolute error of 2.26591/16384. */
 112:../../opus/celt/mathops.c ****    return ADD16(r, MULT16_16_Q15(r, MULT16_16_Q15(y,
 113:../../opus/celt/mathops.c ****               SUB16(MULT16_16_Q15(y, 12288), 16384))));
 114:../../opus/celt/mathops.c **** }
 115:../../opus/celt/mathops.c **** 
 116:../../opus/celt/mathops.c **** /** Sqrt approximation (QX input, QX/2 output) */
 117:../../opus/celt/mathops.c **** opus_val32 celt_sqrt(opus_val32 x)
 118:../../opus/celt/mathops.c **** {
 119:../../opus/celt/mathops.c ****    int k;
 120:../../opus/celt/mathops.c ****    opus_val16 n;
 121:../../opus/celt/mathops.c ****    opus_val32 rt;
 122:../../opus/celt/mathops.c ****    static const opus_val16 C[5] = {23175, 11561, -3011, 1699, -664};
 123:../../opus/celt/mathops.c ****    if (x==0)
 124:../../opus/celt/mathops.c ****       return 0;
 125:../../opus/celt/mathops.c ****    else if (x>=1073741824)
 126:../../opus/celt/mathops.c ****       return 32767;
 127:../../opus/celt/mathops.c ****    k = (celt_ilog2(x)>>1)-7;
 128:../../opus/celt/mathops.c ****    x = VSHR32(x, 2*k);
 129:../../opus/celt/mathops.c ****    n = x-32768;
 130:../../opus/celt/mathops.c ****    rt = ADD16(C[0], MULT16_16_Q15(n, ADD16(C[1], MULT16_16_Q15(n, ADD16(C[2],
 131:../../opus/celt/mathops.c ****               MULT16_16_Q15(n, ADD16(C[3], MULT16_16_Q15(n, (C[4])))))))));
 132:../../opus/celt/mathops.c ****    rt = VSHR32(rt,7-k);
 133:../../opus/celt/mathops.c ****    return rt;
 134:../../opus/celt/mathops.c **** }
