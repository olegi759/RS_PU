 527:../../opus/celt/celt_encoder.c **** 
 528:../../opus/celt/celt_encoder.c **** #ifndef FIXED_POINT
 529:../../opus/celt/celt_encoder.c ****    if (clip)
 530:../../opus/celt/celt_encoder.c ****    {
 531:../../opus/celt/celt_encoder.c ****       /* Clip input to avoid encoding non-portable files */
 532:../../opus/celt/celt_encoder.c ****       for (i=0;i<Nu;i++)
 533:../../opus/celt/celt_encoder.c ****          inp[i*upsample] = MAX32(-65536.f, MIN32(65536.f,inp[i*upsample]));
 534:../../opus/celt/celt_encoder.c ****    }
 535:../../opus/celt/celt_encoder.c **** #else
 536:../../opus/celt/celt_encoder.c ****    (void)clip; /* Avoids a warning about clip being unused. */
 537:../../opus/celt/celt_encoder.c **** #endif
