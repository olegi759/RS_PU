 743:../../opus/celt/celt_encoder.c **** static void tf_encode(int start, int end, int isTransient, int *tf_res, int LM, int tf_select, ec_e
 744:../../opus/celt/celt_encoder.c **** {
 745:../../opus/celt/celt_encoder.c ****    int curr, i;
 746:../../opus/celt/celt_encoder.c ****    int tf_select_rsv;
 747:../../opus/celt/celt_encoder.c ****    int tf_changed;
 748:../../opus/celt/celt_encoder.c ****    int logp;
 749:../../opus/celt/celt_encoder.c ****    opus_uint32 budget;
 750:../../opus/celt/celt_encoder.c ****    opus_uint32 tell;
 751:../../opus/celt/celt_encoder.c ****    budget = enc->storage*8;
 752:../../opus/celt/celt_encoder.c ****    tell = ec_tell(enc);
 753:../../opus/celt/celt_encoder.c ****    logp = isTransient ? 2 : 4;
 754:../../opus/celt/celt_encoder.c ****    /* Reserve space to code the tf_select decision. */
 755:../../opus/celt/celt_encoder.c ****    tf_select_rsv = LM>0 && tell+logp+1 <= budget;
 756:../../opus/celt/celt_encoder.c ****    budget -= tf_select_rsv;
 757:../../opus/celt/celt_encoder.c ****    curr = tf_changed = 0;
 758:../../opus/celt/celt_encoder.c ****    for (i=start;i<end;i++)
 759:../../opus/celt/celt_encoder.c ****    {
 760:../../opus/celt/celt_encoder.c ****       if (tell+logp<=budget)
 761:../../opus/celt/celt_encoder.c ****       {
 762:../../opus/celt/celt_encoder.c ****          ec_enc_bit_logp(enc, tf_res[i] ^ curr, logp);
 763:../../opus/celt/celt_encoder.c ****          tell = ec_tell(enc);
 764:../../opus/celt/celt_encoder.c ****          curr = tf_res[i];
 765:../../opus/celt/celt_encoder.c ****          tf_changed |= curr;
 766:../../opus/celt/celt_encoder.c ****       }
