 767:../../opus/celt/celt_encoder.c ****       else
 768:../../opus/celt/celt_encoder.c ****          tf_res[i] = curr;
 769:../../opus/celt/celt_encoder.c ****       logp = isTransient ? 4 : 5;
 770:../../opus/celt/celt_encoder.c ****    }
 771:../../opus/celt/celt_encoder.c ****    /* Only code tf_select if it would actually make a difference. */
 772:../../opus/celt/celt_encoder.c ****    if (tf_select_rsv &&
 773:../../opus/celt/celt_encoder.c ****          tf_select_table[LM][4*isTransient+0+tf_changed]!=
 774:../../opus/celt/celt_encoder.c ****          tf_select_table[LM][4*isTransient+2+tf_changed])
 775:../../opus/celt/celt_encoder.c ****       ec_enc_bit_logp(enc, tf_select, 1);
 776:../../opus/celt/celt_encoder.c ****    else
