 446:../../opus/celt/celt_encoder.c **** /** Apply window and compute the MDCT for all sub-frames and
 447:../../opus/celt/celt_encoder.c ****     all channels in a frame */
 448:../../opus/celt/celt_encoder.c **** static void compute_mdcts(const CELTMode *mode, int shortBlocks, celt_sig * OPUS_RESTRICT in,
 449:../../opus/celt/celt_encoder.c ****                           celt_sig * OPUS_RESTRICT out, int C, int CC, int LM, int upsample,
 450:../../opus/celt/celt_encoder.c ****                           int arch)
 451:../../opus/celt/celt_encoder.c **** {
 452:../../opus/celt/celt_encoder.c ****    const int overlap = mode->overlap;
 453:../../opus/celt/celt_encoder.c ****    int N;
 454:../../opus/celt/celt_encoder.c ****    int B;
 455:../../opus/celt/celt_encoder.c ****    int shift;
 456:../../opus/celt/celt_encoder.c ****    int i, b, c;
 457:../../opus/celt/celt_encoder.c ****    if (shortBlocks)
 458:../../opus/celt/celt_encoder.c ****    {
 459:../../opus/celt/celt_encoder.c ****       B = shortBlocks;
 460:../../opus/celt/celt_encoder.c ****       N = mode->shortMdctSize;
 461:../../opus/celt/celt_encoder.c ****       shift = mode->maxLM;
 462:../../opus/celt/celt_encoder.c ****    } else {
 463:../../opus/celt/celt_encoder.c ****       B = 1;
 464:../../opus/celt/celt_encoder.c ****       N = mode->shortMdctSize<<LM;
 465:../../opus/celt/celt_encoder.c ****       shift = mode->maxLM-LM;
 466:../../opus/celt/celt_encoder.c ****    }
 467:../../opus/celt/celt_encoder.c ****    c=0; do {
 468:../../opus/celt/celt_encoder.c ****       for (b=0;b<B;b++)
 469:../../opus/celt/celt_encoder.c ****       {
 470:../../opus/celt/celt_encoder.c ****          /* Interleaving the sub-frames while doing the MDCTs */
 471:../../opus/celt/celt_encoder.c ****          clt_mdct_forward(&mode->mdct, in+c*(B*N+overlap)+b*N,
 472:../../opus/celt/celt_encoder.c ****                           &out[b+c*N*B], mode->window, overlap, shift, B,
 473:../../opus/celt/celt_encoder.c ****                           arch);
 474:../../opus/celt/celt_encoder.c ****       }
 475:../../opus/celt/celt_encoder.c ****    } while (++c<CC);
 476:../../opus/celt/celt_encoder.c ****    if (CC==2&&C==1)
 477:../../opus/celt/celt_encoder.c ****    {
 478:../../opus/celt/celt_encoder.c ****       for (i=0;i<B*N;i++)
 479:../../opus/celt/celt_encoder.c ****          out[i] = ADD32(HALF32(out[i]), HALF32(out[B*N+i]));
 480:../../opus/celt/celt_encoder.c ****    }
 481:../../opus/celt/celt_encoder.c ****    if (upsample != 1)
 482:../../opus/celt/celt_encoder.c ****    {
 483:../../opus/celt/celt_encoder.c ****       c=0; do
 484:../../opus/celt/celt_encoder.c ****       {
 485:../../opus/celt/celt_encoder.c ****          int bound = B*N/upsample;
 486:../../opus/celt/celt_encoder.c ****          for (i=0;i<bound;i++)
 487:../../opus/celt/celt_encoder.c ****             out[c*B*N+i] *= upsample;
 488:../../opus/celt/celt_encoder.c ****          OPUS_CLEAR(&out[c*B*N+bound], B*N-bound);
 489:../../opus/celt/celt_encoder.c ****       } while (++c<C);
 490:../../opus/celt/celt_encoder.c ****    }
 491:../../opus/celt/celt_encoder.c **** }
