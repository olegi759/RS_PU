ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccHIlDBY.s 			page 3


  88:../../opus/celt/mathops.h ****       minval = MIN16(minval, x[i]);
  89:../../opus/celt/mathops.h ****    }
  90:../../opus/celt/mathops.h ****    return MAX32(EXTEND32(maxval),-EXTEND32(minval));
  91:../../opus/celt/mathops.h **** }
  92:../../opus/celt/mathops.h **** #endif
  93:../../opus/celt/mathops.h **** 
