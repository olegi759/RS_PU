 346:../../opus/celt/celt_encoder.c ****       /* Compute the ratio of the "frame energy" over the harmonic mean of the energy.
 347:../../opus/celt/celt_encoder.c ****          This essentially corresponds to a bitrate-normalized temporal noise-to-mask
 348:../../opus/celt/celt_encoder.c ****          ratio */
 349:../../opus/celt/celt_encoder.c **** 
 350:../../opus/celt/celt_encoder.c ****       /* As a compromise with the old transient detector, frame energy is the
 351:../../opus/celt/celt_encoder.c ****          geometric mean of the energy and half the max */
 352:../../opus/celt/celt_encoder.c **** #ifdef FIXED_POINT
