 140:../../opus/celt/mathops.h ****    in.i -= (opus_uint32)integer<<23;
 141:../../opus/celt/mathops.h ****    frac = in.f - 1.5f;
 142:../../opus/celt/mathops.h ****    frac = -0.41445418f + frac*(0.95909232f
 143:../../opus/celt/mathops.h ****           + frac*(-0.33951290f + frac*0.16541097f));
