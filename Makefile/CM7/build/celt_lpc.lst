  88:../../opus/celt/celt_lpc.c ****       /* Convert the int32 lpcs to int16 and ensure there are no wrap-arounds.
  89:../../opus/celt/celt_lpc.c ****          This reuses the logic in silk_LPC_fit() and silk_bwexpander_32(). Any bug
  90:../../opus/celt/celt_lpc.c ****          fixes should also be applied there. */
  91:../../opus/celt/celt_lpc.c ****       int iter, idx = 0;
