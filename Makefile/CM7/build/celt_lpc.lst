 106:../../opus/celt/celt_lpc.c ****             maxabs = MIN32(maxabs, 163838);
 107:../../opus/celt/celt_lpc.c ****             chirp_Q16 = QCONST32(0.999, 16) - DIV32(SHL32(maxabs - 32767, 14),
 108:../../opus/celt/celt_lpc.c ****                                                     SHR32(MULT32_32_32(maxabs, idx + 1), 2));
 109:../../opus/celt/celt_lpc.c ****             chirp_minus_one_Q16 = chirp_Q16 - 65536;
