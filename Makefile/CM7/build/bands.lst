 812:../../opus/celt/bands.c ****             ec_encode(ec, fl, fl+fs, ft);
 813:../../opus/celt/bands.c ****          } else {
 814:../../opus/celt/bands.c ****             /* Triangular pdf */
 815:../../opus/celt/bands.c ****             int fl=0;
 816:../../opus/celt/bands.c ****             int fm;
 817:../../opus/celt/bands.c ****             fm = ec_decode(ec, ft);
 818:../../opus/celt/bands.c **** 
 819:../../opus/celt/bands.c ****             if (fm < ((qn>>1)*((qn>>1) + 1)>>1))
 820:../../opus/celt/bands.c ****             {
 821:../../opus/celt/bands.c ****                itheta = (isqrt32(8*(opus_uint32)fm + 1) - 1)>>1;
 822:../../opus/celt/bands.c ****                fs = itheta + 1;
 823:../../opus/celt/bands.c ****                fl = itheta*(itheta + 1)>>1;
 824:../../opus/celt/bands.c ****             }
 825:../../opus/celt/bands.c ****             else
 826:../../opus/celt/bands.c ****             {
 827:../../opus/celt/bands.c ****                itheta = (2*(qn + 1)
 828:../../opus/celt/bands.c ****                 - isqrt32(8*(opus_uint32)(ft - fm - 1) + 1))>>1;
 829:../../opus/celt/bands.c ****                fs = qn + 1 - itheta;
 830:../../opus/celt/bands.c ****                fl = ft - ((qn + 1 - itheta)*(qn + 2 - itheta)>>1);
 831:../../opus/celt/bands.c ****             }
 832:../../opus/celt/bands.c **** 
 833:../../opus/celt/bands.c ****             ec_dec_update(ec, fl, fl+fs, ft);
 834:../../opus/celt/bands.c ****          }
 835:../../opus/celt/bands.c ****       }
 836:../../opus/celt/bands.c ****       celt_assert(itheta>=0);
 837:../../opus/celt/bands.c ****       itheta = celt_udiv((opus_int32)itheta*16384, qn);
 838:../../opus/celt/bands.c ****       if (encode && stereo)
 839:../../opus/celt/bands.c ****       {
 840:../../opus/celt/bands.c ****          if (itheta==0)
 841:../../opus/celt/bands.c ****             intensity_stereo(m, X, Y, bandE, i, N);
 842:../../opus/celt/bands.c ****          else
 843:../../opus/celt/bands.c ****             stereo_split(X, Y, N);
 844:../../opus/celt/bands.c ****       }
 845:../../opus/celt/bands.c ****       /* NOTE: Renormalising X and Y *may* help fixed-point a bit at very high rate.
 846:../../opus/celt/bands.c ****                Let's do that at higher complexity */
 847:../../opus/celt/bands.c ****    } else if (stereo) {
 848:../../opus/celt/bands.c ****       if (encode)
 849:../../opus/celt/bands.c ****       {
 850:../../opus/celt/bands.c ****          inv = itheta > 8192 && !ctx->disable_inv;
 851:../../opus/celt/bands.c ****          if (inv)
 852:../../opus/celt/bands.c ****          {
 853:../../opus/celt/bands.c ****             int j;
 854:../../opus/celt/bands.c ****             for (j=0;j<N;j++)
 855:../../opus/celt/bands.c ****                Y[j] = -Y[j];
 856:../../opus/celt/bands.c ****          }
 857:../../opus/celt/bands.c ****          intensity_stereo(m, X, Y, bandE, i, N);
 858:../../opus/celt/bands.c ****       }
 859:../../opus/celt/bands.c ****       if (*b>2<<BITRES && ctx->remaining_bits > 2<<BITRES)
 860:../../opus/celt/bands.c ****       {
 861:../../opus/celt/bands.c ****          if (encode)
