 862:../../opus/celt/bands.c ****             ec_enc_bit_logp(ec, inv, 2);
 863:../../opus/celt/bands.c ****          else
 864:../../opus/celt/bands.c ****             inv = ec_dec_bit_logp(ec, 2);
 865:../../opus/celt/bands.c ****       } else
 866:../../opus/celt/bands.c ****          inv = 0;
 867:../../opus/celt/bands.c ****       /* inv flag override to avoid problems with downmixing. */
 868:../../opus/celt/bands.c ****       if (ctx->disable_inv)
 869:../../opus/celt/bands.c ****          inv = 0;
 870:../../opus/celt/bands.c ****       itheta = 0;
 871:../../opus/celt/bands.c ****    }
 872:../../opus/celt/bands.c ****    qalloc = ec_tell_frac(ec) - tell;
 873:../../opus/celt/bands.c ****    *b -= qalloc;
 874:../../opus/celt/bands.c **** 
