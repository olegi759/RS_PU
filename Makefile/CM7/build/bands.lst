 362:../../opus/celt/bands.c **** /* Compute the weights to use for optimizing normalized distortion across
 363:../../opus/celt/bands.c ****    channels. We use the amplitude to weight square distortion, which means
 364:../../opus/celt/bands.c ****    that we use the square root of the value we would have been using if we
 365:../../opus/celt/bands.c ****    wanted to minimize the MSE in the non-normalized domain. This roughly
 366:../../opus/celt/bands.c ****    corresponds to some quick-and-dirty perceptual experiments I ran to
 367:../../opus/celt/bands.c ****    measure inter-aural masking (there doesn't seem to be any published data
 368:../../opus/celt/bands.c ****    on the topic). */
 369:../../opus/celt/bands.c **** static void compute_channel_weights(celt_ener Ex, celt_ener Ey, opus_val16 w[2])
 370:../../opus/celt/bands.c **** {
 371:../../opus/celt/bands.c ****    celt_ener minE;
 372:../../opus/celt/bands.c **** #ifdef FIXED_POINT
 373:../../opus/celt/bands.c ****    int shift;
 374:../../opus/celt/bands.c **** #endif
 375:../../opus/celt/bands.c ****    minE = MIN32(Ex, Ey);
 376:../../opus/celt/bands.c ****    /* Adjustment to make the weights a bit more conservative. */
 377:../../opus/celt/bands.c ****    Ex = ADD32(Ex, minE/3);
 378:../../opus/celt/bands.c ****    Ey = ADD32(Ey, minE/3);
 379:../../opus/celt/bands.c **** #ifdef FIXED_POINT
 380:../../opus/celt/bands.c ****    shift = celt_ilog2(EPSILON+MAX32(Ex, Ey))-14;
 381:../../opus/celt/bands.c **** #endif
 382:../../opus/celt/bands.c ****    w[0] = VSHR32(Ex, shift);
 383:../../opus/celt/bands.c ****    w[1] = VSHR32(Ey, shift);
ARM GAS  C:\Users\oleg\AppData\Local\Temp\cc2Tml9e.s 			page 24


 384:../../opus/celt/bands.c **** }
