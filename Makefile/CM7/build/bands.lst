 477:../../opus/celt/bands.c **** int spreading_decision(const CELTMode *m, const celt_norm *X, int *average,
 478:../../opus/celt/bands.c ****       int last_decision, int *hf_average, int *tapset_decision, int update_hf,
 479:../../opus/celt/bands.c ****       int end, int C, int M, const int *spread_weight)
 480:../../opus/celt/bands.c **** {
 481:../../opus/celt/bands.c ****    int i, c, N0;
 482:../../opus/celt/bands.c ****    int sum = 0, nbBands=0;
 483:../../opus/celt/bands.c ****    const opus_int16 * OPUS_RESTRICT eBands = m->eBands;
 484:../../opus/celt/bands.c ****    int decision;
 485:../../opus/celt/bands.c ****    int hf_sum=0;
 486:../../opus/celt/bands.c **** 
 487:../../opus/celt/bands.c ****    celt_assert(end>0);
 488:../../opus/celt/bands.c **** 
 489:../../opus/celt/bands.c ****    N0 = M*m->shortMdctSize;
 490:../../opus/celt/bands.c **** 
 491:../../opus/celt/bands.c ****    if (M*(eBands[end]-eBands[end-1]) <= 8)
 492:../../opus/celt/bands.c ****       return SPREAD_NONE;
 493:../../opus/celt/bands.c ****    c=0; do {
 494:../../opus/celt/bands.c ****       for (i=0;i<end;i++)
 495:../../opus/celt/bands.c ****       {
 496:../../opus/celt/bands.c ****          int j, N, tmp=0;
 497:../../opus/celt/bands.c ****          int tcount[3] = {0,0,0};
 498:../../opus/celt/bands.c ****          const celt_norm * OPUS_RESTRICT x = X+M*eBands[i]+c*N0;
 499:../../opus/celt/bands.c ****          N = M*(eBands[i+1]-eBands[i]);
 500:../../opus/celt/bands.c ****          if (N<=8)
 501:../../opus/celt/bands.c ****             continue;
 502:../../opus/celt/bands.c ****          /* Compute rough CDF of |x[j]| */
 503:../../opus/celt/bands.c ****          for (j=0;j<N;j++)
 504:../../opus/celt/bands.c ****          {
 505:../../opus/celt/bands.c ****             opus_val32 x2N; /* Q13 */
 506:../../opus/celt/bands.c **** 
 507:../../opus/celt/bands.c ****             x2N = MULT16_16(MULT16_16_Q15(x[j], x[j]), N);
 508:../../opus/celt/bands.c ****             if (x2N < QCONST16(0.25f,13))
 509:../../opus/celt/bands.c ****                tcount[0]++;
 510:../../opus/celt/bands.c ****             if (x2N < QCONST16(0.0625f,13))
 511:../../opus/celt/bands.c ****                tcount[1]++;
 512:../../opus/celt/bands.c ****             if (x2N < QCONST16(0.015625f,13))
 513:../../opus/celt/bands.c ****                tcount[2]++;
 514:../../opus/celt/bands.c ****          }
 515:../../opus/celt/bands.c **** 
 516:../../opus/celt/bands.c ****          /* Only include four last bands (8 kHz and up) */
 517:../../opus/celt/bands.c ****          if (i>m->nbEBands-4)
 518:../../opus/celt/bands.c ****             hf_sum += celt_udiv(32*(tcount[1]+tcount[0]), N);
 519:../../opus/celt/bands.c ****          tmp = (2*tcount[2] >= N) + (2*tcount[1] >= N) + (2*tcount[0] >= N);
 520:../../opus/celt/bands.c ****          sum += tmp*spread_weight[i];
 521:../../opus/celt/bands.c ****          nbBands+=spread_weight[i];
 522:../../opus/celt/bands.c ****       }
 523:../../opus/celt/bands.c ****    } while (++c<C);
 524:../../opus/celt/bands.c **** 
 525:../../opus/celt/bands.c ****    if (update_hf)
 526:../../opus/celt/bands.c ****    {
 527:../../opus/celt/bands.c ****       if (hf_sum)
 528:../../opus/celt/bands.c ****          hf_sum = celt_udiv(hf_sum, C*(4-m->nbEBands+end));
 529:../../opus/celt/bands.c ****       *hf_average = (*hf_average+hf_sum)>>1;
 530:../../opus/celt/bands.c ****       hf_sum = *hf_average;
 531:../../opus/celt/bands.c ****       if (*tapset_decision==2)
 532:../../opus/celt/bands.c ****          hf_sum += 4;
 533:../../opus/celt/bands.c ****       else if (*tapset_decision==0)
ARM GAS  C:\Users\oleg\AppData\Local\Temp\cc2Tml9e.s 			page 28


 534:../../opus/celt/bands.c ****          hf_sum -= 4;
 535:../../opus/celt/bands.c ****       if (hf_sum > 22)
 536:../../opus/celt/bands.c ****          *tapset_decision=2;
 537:../../opus/celt/bands.c ****       else if (hf_sum > 18)
 538:../../opus/celt/bands.c ****          *tapset_decision=1;
 539:../../opus/celt/bands.c ****       else
 540:../../opus/celt/bands.c ****          *tapset_decision=0;
 541:../../opus/celt/bands.c ****    }
 542:../../opus/celt/bands.c ****    /*printf("%d %d %d\n", hf_sum, *hf_average, *tapset_decision);*/
 543:../../opus/celt/bands.c ****    celt_assert(nbBands>0); /* end has to be non-zero */
 544:../../opus/celt/bands.c ****    celt_assert(sum>=0);
 545:../../opus/celt/bands.c ****    sum = celt_udiv((opus_int32)sum<<8, nbBands);
 546:../../opus/celt/bands.c ****    /* Recursive averaging */
 547:../../opus/celt/bands.c ****    sum = (sum+*average)>>1;
 548:../../opus/celt/bands.c ****    *average = sum;
 549:../../opus/celt/bands.c ****    /* Hysteresis */
 550:../../opus/celt/bands.c ****    sum = (3*sum + (((3-last_decision)<<7) + 64) + 2)>>2;
 551:../../opus/celt/bands.c ****    if (sum < 80)
 552:../../opus/celt/bands.c ****    {
 553:../../opus/celt/bands.c ****       decision = SPREAD_AGGRESSIVE;
 554:../../opus/celt/bands.c ****    } else if (sum < 256)
 555:../../opus/celt/bands.c ****    {
 556:../../opus/celt/bands.c ****       decision = SPREAD_NORMAL;
 557:../../opus/celt/bands.c ****    } else if (sum < 384)
 558:../../opus/celt/bands.c ****    {
 559:../../opus/celt/bands.c ****       decision = SPREAD_LIGHT;
 560:../../opus/celt/bands.c ****    } else {
 561:../../opus/celt/bands.c ****       decision = SPREAD_NONE;
 562:../../opus/celt/bands.c ****    }
 563:../../opus/celt/bands.c **** #ifdef FUZZING
 564:../../opus/celt/bands.c ****    decision = rand()&0x3;
 565:../../opus/celt/bands.c ****    *tapset_decision=rand()%3;
 566:../../opus/celt/bands.c **** #endif
 567:../../opus/celt/bands.c ****    return decision;
 568:../../opus/celt/bands.c **** }
