  59:../../opus/celt/bands.c **** opus_uint32 celt_lcg_rand(opus_uint32 seed)
  60:../../opus/celt/bands.c **** {
  61:../../opus/celt/bands.c ****    return 1664525 * seed + 1013904223;
  62:../../opus/celt/bands.c **** }
  63:../../opus/celt/bands.c **** 
  64:../../opus/celt/bands.c **** /* This is a cos() approximation designed to be bit-exact on any platform. Bit exactness
  65:../../opus/celt/bands.c ****    with this approximation is important because it has an impact on the bit allocation */
  66:../../opus/celt/bands.c **** opus_int16 bitexact_cos(opus_int16 x)
  67:../../opus/celt/bands.c **** {
  68:../../opus/celt/bands.c ****    opus_int32 tmp;
  69:../../opus/celt/bands.c ****    opus_int16 x2;
  70:../../opus/celt/bands.c ****    tmp = (4096+((opus_int32)(x)*(x)))>>13;
  71:../../opus/celt/bands.c ****    celt_sig_assert(tmp<=32767);
  72:../../opus/celt/bands.c ****    x2 = tmp;
  73:../../opus/celt/bands.c ****    x2 = (32767-x2) + FRAC_MUL16(x2, (-7651 + FRAC_MUL16(x2, (8277 + FRAC_MUL16(-626, x2)))));
  74:../../opus/celt/bands.c ****    celt_sig_assert(x2<=32766);
  75:../../opus/celt/bands.c ****    return 1+x2;
  76:../../opus/celt/bands.c **** }
  77:../../opus/celt/bands.c **** 
  78:../../opus/celt/bands.c **** int bitexact_log2tan(int isin,int icos)
  79:../../opus/celt/bands.c **** {
  80:../../opus/celt/bands.c ****    int lc;
  81:../../opus/celt/bands.c ****    int ls;
  82:../../opus/celt/bands.c ****    lc=EC_ILOG(icos);
  83:../../opus/celt/bands.c ****    ls=EC_ILOG(isin);
  84:../../opus/celt/bands.c ****    icos<<=15-lc;
  85:../../opus/celt/bands.c ****    isin<<=15-ls;
  86:../../opus/celt/bands.c ****    return (ls-lc)*(1<<11)
  87:../../opus/celt/bands.c ****          +FRAC_MUL16(isin, FRAC_MUL16(isin, -2597) + 7932)
  88:../../opus/celt/bands.c ****          -FRAC_MUL16(icos, FRAC_MUL16(icos, -2597) + 7932);
  89:../../opus/celt/bands.c **** }
