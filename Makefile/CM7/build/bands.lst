 880:../../opus/celt/bands.c ****       delta = -16384;
 881:../../opus/celt/bands.c ****    } else if (itheta == 16384)
 882:../../opus/celt/bands.c ****    {
 883:../../opus/celt/bands.c ****       imid = 0;
 884:../../opus/celt/bands.c ****       iside = 32767;
 885:../../opus/celt/bands.c ****       *fill &= ((1<<B)-1)<<B;
 886:../../opus/celt/bands.c ****       delta = 16384;
 887:../../opus/celt/bands.c ****    } else {
