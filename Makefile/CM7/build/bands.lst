 124:../../opus/celt/entcode.h **** /* Tested exhaustively for all n and for 1<=d<=256 */
 125:../../opus/celt/entcode.h **** static OPUS_INLINE opus_uint32 celt_udiv(opus_uint32 n, opus_uint32 d) {
 126:../../opus/celt/entcode.h ****    celt_sig_assert(d>0);
 127:../../opus/celt/entcode.h **** #ifdef USE_SMALL_DIV_TABLE
 128:../../opus/celt/entcode.h ****    if (d>256)
 129:../../opus/celt/entcode.h ****       return n/d;
 130:../../opus/celt/entcode.h ****    else {
 131:../../opus/celt/entcode.h ****       opus_uint32 t, q;
 132:../../opus/celt/entcode.h ****       t = EC_ILOG(d&-d);
 133:../../opus/celt/entcode.h ****       q = (opus_uint64)SMALL_DIV_TABLE[d>>t]*(n>>(t-1))>>32;
 134:../../opus/celt/entcode.h ****       return q+(n-q*d >= d);
 135:../../opus/celt/entcode.h ****    }
 136:../../opus/celt/entcode.h **** #else
 137:../../opus/celt/entcode.h ****    return n/d;
 138:../../opus/celt/entcode.h **** #endif
 139:../../opus/celt/entcode.h **** }
