  92:../../opus/celt/bands.c **** /* Compute the amplitude (sqrt energy) in each of the bands */
  93:../../opus/celt/bands.c **** void compute_band_energies(const CELTMode *m, const celt_sig *X, celt_ener *bandE, int end, int C, 
  94:../../opus/celt/bands.c **** {
  95:../../opus/celt/bands.c ****    int i, c, N;
  96:../../opus/celt/bands.c ****    const opus_int16 *eBands = m->eBands;
  97:../../opus/celt/bands.c ****    (void)arch;
  98:../../opus/celt/bands.c ****    N = m->shortMdctSize<<LM;
ARM GAS  C:\Users\oleg\AppData\Local\Temp\cc2Tml9e.s 			page 19


  99:../../opus/celt/bands.c ****    c=0; do {
 100:../../opus/celt/bands.c ****       for (i=0;i<end;i++)
 101:../../opus/celt/bands.c ****       {
 102:../../opus/celt/bands.c ****          int j;
 103:../../opus/celt/bands.c ****          opus_val32 maxval=0;
 104:../../opus/celt/bands.c ****          opus_val32 sum = 0;
 105:../../opus/celt/bands.c **** 
 106:../../opus/celt/bands.c ****          maxval = celt_maxabs32(&X[c*N+(eBands[i]<<LM)], (eBands[i+1]-eBands[i])<<LM);
 107:../../opus/celt/bands.c ****          if (maxval > 0)
 108:../../opus/celt/bands.c ****          {
 109:../../opus/celt/bands.c ****             int shift = celt_ilog2(maxval) - 14 + (((m->logN[i]>>BITRES)+LM+1)>>1);
 110:../../opus/celt/bands.c ****             j=eBands[i]<<LM;
 111:../../opus/celt/bands.c ****             if (shift>0)
 112:../../opus/celt/bands.c ****             {
