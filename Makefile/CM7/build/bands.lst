 937:../../opus/celt/bands.c **** /* This function is responsible for encoding and decoding a mono partition.
 938:../../opus/celt/bands.c ****    It can split the band in two and transmit the energy difference with
 939:../../opus/celt/bands.c ****    the two half-bands. It can be called recursively so bands can end up being
 940:../../opus/celt/bands.c ****    split in 8 parts. */
 941:../../opus/celt/bands.c **** static unsigned quant_partition(struct band_ctx *ctx, celt_norm *X,
 942:../../opus/celt/bands.c ****       int N, int b, int B, celt_norm *lowband,
 943:../../opus/celt/bands.c ****       int LM,
 944:../../opus/celt/bands.c ****       opus_val16 gain, int fill)
 945:../../opus/celt/bands.c **** {
 946:../../opus/celt/bands.c ****    const unsigned char *cache;
 947:../../opus/celt/bands.c ****    int q;
 948:../../opus/celt/bands.c ****    int curr_bits;
 949:../../opus/celt/bands.c ****    int imid=0, iside=0;
 950:../../opus/celt/bands.c ****    int B0=B;
 951:../../opus/celt/bands.c ****    opus_val16 mid=0, side=0;
 952:../../opus/celt/bands.c ****    unsigned cm=0;
 953:../../opus/celt/bands.c ****    celt_norm *Y=NULL;
 954:../../opus/celt/bands.c ****    int encode;
 955:../../opus/celt/bands.c ****    const CELTMode *m;
 956:../../opus/celt/bands.c ****    int i;
 957:../../opus/celt/bands.c ****    int spread;
 958:../../opus/celt/bands.c ****    ec_ctx *ec;
 959:../../opus/celt/bands.c **** 
 960:../../opus/celt/bands.c ****    encode = ctx->encode;
 961:../../opus/celt/bands.c ****    m = ctx->m;
 962:../../opus/celt/bands.c ****    i = ctx->i;
 963:../../opus/celt/bands.c ****    spread = ctx->spread;
 964:../../opus/celt/bands.c ****    ec = ctx->ec;
 965:../../opus/celt/bands.c **** 
 966:../../opus/celt/bands.c ****    /* If we need 1.5 more bit than we can produce, split the band in two. */
 967:../../opus/celt/bands.c ****    cache = m->cache.bits + m->cache.index[(LM+1)*m->nbEBands+i];
 968:../../opus/celt/bands.c ****    if (LM != -1 && b > cache[cache[0]]+12 && N>2)
 969:../../opus/celt/bands.c ****    {
 970:../../opus/celt/bands.c ****       int mbits, sbits, delta;
 971:../../opus/celt/bands.c ****       int itheta;
 972:../../opus/celt/bands.c ****       int qalloc;
 973:../../opus/celt/bands.c ****       struct split_ctx sctx;
 974:../../opus/celt/bands.c ****       celt_norm *next_lowband2=NULL;
 975:../../opus/celt/bands.c ****       opus_int32 rebalance;
ARM GAS  C:\Users\oleg\AppData\Local\Temp\cc2Tml9e.s 			page 48


 976:../../opus/celt/bands.c **** 
 977:../../opus/celt/bands.c ****       N >>= 1;
 978:../../opus/celt/bands.c ****       Y = X+N;
 979:../../opus/celt/bands.c ****       LM -= 1;
 980:../../opus/celt/bands.c ****       if (B==1)
 981:../../opus/celt/bands.c ****          fill = (fill&1)|(fill<<1);
 982:../../opus/celt/bands.c ****       B = (B+1)>>1;
 983:../../opus/celt/bands.c **** 
 984:../../opus/celt/bands.c ****       compute_theta(ctx, &sctx, X, Y, N, &b, B, B0, LM, 0, &fill);
 985:../../opus/celt/bands.c ****       imid = sctx.imid;
 986:../../opus/celt/bands.c ****       iside = sctx.iside;
 987:../../opus/celt/bands.c ****       delta = sctx.delta;
 988:../../opus/celt/bands.c ****       itheta = sctx.itheta;
 989:../../opus/celt/bands.c ****       qalloc = sctx.qalloc;
 990:../../opus/celt/bands.c **** #ifdef FIXED_POINT
 991:../../opus/celt/bands.c ****       mid = imid;
 992:../../opus/celt/bands.c ****       side = iside;
 993:../../opus/celt/bands.c **** #else
 994:../../opus/celt/bands.c ****       mid = (1.f/32768)*imid;
 995:../../opus/celt/bands.c ****       side = (1.f/32768)*iside;
 996:../../opus/celt/bands.c **** #endif
 997:../../opus/celt/bands.c **** 
 998:../../opus/celt/bands.c ****       /* Give more bits to low-energy MDCTs than they would otherwise deserve */
 999:../../opus/celt/bands.c ****       if (B0>1 && (itheta&0x3fff))
1000:../../opus/celt/bands.c ****       {
1001:../../opus/celt/bands.c ****          if (itheta > 8192)
1002:../../opus/celt/bands.c ****             /* Rough approximation for pre-echo masking */
1003:../../opus/celt/bands.c ****             delta -= delta>>(4-LM);
1004:../../opus/celt/bands.c ****          else
1005:../../opus/celt/bands.c ****             /* Corresponds to a forward-masking slope of 1.5 dB per 10 ms */
1006:../../opus/celt/bands.c ****             delta = IMIN(0, delta + (N<<BITRES>>(5-LM)));
1007:../../opus/celt/bands.c ****       }
1008:../../opus/celt/bands.c ****       mbits = IMAX(0, IMIN(b, (b-delta)/2));
1009:../../opus/celt/bands.c ****       sbits = b-mbits;
1010:../../opus/celt/bands.c ****       ctx->remaining_bits -= qalloc;
1011:../../opus/celt/bands.c **** 
1012:../../opus/celt/bands.c ****       if (lowband)
1013:../../opus/celt/bands.c ****          next_lowband2 = lowband+N; /* >32-bit split case */
1014:../../opus/celt/bands.c **** 
1015:../../opus/celt/bands.c ****       rebalance = ctx->remaining_bits;
1016:../../opus/celt/bands.c ****       if (mbits >= sbits)
1017:../../opus/celt/bands.c ****       {
1018:../../opus/celt/bands.c ****          cm = quant_partition(ctx, X, N, mbits, B, lowband, LM,
1019:../../opus/celt/bands.c ****                MULT16_16_P15(gain,mid), fill);
1020:../../opus/celt/bands.c ****          rebalance = mbits - (rebalance-ctx->remaining_bits);
1021:../../opus/celt/bands.c ****          if (rebalance > 3<<BITRES && itheta!=0)
1022:../../opus/celt/bands.c ****             sbits += rebalance - (3<<BITRES);
1023:../../opus/celt/bands.c ****          cm |= quant_partition(ctx, Y, N, sbits, B, next_lowband2, LM,
1024:../../opus/celt/bands.c ****                MULT16_16_P15(gain,side), fill>>B)<<(B0>>1);
1025:../../opus/celt/bands.c ****       } else {
1026:../../opus/celt/bands.c ****          cm = quant_partition(ctx, Y, N, sbits, B, next_lowband2, LM,
1027:../../opus/celt/bands.c ****                MULT16_16_P15(gain,side), fill>>B)<<(B0>>1);
1028:../../opus/celt/bands.c ****          rebalance = sbits - (rebalance-ctx->remaining_bits);
1029:../../opus/celt/bands.c ****          if (rebalance > 3<<BITRES && itheta!=16384)
1030:../../opus/celt/bands.c ****             mbits += rebalance - (3<<BITRES);
1031:../../opus/celt/bands.c ****          cm |= quant_partition(ctx, X, N, mbits, B, lowband, LM,
1032:../../opus/celt/bands.c ****                MULT16_16_P15(gain,mid), fill);
ARM GAS  C:\Users\oleg\AppData\Local\Temp\cc2Tml9e.s 			page 49


1033:../../opus/celt/bands.c ****       }
1034:../../opus/celt/bands.c ****    } else {
1035:../../opus/celt/bands.c ****       /* This is the basic no-split case */
1036:../../opus/celt/bands.c ****       q = bits2pulses(m, i, LM, b);
1037:../../opus/celt/bands.c ****       curr_bits = pulses2bits(m, i, LM, q);
1038:../../opus/celt/bands.c ****       ctx->remaining_bits -= curr_bits;
1039:../../opus/celt/bands.c **** 
1040:../../opus/celt/bands.c ****       /* Ensures we can never bust the budget */
1041:../../opus/celt/bands.c ****       while (ctx->remaining_bits < 0 && q > 0)
1042:../../opus/celt/bands.c ****       {
1043:../../opus/celt/bands.c ****          ctx->remaining_bits += curr_bits;
1044:../../opus/celt/bands.c ****          q--;
1045:../../opus/celt/bands.c ****          curr_bits = pulses2bits(m, i, LM, q);
1046:../../opus/celt/bands.c ****          ctx->remaining_bits -= curr_bits;
1047:../../opus/celt/bands.c ****       }
1048:../../opus/celt/bands.c **** 
1049:../../opus/celt/bands.c ****       if (q!=0)
1050:../../opus/celt/bands.c ****       {
1051:../../opus/celt/bands.c ****          int K = get_pulses(q);
1052:../../opus/celt/bands.c **** 
1053:../../opus/celt/bands.c ****          /* Finally do the actual quantization */
1054:../../opus/celt/bands.c ****          if (encode)
1055:../../opus/celt/bands.c ****          {
1056:../../opus/celt/bands.c ****             cm = alg_quant(X, N, K, spread, B, ec, gain, ctx->resynth, ctx->arch);
1057:../../opus/celt/bands.c ****          } else {
1058:../../opus/celt/bands.c ****             cm = alg_unquant(X, N, K, spread, B, ec, gain);
1059:../../opus/celt/bands.c ****          }
1060:../../opus/celt/bands.c ****       } else {
1061:../../opus/celt/bands.c ****          /* If there's no pulse, fill the band anyway */
1062:../../opus/celt/bands.c ****          int j;
1063:../../opus/celt/bands.c ****          if (ctx->resynth)
1064:../../opus/celt/bands.c ****          {
1065:../../opus/celt/bands.c ****             unsigned cm_mask;
1066:../../opus/celt/bands.c ****             /* B can be as large as 16, so this shift might overflow an int on a
1067:../../opus/celt/bands.c ****                16-bit platform; use a long to get defined behavior.*/
1068:../../opus/celt/bands.c ****             cm_mask = (unsigned)(1UL<<B)-1;
1069:../../opus/celt/bands.c ****             fill &= cm_mask;
1070:../../opus/celt/bands.c ****             if (!fill)
1071:../../opus/celt/bands.c ****             {
1072:../../opus/celt/bands.c ****                OPUS_CLEAR(X, N);
1073:../../opus/celt/bands.c ****             } else {
1074:../../opus/celt/bands.c ****                if (lowband == NULL)
1075:../../opus/celt/bands.c ****                {
1076:../../opus/celt/bands.c ****                   /* Noise */
1077:../../opus/celt/bands.c ****                   for (j=0;j<N;j++)
1078:../../opus/celt/bands.c ****                   {
1079:../../opus/celt/bands.c ****                      ctx->seed = celt_lcg_rand(ctx->seed);
1080:../../opus/celt/bands.c ****                      X[j] = (celt_norm)((opus_int32)ctx->seed>>20);
1081:../../opus/celt/bands.c ****                   }
1082:../../opus/celt/bands.c ****                   cm = cm_mask;
1083:../../opus/celt/bands.c ****                } else {
1084:../../opus/celt/bands.c ****                   /* Folded spectrum */
1085:../../opus/celt/bands.c ****                   for (j=0;j<N;j++)
1086:../../opus/celt/bands.c ****                   {
1087:../../opus/celt/bands.c ****                      opus_val16 tmp;
1088:../../opus/celt/bands.c ****                      ctx->seed = celt_lcg_rand(ctx->seed);
1089:../../opus/celt/bands.c ****                      /* About 48 dB below the "normal" folding level */
ARM GAS  C:\Users\oleg\AppData\Local\Temp\cc2Tml9e.s 			page 50


1090:../../opus/celt/bands.c ****                      tmp = QCONST16(1.0f/256, 10);
1091:../../opus/celt/bands.c ****                      tmp = (ctx->seed)&0x8000 ? tmp : -tmp;
1092:../../opus/celt/bands.c ****                      X[j] = lowband[j]+tmp;
1093:../../opus/celt/bands.c ****                   }
1094:../../opus/celt/bands.c ****                   cm = fill;
1095:../../opus/celt/bands.c ****                }
1096:../../opus/celt/bands.c ****                renormalise_vector(X, N, gain, ctx->arch);
1097:../../opus/celt/bands.c ****             }
1098:../../opus/celt/bands.c ****          }
1099:../../opus/celt/bands.c ****       }
1100:../../opus/celt/bands.c ****    }
1101:../../opus/celt/bands.c **** 
1102:../../opus/celt/bands.c ****    return cm;
1103:../../opus/celt/bands.c **** }
