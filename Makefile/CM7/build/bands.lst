  44:../../opus/celt/bands.c **** int hysteresis_decision(opus_val16 val, const opus_val16 *thresholds, const opus_val16 *hysteresis,
  45:../../opus/celt/bands.c **** {
  46:../../opus/celt/bands.c ****    int i;
  47:../../opus/celt/bands.c ****    for (i=0;i<N;i++)
  48:../../opus/celt/bands.c ****    {
  49:../../opus/celt/bands.c ****       if (val < thresholds[i])
  50:../../opus/celt/bands.c ****          break;
  51:../../opus/celt/bands.c ****    }
  52:../../opus/celt/bands.c ****    if (i>prev && val < thresholds[prev]+hysteresis[prev])
  53:../../opus/celt/bands.c ****       i=prev;
  54:../../opus/celt/bands.c ****    if (i<prev && val > thresholds[prev-1]-hysteresis[prev-1])
  55:../../opus/celt/bands.c ****       i=prev;
  56:../../opus/celt/bands.c ****    return i;
  57:../../opus/celt/bands.c **** }
