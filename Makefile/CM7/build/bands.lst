 424:../../opus/celt/bands.c **** static void stereo_merge(celt_norm * OPUS_RESTRICT X, celt_norm * OPUS_RESTRICT Y, opus_val16 mid, 
 425:../../opus/celt/bands.c **** {
 426:../../opus/celt/bands.c ****    int j;
 427:../../opus/celt/bands.c ****    opus_val32 xp=0, side=0;
 428:../../opus/celt/bands.c ****    opus_val32 El, Er;
 429:../../opus/celt/bands.c ****    opus_val16 mid2;
 430:../../opus/celt/bands.c **** #ifdef FIXED_POINT
 431:../../opus/celt/bands.c ****    int kl, kr;
 432:../../opus/celt/bands.c **** #endif
 433:../../opus/celt/bands.c ****    opus_val32 t, lgain, rgain;
 434:../../opus/celt/bands.c **** 
 435:../../opus/celt/bands.c ****    /* Compute the norm of X+Y and X-Y as |X|^2 + |Y|^2 +/- sum(xy) */
 436:../../opus/celt/bands.c ****    dual_inner_prod(Y, X, Y, N, &xp, &side, arch);
 437:../../opus/celt/bands.c ****    /* Compensating for the mid normalization */
 438:../../opus/celt/bands.c ****    xp = MULT16_32_Q15(mid, xp);
 439:../../opus/celt/bands.c ****    /* mid and side are in Q15, not Q14 like X and Y */
 440:../../opus/celt/bands.c ****    mid2 = SHR16(mid, 1);
 441:../../opus/celt/bands.c ****    El = MULT16_16(mid2, mid2) + side - 2*xp;
 442:../../opus/celt/bands.c ****    Er = MULT16_16(mid2, mid2) + side + 2*xp;
 443:../../opus/celt/bands.c ****    if (Er < QCONST32(6e-4f, 28) || El < QCONST32(6e-4f, 28))
 444:../../opus/celt/bands.c ****    {
 445:../../opus/celt/bands.c ****       OPUS_COPY(Y, X, N);
 446:../../opus/celt/bands.c ****       return;
 447:../../opus/celt/bands.c ****    }
 448:../../opus/celt/bands.c **** 
 449:../../opus/celt/bands.c **** #ifdef FIXED_POINT
 450:../../opus/celt/bands.c ****    kl = celt_ilog2(El)>>1;
 451:../../opus/celt/bands.c ****    kr = celt_ilog2(Er)>>1;
 452:../../opus/celt/bands.c **** #endif
 453:../../opus/celt/bands.c ****    t = VSHR32(El, (kl-7)<<1);
 454:../../opus/celt/bands.c ****    lgain = celt_rsqrt_norm(t);
 455:../../opus/celt/bands.c ****    t = VSHR32(Er, (kr-7)<<1);
 456:../../opus/celt/bands.c ****    rgain = celt_rsqrt_norm(t);
 457:../../opus/celt/bands.c **** 
 458:../../opus/celt/bands.c **** #ifdef FIXED_POINT
 459:../../opus/celt/bands.c ****    if (kl < 7)
 460:../../opus/celt/bands.c ****       kl = 7;
 461:../../opus/celt/bands.c ****    if (kr < 7)
 462:../../opus/celt/bands.c ****       kr = 7;
 463:../../opus/celt/bands.c **** #endif
 464:../../opus/celt/bands.c **** 
 465:../../opus/celt/bands.c ****    for (j=0;j<N;j++)
 466:../../opus/celt/bands.c ****    {
 467:../../opus/celt/bands.c ****       celt_norm r, l;
 468:../../opus/celt/bands.c ****       /* Apply mid scaling (side is already scaled) */
 469:../../opus/celt/bands.c ****       l = MULT16_16_P15(mid, X[j]);
 470:../../opus/celt/bands.c ****       r = Y[j];
 471:../../opus/celt/bands.c ****       X[j] = EXTRACT16(PSHR32(MULT16_16(lgain, SUB16(l,r)), kl+1));
 472:../../opus/celt/bands.c ****       Y[j] = EXTRACT16(PSHR32(MULT16_16(rgain, ADD16(l,r)), kr+1));
 473:../../opus/celt/bands.c ****    }
 474:../../opus/celt/bands.c **** }
