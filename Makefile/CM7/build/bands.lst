 134:../../opus/celt/bands.c **** /* Normalise each band such that the energy is one. */
 135:../../opus/celt/bands.c **** void normalise_bands(const CELTMode *m, const celt_sig * OPUS_RESTRICT freq, celt_norm * OPUS_RESTR
 136:../../opus/celt/bands.c **** {
 137:../../opus/celt/bands.c ****    int i, c, N;
 138:../../opus/celt/bands.c ****    const opus_int16 *eBands = m->eBands;
 139:../../opus/celt/bands.c ****    N = M*m->shortMdctSize;
 140:../../opus/celt/bands.c ****    c=0; do {
 141:../../opus/celt/bands.c ****       i=0; do {
 142:../../opus/celt/bands.c ****          opus_val16 g;
 143:../../opus/celt/bands.c ****          int j,shift;
 144:../../opus/celt/bands.c ****          opus_val16 E;
 145:../../opus/celt/bands.c ****          shift = celt_zlog2(bandE[i+c*m->nbEBands])-13;
 146:../../opus/celt/bands.c ****          E = VSHR32(bandE[i+c*m->nbEBands], shift);
 147:../../opus/celt/bands.c ****          g = EXTRACT16(celt_rcp(SHL32(E,3)));
 148:../../opus/celt/bands.c ****          j=M*eBands[i]; do {
 149:../../opus/celt/bands.c ****             X[j+c*N] = MULT16_16_Q15(VSHR32(freq[j+c*N],shift-1),g);
