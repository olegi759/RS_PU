 902:../../opus/celt/bands.c **** static unsigned quant_band_n1(struct band_ctx *ctx, celt_norm *X, celt_norm *Y,
 903:../../opus/celt/bands.c ****       celt_norm *lowband_out)
 904:../../opus/celt/bands.c **** {
 905:../../opus/celt/bands.c ****    int c;
 906:../../opus/celt/bands.c ****    int stereo;
 907:../../opus/celt/bands.c ****    celt_norm *x = X;
 908:../../opus/celt/bands.c ****    int encode;
 909:../../opus/celt/bands.c ****    ec_ctx *ec;
 910:../../opus/celt/bands.c **** 
 911:../../opus/celt/bands.c ****    encode = ctx->encode;
 912:../../opus/celt/bands.c ****    ec = ctx->ec;
 913:../../opus/celt/bands.c **** 
 914:../../opus/celt/bands.c ****    stereo = Y != NULL;
 915:../../opus/celt/bands.c ****    c=0; do {
 916:../../opus/celt/bands.c ****       int sign=0;
 917:../../opus/celt/bands.c ****       if (ctx->remaining_bits>=1<<BITRES)
 918:../../opus/celt/bands.c ****       {
ARM GAS  C:\Users\oleg\AppData\Local\Temp\cc2Tml9e.s 			page 47


 919:../../opus/celt/bands.c ****          if (encode)
 920:../../opus/celt/bands.c ****          {
 921:../../opus/celt/bands.c ****             sign = x[0]<0;
 922:../../opus/celt/bands.c ****             ec_enc_bits(ec, sign, 1);
 923:../../opus/celt/bands.c ****          } else {
 924:../../opus/celt/bands.c ****             sign = ec_dec_bits(ec, 1);
 925:../../opus/celt/bands.c ****          }
 926:../../opus/celt/bands.c ****          ctx->remaining_bits -= 1<<BITRES;
 927:../../opus/celt/bands.c ****       }
 928:../../opus/celt/bands.c ****       if (ctx->resynth)
 929:../../opus/celt/bands.c ****          x[0] = sign ? -NORM_SCALING : NORM_SCALING;
 930:../../opus/celt/bands.c ****       x = Y;
 931:../../opus/celt/bands.c ****    } while (++c<1+stereo);
 932:../../opus/celt/bands.c ****    if (lowband_out)
 933:../../opus/celt/bands.c ****       lowband_out[0] = SHR16(X[0],4);
 934:../../opus/celt/bands.c ****    return 1;
 935:../../opus/celt/bands.c **** }
