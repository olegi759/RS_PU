 114:../../opus/celt/bands.c ****                   sum = MAC16_16(sum, EXTRACT16(SHR32(X[j+c*N],shift)),
 115:../../opus/celt/bands.c ****                         EXTRACT16(SHR32(X[j+c*N],shift)));
 116:../../opus/celt/bands.c ****                } while (++j<eBands[i+1]<<LM);
 117:../../opus/celt/bands.c ****             } else {
 118:../../opus/celt/bands.c ****                do {
 119:../../opus/celt/bands.c ****                   sum = MAC16_16(sum, EXTRACT16(SHL32(X[j+c*N],-shift)),
 120:../../opus/celt/bands.c ****                         EXTRACT16(SHL32(X[j+c*N],-shift)));
 121:../../opus/celt/bands.c ****                } while (++j<eBands[i+1]<<LM);
 122:../../opus/celt/bands.c ****             }
 123:../../opus/celt/bands.c ****             /* We're adding one here to ensure the normalized band isn't larger than unity norm */
 124:../../opus/celt/bands.c ****             bandE[i+c*m->nbEBands] = EPSILON+VSHR32(EXTEND32(celt_sqrt(sum)),-shift);
 125:../../opus/celt/bands.c ****          } else {
 126:../../opus/celt/bands.c ****             bandE[i+c*m->nbEBands] = EPSILON;
 127:../../opus/celt/bands.c ****          }
 128:../../opus/celt/bands.c ****          /*printf ("%f ", bandE[i+c*m->nbEBands]);*/
 129:../../opus/celt/bands.c ****       }
 130:../../opus/celt/bands.c ****    } while (++c<C);
 131:../../opus/celt/bands.c ****    /*printf ("\n");*/
 132:../../opus/celt/bands.c **** }
