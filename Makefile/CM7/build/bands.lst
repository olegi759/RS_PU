1105:../../opus/celt/bands.c **** 
1106:../../opus/celt/bands.c **** /* This function is responsible for encoding and decoding a band for the mono case. */
1107:../../opus/celt/bands.c **** static unsigned quant_band(struct band_ctx *ctx, celt_norm *X,
1108:../../opus/celt/bands.c ****       int N, int b, int B, celt_norm *lowband,
1109:../../opus/celt/bands.c ****       int LM, celt_norm *lowband_out,
1110:../../opus/celt/bands.c ****       opus_val16 gain, celt_norm *lowband_scratch, int fill)
1111:../../opus/celt/bands.c **** {
1112:../../opus/celt/bands.c ****    int N0=N;
1113:../../opus/celt/bands.c ****    int N_B=N;
1114:../../opus/celt/bands.c ****    int N_B0;
1115:../../opus/celt/bands.c ****    int B0=B;
1116:../../opus/celt/bands.c ****    int time_divide=0;
1117:../../opus/celt/bands.c ****    int recombine=0;
1118:../../opus/celt/bands.c ****    int longBlocks;
1119:../../opus/celt/bands.c ****    unsigned cm=0;
1120:../../opus/celt/bands.c ****    int k;
1121:../../opus/celt/bands.c ****    int encode;
1122:../../opus/celt/bands.c ****    int tf_change;
1123:../../opus/celt/bands.c **** 
1124:../../opus/celt/bands.c ****    encode = ctx->encode;
1125:../../opus/celt/bands.c ****    tf_change = ctx->tf_change;
1126:../../opus/celt/bands.c **** 
1127:../../opus/celt/bands.c ****    longBlocks = B0==1;
1128:../../opus/celt/bands.c **** 
1129:../../opus/celt/bands.c ****    N_B = celt_udiv(N_B, B);
1130:../../opus/celt/bands.c **** 
1131:../../opus/celt/bands.c ****    /* Special case for one sample */
1132:../../opus/celt/bands.c ****    if (N==1)
1133:../../opus/celt/bands.c ****    {
1134:../../opus/celt/bands.c ****       return quant_band_n1(ctx, X, NULL, lowband_out);
1135:../../opus/celt/bands.c ****    }
1136:../../opus/celt/bands.c **** 
1137:../../opus/celt/bands.c ****    if (tf_change>0)
1138:../../opus/celt/bands.c ****       recombine = tf_change;
1139:../../opus/celt/bands.c ****    /* Band recombining to increase frequency resolution */
1140:../../opus/celt/bands.c **** 
1141:../../opus/celt/bands.c ****    if (lowband_scratch && lowband && (recombine || ((N_B&1) == 0 && tf_change<0) || B0>1))
1142:../../opus/celt/bands.c ****    {
