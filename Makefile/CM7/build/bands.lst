 570:../../opus/celt/bands.c **** /* Indexing table for converting from natural Hadamard to ordery Hadamard
 571:../../opus/celt/bands.c ****    This is essentially a bit-reversed Gray, on top of which we've added
 572:../../opus/celt/bands.c ****    an inversion of the order because we want the DC at the end rather than
 573:../../opus/celt/bands.c ****    the beginning. The lines are for N=2, 4, 8, 16 */
 574:../../opus/celt/bands.c **** static const int ordery_table[] = {
 575:../../opus/celt/bands.c ****        1,  0,
 576:../../opus/celt/bands.c ****        3,  0,  2,  1,
 577:../../opus/celt/bands.c ****        7,  0,  4,  3,  6,  1,  5,  2,
 578:../../opus/celt/bands.c ****       15,  0,  8,  7, 12,  3, 11,  4, 14,  1,  9,  6, 13,  2, 10,  5,
 579:../../opus/celt/bands.c **** };
 580:../../opus/celt/bands.c **** 
 581:../../opus/celt/bands.c **** static void deinterleave_hadamard(celt_norm *X, int N0, int stride, int hadamard)
 582:../../opus/celt/bands.c **** {
 583:../../opus/celt/bands.c ****    int i,j;
 584:../../opus/celt/bands.c ****    VARDECL(celt_norm, tmp);
 585:../../opus/celt/bands.c ****    int N;
 586:../../opus/celt/bands.c ****    SAVE_STACK;
 587:../../opus/celt/bands.c ****    N = N0*stride;
 588:../../opus/celt/bands.c ****    ALLOC(tmp, N, celt_norm);
 589:../../opus/celt/bands.c ****    celt_assert(stride>0);
 590:../../opus/celt/bands.c ****    if (hadamard)
ARM GAS  C:\Users\oleg\AppData\Local\Temp\cc2Tml9e.s 			page 29


 591:../../opus/celt/bands.c ****    {
 592:../../opus/celt/bands.c ****       const int *ordery = ordery_table+stride-2;
 593:../../opus/celt/bands.c ****       for (i=0;i<stride;i++)
 594:../../opus/celt/bands.c ****       {
 595:../../opus/celt/bands.c ****          for (j=0;j<N0;j++)
 596:../../opus/celt/bands.c ****             tmp[ordery[i]*N0+j] = X[j*stride+i];
 597:../../opus/celt/bands.c ****       }
 598:../../opus/celt/bands.c ****    } else {
 599:../../opus/celt/bands.c ****       for (i=0;i<stride;i++)
 600:../../opus/celt/bands.c ****          for (j=0;j<N0;j++)
 601:../../opus/celt/bands.c ****             tmp[i*N0+j] = X[j*stride+i];
 602:../../opus/celt/bands.c ****    }
 603:../../opus/celt/bands.c ****    OPUS_COPY(X, tmp, N);
 604:../../opus/celt/bands.c ****    RESTORE_STACK;
 605:../../opus/celt/bands.c **** }
 606:../../opus/celt/bands.c **** 
 607:../../opus/celt/bands.c **** static void interleave_hadamard(celt_norm *X, int N0, int stride, int hadamard)
 608:../../opus/celt/bands.c **** {
 609:../../opus/celt/bands.c ****    int i,j;
 610:../../opus/celt/bands.c ****    VARDECL(celt_norm, tmp);
 611:../../opus/celt/bands.c ****    int N;
 612:../../opus/celt/bands.c ****    SAVE_STACK;
 613:../../opus/celt/bands.c ****    N = N0*stride;
 614:../../opus/celt/bands.c ****    ALLOC(tmp, N, celt_norm);
 615:../../opus/celt/bands.c ****    if (hadamard)
 616:../../opus/celt/bands.c ****    {
 617:../../opus/celt/bands.c ****       const int *ordery = ordery_table+stride-2;
 618:../../opus/celt/bands.c ****       for (i=0;i<stride;i++)
 619:../../opus/celt/bands.c ****          for (j=0;j<N0;j++)
 620:../../opus/celt/bands.c ****             tmp[j*stride+i] = X[ordery[i]*N0+j];
 621:../../opus/celt/bands.c ****    } else {
 622:../../opus/celt/bands.c ****       for (i=0;i<stride;i++)
 623:../../opus/celt/bands.c ****          for (j=0;j<N0;j++)
 624:../../opus/celt/bands.c ****             tmp[j*stride+i] = X[i*N0+j];
 625:../../opus/celt/bands.c ****    }
 626:../../opus/celt/bands.c ****    OPUS_COPY(X, tmp, N);
 627:../../opus/celt/bands.c ****    RESTORE_STACK;
 628:../../opus/celt/bands.c **** }
 629:../../opus/celt/bands.c **** 
 630:../../opus/celt/bands.c **** void haar1(celt_norm *X, int N0, int stride)
 631:../../opus/celt/bands.c **** {
 632:../../opus/celt/bands.c ****    int i, j;
 633:../../opus/celt/bands.c ****    N0 >>= 1;
 634:../../opus/celt/bands.c ****    for (i=0;i<stride;i++)
 635:../../opus/celt/bands.c ****       for (j=0;j<N0;j++)
 636:../../opus/celt/bands.c ****       {
 637:../../opus/celt/bands.c ****          opus_val32 tmp1, tmp2;
 638:../../opus/celt/bands.c ****          tmp1 = MULT16_16(QCONST16(.70710678f,15), X[stride*2*j+i]);
 639:../../opus/celt/bands.c ****          tmp2 = MULT16_16(QCONST16(.70710678f,15), X[stride*(2*j+1)+i]);
 640:../../opus/celt/bands.c ****          X[stride*2*j+i] = EXTRACT16(PSHR32(ADD32(tmp1, tmp2), 15));
 641:../../opus/celt/bands.c ****          X[stride*(2*j+1)+i] = EXTRACT16(PSHR32(SUB32(tmp1, tmp2), 15));
 642:../../opus/celt/bands.c ****       }
 643:../../opus/celt/bands.c **** }
