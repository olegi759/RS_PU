  38:../../libmad/timer.c **** /*
  39:../../libmad/timer.c ****  * NAME:	timer->compare()
  40:../../libmad/timer.c ****  * DESCRIPTION:	indicate relative order of two timers
  41:../../libmad/timer.c ****  */
  42:../../libmad/timer.c **** int mad_timer_compare(mad_timer_t timer1, mad_timer_t timer2)
  43:../../libmad/timer.c **** {
  44:../../libmad/timer.c ****   signed long diff;
  45:../../libmad/timer.c **** 
  46:../../libmad/timer.c ****   diff = timer1.seconds - timer2.seconds;
  47:../../libmad/timer.c ****   if (diff < 0)
  48:../../libmad/timer.c ****     return -1;
  49:../../libmad/timer.c ****   else if (diff > 0)
  50:../../libmad/timer.c ****     return +1;
  51:../../libmad/timer.c **** 
  52:../../libmad/timer.c ****   diff = timer1.fraction - timer2.fraction;
  53:../../libmad/timer.c ****   if (diff < 0)
  54:../../libmad/timer.c ****     return -1;
  55:../../libmad/timer.c ****   else if (diff > 0)
  56:../../libmad/timer.c ****     return +1;
  57:../../libmad/timer.c **** 
  58:../../libmad/timer.c ****   return 0;
  59:../../libmad/timer.c **** }
  60:../../libmad/timer.c **** 
  61:../../libmad/timer.c **** /*
  62:../../libmad/timer.c ****  * NAME:	timer->negate()
  63:../../libmad/timer.c ****  * DESCRIPTION:	invert the sign of a timer
  64:../../libmad/timer.c ****  */
  65:../../libmad/timer.c **** void mad_timer_negate(mad_timer_t *timer)
  66:../../libmad/timer.c **** {
  67:../../libmad/timer.c ****   timer->seconds = -timer->seconds;
  68:../../libmad/timer.c **** 
  69:../../libmad/timer.c ****   if (timer->fraction) {
  70:../../libmad/timer.c ****     timer->seconds -= 1;
  71:../../libmad/timer.c ****     timer->fraction = MAD_TIMER_RESOLUTION - timer->fraction;
  72:../../libmad/timer.c ****   }
  73:../../libmad/timer.c **** }
  74:../../libmad/timer.c **** 
  75:../../libmad/timer.c **** /*
  76:../../libmad/timer.c ****  * NAME:	timer->abs()
  77:../../libmad/timer.c ****  * DESCRIPTION:	return the absolute value of a timer
  78:../../libmad/timer.c ****  */
  79:../../libmad/timer.c **** mad_timer_t mad_timer_abs(mad_timer_t timer)
  80:../../libmad/timer.c **** {
  81:../../libmad/timer.c ****   if (timer.seconds < 0)
  82:../../libmad/timer.c ****     mad_timer_negate(&timer);
  83:../../libmad/timer.c **** 
  84:../../libmad/timer.c ****   return timer;
  85:../../libmad/timer.c **** }
