  61:../../opus/silk/A2NLSF.c **** static OPUS_INLINE opus_int32 silk_A2NLSF_eval_poly( /* return the polynomial evaluation, in Q16   
  62:../../opus/silk/A2NLSF.c ****     opus_int32          *p,                     /* I    Polynomial, Q16                         */
  63:../../opus/silk/A2NLSF.c ****     const opus_int32    x,                      /* I    Evaluation point, Q12                   */
  64:../../opus/silk/A2NLSF.c ****     const opus_int      dd                      /* I    Order                                   */
ARM GAS  C:\Users\oleg\AppData\Local\Temp\cczmNcNx.s 			page 4


  65:../../opus/silk/A2NLSF.c **** )
  66:../../opus/silk/A2NLSF.c **** {
  67:../../opus/silk/A2NLSF.c ****     opus_int   n;
  68:../../opus/silk/A2NLSF.c ****     opus_int32 x_Q16, y32;
  69:../../opus/silk/A2NLSF.c **** 
  70:../../opus/silk/A2NLSF.c ****     y32 = p[ dd ];                                  /* Q16 */
  71:../../opus/silk/A2NLSF.c ****     x_Q16 = silk_LSHIFT( x, 4 );
  72:../../opus/silk/A2NLSF.c **** 
  73:../../opus/silk/A2NLSF.c ****     if ( opus_likely( 8 == dd ) )
  74:../../opus/silk/A2NLSF.c ****     {
  75:../../opus/silk/A2NLSF.c ****         y32 = silk_SMLAWW( p[ 7 ], y32, x_Q16 );
  76:../../opus/silk/A2NLSF.c ****         y32 = silk_SMLAWW( p[ 6 ], y32, x_Q16 );
  77:../../opus/silk/A2NLSF.c ****         y32 = silk_SMLAWW( p[ 5 ], y32, x_Q16 );
  78:../../opus/silk/A2NLSF.c ****         y32 = silk_SMLAWW( p[ 4 ], y32, x_Q16 );
  79:../../opus/silk/A2NLSF.c ****         y32 = silk_SMLAWW( p[ 3 ], y32, x_Q16 );
  80:../../opus/silk/A2NLSF.c ****         y32 = silk_SMLAWW( p[ 2 ], y32, x_Q16 );
  81:../../opus/silk/A2NLSF.c ****         y32 = silk_SMLAWW( p[ 1 ], y32, x_Q16 );
  82:../../opus/silk/A2NLSF.c ****         y32 = silk_SMLAWW( p[ 0 ], y32, x_Q16 );
  83:../../opus/silk/A2NLSF.c ****     }
  84:../../opus/silk/A2NLSF.c ****     else
  85:../../opus/silk/A2NLSF.c ****     {
  86:../../opus/silk/A2NLSF.c ****         for( n = dd - 1; n >= 0; n-- ) {
  87:../../opus/silk/A2NLSF.c ****             y32 = silk_SMLAWW( p[ n ], y32, x_Q16 );    /* Q16 */
  88:../../opus/silk/A2NLSF.c ****         }
  89:../../opus/silk/A2NLSF.c ****     }
  90:../../opus/silk/A2NLSF.c ****     return y32;
  91:../../opus/silk/A2NLSF.c **** }
