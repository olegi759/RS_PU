  28:../../opus/silk/A2NLSF.c **** /* Conversion between prediction filter coefficients and NLSFs  */
  29:../../opus/silk/A2NLSF.c **** /* Requires the order to be an even number                      */
  30:../../opus/silk/A2NLSF.c **** /* A piecewise linear approximation maps LSF <-> cos(LSF)       */
  31:../../opus/silk/A2NLSF.c **** /* Therefore the result is not accurate NLSFs, but the two      */
