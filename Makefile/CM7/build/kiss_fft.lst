 429:../../opus/celt/kiss_fft.c **** /*
 430:../../opus/celt/kiss_fft.c ****  *
 431:../../opus/celt/kiss_fft.c ****  * Allocates all necessary storage space for the fft and ifft.
 432:../../opus/celt/kiss_fft.c ****  * The return value is a contiguous block of memory.  As such,
 433:../../opus/celt/kiss_fft.c ****  * It can be freed with free().
 434:../../opus/celt/kiss_fft.c ****  * */
 435:../../opus/celt/kiss_fft.c **** kiss_fft_state *opus_fft_alloc_twiddles(int nfft,void * mem,size_t * lenmem,
 436:../../opus/celt/kiss_fft.c ****                                         const kiss_fft_state *base, int arch)
 437:../../opus/celt/kiss_fft.c **** {
 438:../../opus/celt/kiss_fft.c ****     kiss_fft_state *st=NULL;
 439:../../opus/celt/kiss_fft.c ****     size_t memneeded = sizeof(struct kiss_fft_state); /* twiddle factors*/
 440:../../opus/celt/kiss_fft.c **** 
 441:../../opus/celt/kiss_fft.c ****     if ( lenmem==NULL ) {
 442:../../opus/celt/kiss_fft.c ****         st = ( kiss_fft_state*)KISS_FFT_MALLOC( memneeded );
 443:../../opus/celt/kiss_fft.c ****     }else{
 444:../../opus/celt/kiss_fft.c ****         if (mem != NULL && *lenmem >= memneeded)
 445:../../opus/celt/kiss_fft.c ****             st = (kiss_fft_state*)mem;
 446:../../opus/celt/kiss_fft.c ****         *lenmem = memneeded;
 447:../../opus/celt/kiss_fft.c ****     }
 448:../../opus/celt/kiss_fft.c ****     if (st) {
 449:../../opus/celt/kiss_fft.c ****         opus_int16 *bitrev;
 450:../../opus/celt/kiss_fft.c ****         kiss_twiddle_cpx *twiddles;
 451:../../opus/celt/kiss_fft.c **** 
 452:../../opus/celt/kiss_fft.c ****         st->nfft=nfft;
 453:../../opus/celt/kiss_fft.c **** #ifdef FIXED_POINT
 454:../../opus/celt/kiss_fft.c ****         st->scale_shift = celt_ilog2(st->nfft);
 455:../../opus/celt/kiss_fft.c ****         if (st->nfft == 1<<st->scale_shift)
 456:../../opus/celt/kiss_fft.c ****            st->scale = Q15ONE;
 457:../../opus/celt/kiss_fft.c ****         else
 458:../../opus/celt/kiss_fft.c ****            st->scale = (1073741824+st->nfft/2)/st->nfft>>(15-st->scale_shift);
 459:../../opus/celt/kiss_fft.c **** #else
 460:../../opus/celt/kiss_fft.c ****         st->scale = 1.f/nfft;
 461:../../opus/celt/kiss_fft.c **** #endif
 462:../../opus/celt/kiss_fft.c ****         if (base != NULL)
 463:../../opus/celt/kiss_fft.c ****         {
 464:../../opus/celt/kiss_fft.c ****            st->twiddles = base->twiddles;
 465:../../opus/celt/kiss_fft.c ****            st->shift = 0;
 466:../../opus/celt/kiss_fft.c ****            while (st->shift < 32 && nfft<<st->shift != base->nfft)
 467:../../opus/celt/kiss_fft.c ****               st->shift++;
 468:../../opus/celt/kiss_fft.c ****            if (st->shift>=32)
 469:../../opus/celt/kiss_fft.c ****               goto fail;
 470:../../opus/celt/kiss_fft.c ****         } else {
 471:../../opus/celt/kiss_fft.c ****            st->twiddles = twiddles = (kiss_twiddle_cpx*)KISS_FFT_MALLOC(sizeof(kiss_twiddle_cpx)*nf
 472:../../opus/celt/kiss_fft.c ****            compute_twiddles(twiddles, nfft);
 473:../../opus/celt/kiss_fft.c ****            st->shift = -1;
 474:../../opus/celt/kiss_fft.c ****         }
