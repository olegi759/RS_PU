 485:../../opus/celt/kiss_fft.c **** 
 486:../../opus/celt/kiss_fft.c ****         /* Initialize architecture specific fft parameters */
 487:../../opus/celt/kiss_fft.c ****         if (opus_fft_alloc_arch(st, arch))
 488:../../opus/celt/kiss_fft.c ****             goto fail;
 489:../../opus/celt/kiss_fft.c ****     }
