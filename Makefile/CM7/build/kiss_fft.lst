 314:../../opus/celt/kiss_fft.c **** 
 315:../../opus/celt/kiss_fft.c **** static
 316:../../opus/celt/kiss_fft.c **** void compute_bitrev_table(
 317:../../opus/celt/kiss_fft.c ****          int Fout,
 318:../../opus/celt/kiss_fft.c ****          opus_int16 *f,
 319:../../opus/celt/kiss_fft.c ****          const size_t fstride,
 320:../../opus/celt/kiss_fft.c ****          int in_stride,
 321:../../opus/celt/kiss_fft.c ****          opus_int16 * factors,
 322:../../opus/celt/kiss_fft.c ****          const kiss_fft_state *st
 323:../../opus/celt/kiss_fft.c ****             )
 324:../../opus/celt/kiss_fft.c **** {
 325:../../opus/celt/kiss_fft.c ****    const int p=*factors++; /* the radix  */
 326:../../opus/celt/kiss_fft.c ****    const int m=*factors++; /* stage's fft length/p */
 327:../../opus/celt/kiss_fft.c **** 
 328:../../opus/celt/kiss_fft.c ****     /*printf ("fft %d %d %d %d %d %d\n", p*m, m, p, s2, fstride*in_stride, N);*/
 329:../../opus/celt/kiss_fft.c ****    if (m==1)
 330:../../opus/celt/kiss_fft.c ****    {
 331:../../opus/celt/kiss_fft.c ****       int j;
 332:../../opus/celt/kiss_fft.c ****       for (j=0;j<p;j++)
 333:../../opus/celt/kiss_fft.c ****       {
 334:../../opus/celt/kiss_fft.c ****          *f = Fout+j;
 335:../../opus/celt/kiss_fft.c ****          f += fstride*in_stride;
 336:../../opus/celt/kiss_fft.c ****       }
 337:../../opus/celt/kiss_fft.c ****    } else {
 338:../../opus/celt/kiss_fft.c ****       int j;
 339:../../opus/celt/kiss_fft.c ****       for (j=0;j<p;j++)
 340:../../opus/celt/kiss_fft.c ****       {
 341:../../opus/celt/kiss_fft.c ****          compute_bitrev_table( Fout , f, fstride*p, in_stride, factors,st);
 342:../../opus/celt/kiss_fft.c ****          f += fstride*in_stride;
 343:../../opus/celt/kiss_fft.c ****          Fout += m;
 344:../../opus/celt/kiss_fft.c ****       }
 345:../../opus/celt/kiss_fft.c ****    }
 346:../../opus/celt/kiss_fft.c **** }
 347:../../opus/celt/kiss_fft.c **** 
 348:../../opus/celt/kiss_fft.c **** /*  facbuf is populated by p1,m1,p2,m2, ...
 349:../../opus/celt/kiss_fft.c ****     where
 350:../../opus/celt/kiss_fft.c ****     p[i] * m[i] = m[i-1]
 351:../../opus/celt/kiss_fft.c ****     m0 = n                  */
 352:../../opus/celt/kiss_fft.c **** static
 353:../../opus/celt/kiss_fft.c **** int kf_factor(int n,opus_int16 * facbuf)
 354:../../opus/celt/kiss_fft.c **** {
 355:../../opus/celt/kiss_fft.c ****     int p=4;
 356:../../opus/celt/kiss_fft.c ****     int i;
 357:../../opus/celt/kiss_fft.c ****     int stages=0;
 358:../../opus/celt/kiss_fft.c ****     int nbak = n;
 359:../../opus/celt/kiss_fft.c **** 
 360:../../opus/celt/kiss_fft.c ****     /*factor out powers of 4, powers of 2, then any remaining primes */
 361:../../opus/celt/kiss_fft.c ****     do {
 362:../../opus/celt/kiss_fft.c ****         while (n % p) {
 363:../../opus/celt/kiss_fft.c ****             switch (p) {
 364:../../opus/celt/kiss_fft.c ****                 case 4: p = 2; break;
 365:../../opus/celt/kiss_fft.c ****                 case 2: p = 3; break;
ARM GAS  C:\Users\oleg\AppData\Local\Temp\cciMhymU.s 			page 38


 366:../../opus/celt/kiss_fft.c ****                 default: p += 2; break;
 367:../../opus/celt/kiss_fft.c ****             }
 368:../../opus/celt/kiss_fft.c ****             if (p>32000 || (opus_int32)p*(opus_int32)p > n)
 369:../../opus/celt/kiss_fft.c ****                 p = n;          /* no more factors, skip to end */
 370:../../opus/celt/kiss_fft.c ****         }
 371:../../opus/celt/kiss_fft.c ****         n /= p;
 372:../../opus/celt/kiss_fft.c **** #ifdef RADIX_TWO_ONLY
 373:../../opus/celt/kiss_fft.c ****         if (p!=2 && p != 4)
 374:../../opus/celt/kiss_fft.c **** #else
 375:../../opus/celt/kiss_fft.c ****         if (p>5)
 376:../../opus/celt/kiss_fft.c **** #endif
 377:../../opus/celt/kiss_fft.c ****         {
 378:../../opus/celt/kiss_fft.c ****            return 0;
 379:../../opus/celt/kiss_fft.c ****         }
 380:../../opus/celt/kiss_fft.c ****         facbuf[2*stages] = p;
 381:../../opus/celt/kiss_fft.c ****         if (p==2 && stages > 1)
 382:../../opus/celt/kiss_fft.c ****         {
 383:../../opus/celt/kiss_fft.c ****            facbuf[2*stages] = 4;
 384:../../opus/celt/kiss_fft.c ****            facbuf[2] = 2;
 385:../../opus/celt/kiss_fft.c ****         }
 386:../../opus/celt/kiss_fft.c ****         stages++;
 387:../../opus/celt/kiss_fft.c ****     } while (n > 1);
 388:../../opus/celt/kiss_fft.c ****     n = nbak;
 389:../../opus/celt/kiss_fft.c ****     /* Reverse the order to get the radix 4 at the end, so we can use the
 390:../../opus/celt/kiss_fft.c ****        fast degenerate case. It turns out that reversing the order also
 391:../../opus/celt/kiss_fft.c ****        improves the noise behaviour. */
 392:../../opus/celt/kiss_fft.c ****     for (i=0;i<stages/2;i++)
 393:../../opus/celt/kiss_fft.c ****     {
 394:../../opus/celt/kiss_fft.c ****        int tmp;
 395:../../opus/celt/kiss_fft.c ****        tmp = facbuf[2*i];
 396:../../opus/celt/kiss_fft.c ****        facbuf[2*i] = facbuf[2*(stages-i-1)];
 397:../../opus/celt/kiss_fft.c ****        facbuf[2*(stages-i-1)] = tmp;
 398:../../opus/celt/kiss_fft.c ****     }
 399:../../opus/celt/kiss_fft.c ****     for (i=0;i<stages;i++)
 400:../../opus/celt/kiss_fft.c ****     {
 401:../../opus/celt/kiss_fft.c ****         n /= facbuf[2*i];
 402:../../opus/celt/kiss_fft.c ****         facbuf[2*i+1] = n;
 403:../../opus/celt/kiss_fft.c ****     }
 404:../../opus/celt/kiss_fft.c ****     return 1;
 405:../../opus/celt/kiss_fft.c **** }
