 407:../../opus/celt/kiss_fft.c **** static void compute_twiddles(kiss_twiddle_cpx *twiddles, int nfft)
 408:../../opus/celt/kiss_fft.c **** {
 409:../../opus/celt/kiss_fft.c ****    int i;
 410:../../opus/celt/kiss_fft.c **** #ifdef FIXED_POINT
 411:../../opus/celt/kiss_fft.c ****    for (i=0;i<nfft;++i) {
 412:../../opus/celt/kiss_fft.c ****       opus_val32 phase = -i;
 413:../../opus/celt/kiss_fft.c ****       kf_cexp2(twiddles+i, DIV32(SHL32(phase,17),nfft));
 414:../../opus/celt/kiss_fft.c ****    }
 415:../../opus/celt/kiss_fft.c **** #else
 416:../../opus/celt/kiss_fft.c ****    for (i=0;i<nfft;++i) {
 417:../../opus/celt/kiss_fft.c ****       const double pi=3.14159265358979323846264338327;
 418:../../opus/celt/kiss_fft.c ****       double phase = ( -2*pi /nfft ) * i;
 419:../../opus/celt/kiss_fft.c ****       kf_cexp(twiddles+i, phase );
 420:../../opus/celt/kiss_fft.c ****    }
 421:../../opus/celt/kiss_fft.c **** #endif
 422:../../opus/celt/kiss_fft.c **** }
