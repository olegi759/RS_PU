  65:../../opus/celt/pitch.h **** static OPUS_INLINE void xcorr_kernel_c(const opus_val16 * x, const opus_val16 * y, opus_val32 sum[4
  66:../../opus/celt/pitch.h **** {
  67:../../opus/celt/pitch.h ****    int j;
  68:../../opus/celt/pitch.h ****    opus_val16 y_0, y_1, y_2, y_3;
  69:../../opus/celt/pitch.h ****    celt_assert(len>=3);
  70:../../opus/celt/pitch.h ****    y_3=0; /* gcc doesn't realize that y_3 can't be used uninitialized */
  71:../../opus/celt/pitch.h ****    y_0=*y++;
  72:../../opus/celt/pitch.h ****    y_1=*y++;
  73:../../opus/celt/pitch.h ****    y_2=*y++;
