 129:../../opus/celt/celt.c ****       t = MAC16_32_Q16(t, g12, ADD32(x2,x1));
 130:../../opus/celt/celt.c ****       t = SATURATE(t, SIG_SAT);
 131:../../opus/celt/celt.c ****       y[i+3] = t;
