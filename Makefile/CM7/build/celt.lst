 257:../../opus/celt/celt.c **** /* TF change table. Positive values mean better frequency resolution (longer
 258:../../opus/celt/celt.c ****    effective window), whereas negative values mean better time resolution
 259:../../opus/celt/celt.c ****    (shorter effective window). The second index is computed as:
 260:../../opus/celt/celt.c ****    4*isTransient + 2*tf_select + per_band_flag */
 261:../../opus/celt/celt.c **** const signed char tf_select_table[4][8] = {
 262:../../opus/celt/celt.c ****     /*isTransient=0     isTransient=1 */
 263:../../opus/celt/celt.c ****       {0, -1, 0, -1,    0,-1, 0,-1}, /* 2.5 ms */
 264:../../opus/celt/celt.c ****       {0, -1, 0, -2,    1, 0, 1,-1}, /* 5 ms */
 265:../../opus/celt/celt.c ****       {0, -2, 0, -3,    2, 0, 1,-1}, /* 10 ms */
 266:../../opus/celt/celt.c ****       {0, -2, 0, -3,    3, 0, 1,-1}, /* 20 ms */
 267:../../opus/celt/celt.c **** };
