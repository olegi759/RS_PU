 135:../../opus/celt/celt.c ****       t = MAC16_32_Q16(t, g12, ADD32(x1,x0));
 136:../../opus/celt/celt.c ****       t = SATURATE(t, SIG_SAT);
 137:../../opus/celt/celt.c ****       y[i+4] = t;
