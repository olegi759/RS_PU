  59:../../opus/celt/celt.c **** 
  60:../../opus/celt/celt.c **** int resampling_factor(opus_int32 rate)
  61:../../opus/celt/celt.c **** {
  62:../../opus/celt/celt.c ****    int ret;
  63:../../opus/celt/celt.c ****    switch (rate)
  64:../../opus/celt/celt.c ****    {
  65:../../opus/celt/celt.c ****    case 48000:
  66:../../opus/celt/celt.c ****       ret = 1;
  67:../../opus/celt/celt.c ****       break;
  68:../../opus/celt/celt.c ****    case 24000:
  69:../../opus/celt/celt.c ****       ret = 2;
  70:../../opus/celt/celt.c ****       break;
  71:../../opus/celt/celt.c ****    case 16000:
  72:../../opus/celt/celt.c ****       ret = 3;
  73:../../opus/celt/celt.c ****       break;
  74:../../opus/celt/celt.c ****    case 12000:
  75:../../opus/celt/celt.c ****       ret = 4;
  76:../../opus/celt/celt.c ****       break;
  77:../../opus/celt/celt.c ****    case 8000:
  78:../../opus/celt/celt.c ****       ret = 6;
  79:../../opus/celt/celt.c ****       break;
  80:../../opus/celt/celt.c ****    default:
  81:../../opus/celt/celt.c **** #ifndef CUSTOM_MODES
  82:../../opus/celt/celt.c ****       celt_assert(0);
  83:../../opus/celt/celt.c **** #endif
  84:../../opus/celt/celt.c ****       ret = 0;
  85:../../opus/celt/celt.c ****       break;
  86:../../opus/celt/celt.c ****    }
  87:../../opus/celt/celt.c ****    return ret;
  88:../../opus/celt/celt.c **** }
