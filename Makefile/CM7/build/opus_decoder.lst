 177:../../opus/celt/mathops.h **** 
 178:../../opus/celt/mathops.h **** #ifndef OVERRIDE_CELT_ILOG2
 179:../../opus/celt/mathops.h **** /** Integer log in base2. Undefined for zero and negative numbers */
 180:../../opus/celt/mathops.h **** static OPUS_INLINE opus_int16 celt_ilog2(opus_int32 x)
 181:../../opus/celt/mathops.h **** {
 182:../../opus/celt/mathops.h ****    celt_sig_assert(x>0);
 183:../../opus/celt/mathops.h ****    return EC_ILOG(x)-1;
 184:../../opus/celt/mathops.h **** }
 185:../../opus/celt/mathops.h **** #endif
 186:../../opus/celt/mathops.h **** 
 187:../../opus/celt/mathops.h **** 
 188:../../opus/celt/mathops.h **** /** Integer log in base2. Defined for zero, but not for negative numbers */
 189:../../opus/celt/mathops.h **** static OPUS_INLINE opus_int16 celt_zlog2(opus_val32 x)
 190:../../opus/celt/mathops.h **** {
 191:../../opus/celt/mathops.h ****    return x <= 0 ? 0 : celt_ilog2(x);
 192:../../opus/celt/mathops.h **** }
