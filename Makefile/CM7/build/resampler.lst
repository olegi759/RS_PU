  50:../../opus/silk/resampler.c **** /* Tables with delay compensation values to equalize total delay for different modes */
  51:../../opus/silk/resampler.c **** static const opus_int8 delay_matrix_enc[ 5 ][ 3 ] = {
  52:../../opus/silk/resampler.c **** /* in  \ out  8  12  16 */
  53:../../opus/silk/resampler.c **** /*  8 */   {  6,  0,  3 },
  54:../../opus/silk/resampler.c **** /* 12 */   {  0,  7,  3 },
  55:../../opus/silk/resampler.c **** /* 16 */   {  0,  1, 10 },
  56:../../opus/silk/resampler.c **** /* 24 */   {  0,  2,  6 },
  57:../../opus/silk/resampler.c **** /* 48 */   { 18, 10, 12 }
  58:../../opus/silk/resampler.c **** };
  59:../../opus/silk/resampler.c **** 
  60:../../opus/silk/resampler.c **** static const opus_int8 delay_matrix_dec[ 3 ][ 5 ] = {
  61:../../opus/silk/resampler.c **** /* in  \ out  8  12  16  24  48 */
  62:../../opus/silk/resampler.c **** /*  8 */   {  4,  0,  2,  0,  0 },
  63:../../opus/silk/resampler.c **** /* 12 */   {  0,  9,  4,  7,  4 },
  64:../../opus/silk/resampler.c **** /* 16 */   {  0,  3, 12,  7,  7 }
  65:../../opus/silk/resampler.c **** };
  66:../../opus/silk/resampler.c **** 
  67:../../opus/silk/resampler.c **** /* Simple way to make [8000, 12000, 16000, 24000, 48000] to [0, 1, 2, 3, 4] */
