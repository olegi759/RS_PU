  34:../../opus/silk/LPC_analysis_filter.c **** /* LPC analysis filter                     */
  35:../../opus/silk/LPC_analysis_filter.c **** /* NB! State is kept internally and the    */
  36:../../opus/silk/LPC_analysis_filter.c **** /* filter always starts with zero state    */
  37:../../opus/silk/LPC_analysis_filter.c **** /* first d output samples are set to zero  */
  38:../../opus/silk/LPC_analysis_filter.c **** /*******************************************/
  39:../../opus/silk/LPC_analysis_filter.c **** 
  40:../../opus/silk/LPC_analysis_filter.c **** /* OPT: Using celt_fir() for this function should be faster, but it may cause
  41:../../opus/silk/LPC_analysis_filter.c ****    integer overflows in intermediate values (not final results), which the
  42:../../opus/silk/LPC_analysis_filter.c ****    current implementation silences by casting to unsigned. Enabling
  43:../../opus/silk/LPC_analysis_filter.c ****    this should be safe in pretty much all cases, even though it is not technically
  44:../../opus/silk/LPC_analysis_filter.c ****    C89-compliant. */
  45:../../opus/silk/LPC_analysis_filter.c **** #define USE_CELT_FIR 0
