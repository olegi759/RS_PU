  61:../../opus/celt/mdct.c **** int clt_mdct_init(mdct_lookup *l,int N, int maxshift, int arch)
  62:../../opus/celt/mdct.c **** {
  63:../../opus/celt/mdct.c ****    int i;
  64:../../opus/celt/mdct.c ****    kiss_twiddle_scalar *trig;
  65:../../opus/celt/mdct.c ****    int shift;
  66:../../opus/celt/mdct.c ****    int N2=N>>1;
  67:../../opus/celt/mdct.c ****    l->n = N;
  68:../../opus/celt/mdct.c ****    l->maxshift = maxshift;
  69:../../opus/celt/mdct.c ****    for (i=0;i<=maxshift;i++)
  70:../../opus/celt/mdct.c ****    {
  71:../../opus/celt/mdct.c ****       if (i==0)
  72:../../opus/celt/mdct.c ****          l->kfft[i] = opus_fft_alloc(N>>2>>i, 0, 0, arch);
  73:../../opus/celt/mdct.c ****       else
  74:../../opus/celt/mdct.c ****          l->kfft[i] = opus_fft_alloc_twiddles(N>>2>>i, 0, 0, l->kfft[0], arch);
  75:../../opus/celt/mdct.c **** #ifndef ENABLE_TI_DSPLIB55
  76:../../opus/celt/mdct.c ****       if (l->kfft[i]==NULL)
  77:../../opus/celt/mdct.c ****          return 0;
  78:../../opus/celt/mdct.c **** #endif
  79:../../opus/celt/mdct.c ****    }
  80:../../opus/celt/mdct.c ****    l->trig = trig = (kiss_twiddle_scalar*)opus_alloc((N-(N2>>maxshift))*sizeof(kiss_twiddle_scalar)
  81:../../opus/celt/mdct.c ****    if (l->trig==NULL)
  82:../../opus/celt/mdct.c ****      return 0;
  83:../../opus/celt/mdct.c ****    for (shift=0;shift<=maxshift;shift++)
  84:../../opus/celt/mdct.c ****    {
  85:../../opus/celt/mdct.c ****       /* We have enough points that sine isn't necessary */
  86:../../opus/celt/mdct.c **** #if defined(FIXED_POINT)
  87:../../opus/celt/mdct.c **** #if 1
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccR3EsjT.s 			page 3


  88:../../opus/celt/mdct.c ****       for (i=0;i<N2;i++)
  89:../../opus/celt/mdct.c ****          trig[i] = TRIG_UPSCALE*celt_cos_norm(DIV32(ADD32(SHL32(EXTEND32(i),17),N2+16384),N));
  90:../../opus/celt/mdct.c **** #else
  91:../../opus/celt/mdct.c ****       for (i=0;i<N2;i++)
  92:../../opus/celt/mdct.c ****          trig[i] = (kiss_twiddle_scalar)MAX32(-32767,MIN32(32767,floor(.5+32768*cos(2*M_PI*(i+.125)
  93:../../opus/celt/mdct.c **** #endif
  94:../../opus/celt/mdct.c **** #else
  95:../../opus/celt/mdct.c ****       for (i=0;i<N2;i++)
  96:../../opus/celt/mdct.c ****          trig[i] = (kiss_twiddle_scalar)cos(2*PI*(i+.125)/N);
  97:../../opus/celt/mdct.c **** #endif
  98:../../opus/celt/mdct.c ****       trig += N2;
  99:../../opus/celt/mdct.c ****       N2 >>= 1;
 100:../../opus/celt/mdct.c ****       N >>= 1;
 101:../../opus/celt/mdct.c ****    }
 102:../../opus/celt/mdct.c ****    return 1;
 103:../../opus/celt/mdct.c **** }
