 108:../../opus/celt/mdct.c ****    for (i=0;i<=l->maxshift;i++)
 109:../../opus/celt/mdct.c ****       opus_fft_free(l->kfft[i], arch);
 110:../../opus/celt/mdct.c ****    opus_free((kiss_twiddle_scalar*)l->trig);
 111:../../opus/celt/mdct.c **** }
