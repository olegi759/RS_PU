  77:../../opus/celt/modes.c **** /* Defining 25 critical bands for the full 0-20 kHz audio bandwidth
  78:../../opus/celt/modes.c ****    Taken from http://ccrma.stanford.edu/~jos/bbt/Bark_Frequency_Scale.html */
  79:../../opus/celt/modes.c **** #define BARK_BANDS 25
  80:../../opus/celt/modes.c **** static const opus_int16 bark_freq[BARK_BANDS+1] = {
  81:../../opus/celt/modes.c ****       0,   100,   200,   300,   400,
  82:../../opus/celt/modes.c ****     510,   630,   770,   920,  1080,
  83:../../opus/celt/modes.c ****    1270,  1480,  1720,  2000,  2320,
  84:../../opus/celt/modes.c ****    2700,  3150,  3700,  4400,  5300,
  85:../../opus/celt/modes.c ****    6400,  7700,  9500, 12000, 15500,
  86:../../opus/celt/modes.c ****   20000};
