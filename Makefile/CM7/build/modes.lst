 165:../../opus/celt/modes.c **** static void compute_allocation_table(CELTMode *mode)
 166:../../opus/celt/modes.c **** {
 167:../../opus/celt/modes.c ****    int i, j;
 168:../../opus/celt/modes.c ****    unsigned char *allocVectors;
 169:../../opus/celt/modes.c ****    int maxBands = sizeof(eband5ms)/sizeof(eband5ms[0])-1;
 170:../../opus/celt/modes.c **** 
 171:../../opus/celt/modes.c ****    mode->nbAllocVectors = BITALLOC_SIZE;
 172:../../opus/celt/modes.c ****    allocVectors = opus_alloc(sizeof(unsigned char)*(BITALLOC_SIZE*mode->nbEBands));
 173:../../opus/celt/modes.c ****    if (allocVectors==NULL)
 174:../../opus/celt/modes.c ****    {
 175:../../opus/celt/modes.c ****       mode->allocVectors = NULL;
 176:../../opus/celt/modes.c ****       return;
 177:../../opus/celt/modes.c ****    }
 178:../../opus/celt/modes.c **** 
 179:../../opus/celt/modes.c ****    /* Check for standard mode */
 180:../../opus/celt/modes.c ****    if (mode->Fs == 400*(opus_int32)mode->shortMdctSize)
 181:../../opus/celt/modes.c ****    {
 182:../../opus/celt/modes.c ****       for (i=0;i<BITALLOC_SIZE*mode->nbEBands;i++)
 183:../../opus/celt/modes.c ****          allocVectors[i] = band_allocation[i];
 184:../../opus/celt/modes.c ****       mode->allocVectors = allocVectors;
 185:../../opus/celt/modes.c ****       return;
 186:../../opus/celt/modes.c ****    }
 187:../../opus/celt/modes.c ****    /* If not the standard mode, interpolate */
 188:../../opus/celt/modes.c ****    /* Compute per-codec-band allocation from per-critical-band matrix */
 189:../../opus/celt/modes.c ****    for (i=0;i<BITALLOC_SIZE;i++)
 190:../../opus/celt/modes.c ****    {
 191:../../opus/celt/modes.c ****       for (j=0;j<mode->nbEBands;j++)
 192:../../opus/celt/modes.c ****       {
 193:../../opus/celt/modes.c ****          int k;
 194:../../opus/celt/modes.c ****          for (k=0;k<maxBands;k++)
 195:../../opus/celt/modes.c ****          {
 196:../../opus/celt/modes.c ****             if (400*(opus_int32)eband5ms[k] > mode->eBands[j]*(opus_int32)mode->Fs/mode->shortMdctS
 197:../../opus/celt/modes.c ****                break;
 198:../../opus/celt/modes.c ****          }
 199:../../opus/celt/modes.c ****          if (k>maxBands-1)
 200:../../opus/celt/modes.c ****             allocVectors[i*mode->nbEBands+j] = band_allocation[i*maxBands + maxBands-1];
 201:../../opus/celt/modes.c ****          else {
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccpBe7H4.s 			page 5


 202:../../opus/celt/modes.c ****             opus_int32 a0, a1;
 203:../../opus/celt/modes.c ****             a1 = mode->eBands[j]*(opus_int32)mode->Fs/mode->shortMdctSize - 400*(opus_int32)eband5m
 204:../../opus/celt/modes.c ****             a0 = 400*(opus_int32)eband5ms[k] - mode->eBands[j]*(opus_int32)mode->Fs/mode->shortMdct
 205:../../opus/celt/modes.c ****             allocVectors[i*mode->nbEBands+j] = (a0*band_allocation[i*maxBands+k-1]
 206:../../opus/celt/modes.c ****                                              + a1*band_allocation[i*maxBands+k])/(a0+a1);
 207:../../opus/celt/modes.c ****          }
 208:../../opus/celt/modes.c ****       }
 209:../../opus/celt/modes.c ****    }
