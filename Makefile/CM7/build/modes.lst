  88:../../opus/celt/modes.c **** static opus_int16 *compute_ebands(opus_int32 Fs, int frame_size, int res, int *nbEBands)
  89:../../opus/celt/modes.c **** {
  90:../../opus/celt/modes.c ****    opus_int16 *eBands;
  91:../../opus/celt/modes.c ****    int i, j, lin, low, high, nBark, offset=0;
  92:../../opus/celt/modes.c **** 
  93:../../opus/celt/modes.c ****    /* All modes that have 2.5 ms short blocks use the same definition */
  94:../../opus/celt/modes.c ****    if (Fs == 400*(opus_int32)frame_size)
  95:../../opus/celt/modes.c ****    {
  96:../../opus/celt/modes.c ****       *nbEBands = sizeof(eband5ms)/sizeof(eband5ms[0])-1;
  97:../../opus/celt/modes.c ****       eBands = opus_alloc(sizeof(opus_int16)*(*nbEBands+1));
  98:../../opus/celt/modes.c ****       for (i=0;i<*nbEBands+1;i++)
  99:../../opus/celt/modes.c ****          eBands[i] = eband5ms[i];
 100:../../opus/celt/modes.c ****       return eBands;
 101:../../opus/celt/modes.c ****    }
 102:../../opus/celt/modes.c ****    /* Find the number of critical bands supported by our sampling rate */
 103:../../opus/celt/modes.c ****    for (nBark=1;nBark<BARK_BANDS;nBark++)
 104:../../opus/celt/modes.c ****     if (bark_freq[nBark+1]*2 >= Fs)
 105:../../opus/celt/modes.c ****        break;
 106:../../opus/celt/modes.c **** 
 107:../../opus/celt/modes.c ****    /* Find where the linear part ends (i.e. where the spacing is more than min_width */
 108:../../opus/celt/modes.c ****    for (lin=0;lin<nBark;lin++)
 109:../../opus/celt/modes.c ****       if (bark_freq[lin+1]-bark_freq[lin] >= res)
 110:../../opus/celt/modes.c ****          break;
 111:../../opus/celt/modes.c **** 
 112:../../opus/celt/modes.c ****    low = (bark_freq[lin]+res/2)/res;
 113:../../opus/celt/modes.c ****    high = nBark-lin;
 114:../../opus/celt/modes.c ****    *nbEBands = low+high;
 115:../../opus/celt/modes.c ****    eBands = opus_alloc(sizeof(opus_int16)*(*nbEBands+2));
 116:../../opus/celt/modes.c **** 
 117:../../opus/celt/modes.c ****    if (eBands==NULL)
 118:../../opus/celt/modes.c ****       return NULL;
 119:../../opus/celt/modes.c **** 
 120:../../opus/celt/modes.c ****    /* Linear spacing (min_width) */
 121:../../opus/celt/modes.c ****    for (i=0;i<low;i++)
 122:../../opus/celt/modes.c ****       eBands[i] = i;
 123:../../opus/celt/modes.c ****    if (low>0)
 124:../../opus/celt/modes.c ****       offset = eBands[low-1]*res - bark_freq[lin-1];
 125:../../opus/celt/modes.c ****    /* Spacing follows critical bands */
 126:../../opus/celt/modes.c ****    for (i=0;i<high;i++)
 127:../../opus/celt/modes.c ****    {
 128:../../opus/celt/modes.c ****       int target = bark_freq[lin+i];
 129:../../opus/celt/modes.c ****       /* Round to an even value */
 130:../../opus/celt/modes.c ****       eBands[i+low] = (target+offset/2+res)/(2*res)*2;
 131:../../opus/celt/modes.c ****       offset = eBands[i+low]*res - target;
 132:../../opus/celt/modes.c ****    }
 133:../../opus/celt/modes.c ****    /* Enforce the minimum spacing at the boundary */
 134:../../opus/celt/modes.c ****    for (i=0;i<*nbEBands;i++)
 135:../../opus/celt/modes.c ****       if (eBands[i] < i)
 136:../../opus/celt/modes.c ****          eBands[i] = i;
 137:../../opus/celt/modes.c ****    /* Round to an even value */
 138:../../opus/celt/modes.c ****    eBands[*nbEBands] = (bark_freq[nBark]+res)/(2*res)*2;
 139:../../opus/celt/modes.c ****    if (eBands[*nbEBands] > frame_size)
 140:../../opus/celt/modes.c ****       eBands[*nbEBands] = frame_size;
 141:../../opus/celt/modes.c ****    for (i=1;i<*nbEBands-1;i++)
 142:../../opus/celt/modes.c ****    {
 143:../../opus/celt/modes.c ****       if (eBands[i+1]-eBands[i] < eBands[i]-eBands[i-1])
 144:../../opus/celt/modes.c ****       {
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccpBe7H4.s 			page 4


 145:../../opus/celt/modes.c ****          eBands[i] -= (2*eBands[i]-eBands[i-1]-eBands[i+1])/2;
 146:../../opus/celt/modes.c ****       }
 147:../../opus/celt/modes.c ****    }
 148:../../opus/celt/modes.c ****    /* Remove any empty bands. */
 149:../../opus/celt/modes.c ****    for (i=j=0;i<*nbEBands;i++)
 150:../../opus/celt/modes.c ****       if(eBands[i+1]>eBands[j])
 151:../../opus/celt/modes.c ****          eBands[++j]=eBands[i+1];
 152:../../opus/celt/modes.c ****    *nbEBands=j;
 153:../../opus/celt/modes.c **** 
 154:../../opus/celt/modes.c ****    for (i=1;i<*nbEBands;i++)
 155:../../opus/celt/modes.c ****    {
 156:../../opus/celt/modes.c ****       /* Every band must be smaller than the last band. */
 157:../../opus/celt/modes.c ****       celt_assert(eBands[i]-eBands[i-1]<=eBands[*nbEBands]-eBands[*nbEBands-1]);
 158:../../opus/celt/modes.c ****       /* Each band must be no larger than twice the size of the previous one. */
 159:../../opus/celt/modes.c ****       celt_assert(eBands[i+1]-eBands[i]<=2*(eBands[i]-eBands[i-1]));
 160:../../opus/celt/modes.c ****    }
 161:../../opus/celt/modes.c **** 
 162:../../opus/celt/modes.c ****    return eBands;
 163:../../opus/celt/modes.c **** }
