 411:../../opus/celt/celt_decoder.c ****       for (b=0;b<B;b++)
 412:../../opus/celt/celt_decoder.c ****          clt_mdct_backward(&mode->mdct, &freq[b], out_syn[1]+NB*b, mode->window, overlap, shift, B,
 413:../../opus/celt/celt_decoder.c ****    } else if (CC==1&&C==2)
 414:../../opus/celt/celt_decoder.c ****    {
 415:../../opus/celt/celt_decoder.c ****       /* Downmixing a stereo stream to mono */
 416:../../opus/celt/celt_decoder.c ****       celt_sig *freq2;
 417:../../opus/celt/celt_decoder.c ****       freq2 = out_syn[0]+overlap/2;
 418:../../opus/celt/celt_decoder.c ****       denormalise_bands(mode, X, freq, oldBandE, start, effEnd, M,
 419:../../opus/celt/celt_decoder.c ****             downsample, silence);
 420:../../opus/celt/celt_decoder.c ****       /* Use the output buffer as temp array before downmixing. */
 421:../../opus/celt/celt_decoder.c ****       denormalise_bands(mode, X+N, freq2, oldBandE+nbEBands, start, effEnd, M,
 422:../../opus/celt/celt_decoder.c ****             downsample, silence);
 423:../../opus/celt/celt_decoder.c ****       for (i=0;i<N;i++)
 424:../../opus/celt/celt_decoder.c ****          freq[i] = ADD32(HALF32(freq[i]), HALF32(freq2[i]));
 425:../../opus/celt/celt_decoder.c ****       for (b=0;b<B;b++)
 426:../../opus/celt/celt_decoder.c ****          clt_mdct_backward(&mode->mdct, &freq[b], out_syn[0]+NB*b, mode->window, overlap, shift, B,
 427:../../opus/celt/celt_decoder.c ****    } else {
 428:../../opus/celt/celt_decoder.c ****       /* Normal case (mono or stereo) */
 429:../../opus/celt/celt_decoder.c ****       c=0; do {
 430:../../opus/celt/celt_decoder.c ****          denormalise_bands(mode, X+c*N, freq, oldBandE+c*nbEBands, start, effEnd, M,
 431:../../opus/celt/celt_decoder.c ****                downsample, silence);
 432:../../opus/celt/celt_decoder.c ****          for (b=0;b<B;b++)
 433:../../opus/celt/celt_decoder.c ****             clt_mdct_backward(&mode->mdct, &freq[b], out_syn[c]+NB*b, mode->window, overlap, shift,
 434:../../opus/celt/celt_decoder.c ****       } while (++c<CC);
 435:../../opus/celt/celt_decoder.c ****    }
 436:../../opus/celt/celt_decoder.c ****    /* Saturate IMDCT output so that we can't overflow in the pitch postfilter
 437:../../opus/celt/celt_decoder.c ****       or in the */
 438:../../opus/celt/celt_decoder.c ****    c=0; do {
 439:../../opus/celt/celt_decoder.c ****       for (i=0;i<N;i++)
