 100:../../opus/celt/mathops.h ****    opus_val32 minval = 0;
 101:../../opus/celt/mathops.h ****    for (i=0;i<len;i++)
 102:../../opus/celt/mathops.h ****    {
 103:../../opus/celt/mathops.h ****       maxval = MAX32(maxval, x[i]);
 104:../../opus/celt/mathops.h ****       minval = MIN32(minval, x[i]);
 105:../../opus/celt/mathops.h ****    }
 106:../../opus/celt/mathops.h ****    return MAX32(maxval, -minval);
 107:../../opus/celt/mathops.h **** }
