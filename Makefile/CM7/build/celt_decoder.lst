  52:../../opus/celt/celt_decoder.c **** /* The maximum pitch lag to allow in the pitch-based PLC. It's possible to save
  53:../../opus/celt/celt_decoder.c ****    CPU time in the PLC pitch search by making this smaller than MAX_PERIOD. The
  54:../../opus/celt/celt_decoder.c ****    current value corresponds to a pitch of 66.67 Hz. */
  55:../../opus/celt/celt_decoder.c **** #define PLC_PITCH_LAG_MAX (720)
  56:../../opus/celt/celt_decoder.c **** /* The minimum pitch lag to allow in the pitch-based PLC. This corresponds to a
  57:../../opus/celt/celt_decoder.c ****    pitch of 480 Hz. */
  58:../../opus/celt/celt_decoder.c **** #define PLC_PITCH_LAG_MIN (100)
