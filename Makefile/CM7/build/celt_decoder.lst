 110:../../opus/celt/celt_decoder.c **** #if defined(ENABLE_HARDENING) || defined(ENABLE_ASSERTIONS)
 111:../../opus/celt/celt_decoder.c **** /* Make basic checks on the CELT state to ensure we don't end
 112:../../opus/celt/celt_decoder.c ****    up writing all over memory. */
 113:../../opus/celt/celt_decoder.c **** void validate_celt_decoder(CELTDecoder *st)
 114:../../opus/celt/celt_decoder.c **** {
 115:../../opus/celt/celt_decoder.c **** #ifndef CUSTOM_MODES
 116:../../opus/celt/celt_decoder.c ****    celt_assert(st->mode == opus_custom_mode_create(48000, 960, NULL));
 117:../../opus/celt/celt_decoder.c ****    celt_assert(st->overlap == 120);
 118:../../opus/celt/celt_decoder.c ****    celt_assert(st->end <= 21);
 119:../../opus/celt/celt_decoder.c **** #else
 120:../../opus/celt/celt_decoder.c **** /* From Section 4.3 in the spec: "The normal CELT layer uses 21 of those bands,
 121:../../opus/celt/celt_decoder.c ****    though Opus Custom (see Section 6.2) may use a different number of bands"
 122:../../opus/celt/celt_decoder.c **** 
 123:../../opus/celt/celt_decoder.c ****    Check if it's within the maximum number of Bark frequency bands instead */
 124:../../opus/celt/celt_decoder.c ****    celt_assert(st->end <= 25);
 125:../../opus/celt/celt_decoder.c **** #endif
 126:../../opus/celt/celt_decoder.c ****    celt_assert(st->channels == 1 || st->channels == 2);
 127:../../opus/celt/celt_decoder.c ****    celt_assert(st->stream_channels == 1 || st->stream_channels == 2);
 128:../../opus/celt/celt_decoder.c ****    celt_assert(st->downsample > 0);
 129:../../opus/celt/celt_decoder.c ****    celt_assert(st->start == 0 || st->start == 17);
 130:../../opus/celt/celt_decoder.c ****    celt_assert(st->start < st->end);
 131:../../opus/celt/celt_decoder.c **** #ifdef OPUS_ARCHMASK
 132:../../opus/celt/celt_decoder.c ****    celt_assert(st->arch >= 0);
 133:../../opus/celt/celt_decoder.c ****    celt_assert(st->arch <= OPUS_ARCHMASK);
 134:../../opus/celt/celt_decoder.c **** #endif
 135:../../opus/celt/celt_decoder.c ****    celt_assert(st->last_pitch_index <= PLC_PITCH_LAG_MAX);
 136:../../opus/celt/celt_decoder.c ****    celt_assert(st->last_pitch_index >= PLC_PITCH_LAG_MIN || st->last_pitch_index == 0);
 137:../../opus/celt/celt_decoder.c ****    celt_assert(st->postfilter_period < MAX_PERIOD);
 138:../../opus/celt/celt_decoder.c ****    celt_assert(st->postfilter_period >= COMBFILTER_MINPERIOD || st->postfilter_period == 0);
 139:../../opus/celt/celt_decoder.c ****    celt_assert(st->postfilter_period_old < MAX_PERIOD);
 140:../../opus/celt/celt_decoder.c ****    celt_assert(st->postfilter_period_old >= COMBFILTER_MINPERIOD || st->postfilter_period_old == 0)
 141:../../opus/celt/celt_decoder.c ****    celt_assert(st->postfilter_tapset <= 2);
 142:../../opus/celt/celt_decoder.c ****    celt_assert(st->postfilter_tapset >= 0);
 143:../../opus/celt/celt_decoder.c ****    celt_assert(st->postfilter_tapset_old <= 2);
 144:../../opus/celt/celt_decoder.c ****    celt_assert(st->postfilter_tapset_old >= 0);
 145:../../opus/celt/celt_decoder.c **** }
