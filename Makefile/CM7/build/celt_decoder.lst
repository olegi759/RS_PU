 381:../../opus/celt/celt_decoder.c ****    SAVE_STACK;
 382:../../opus/celt/celt_decoder.c **** 
 383:../../opus/celt/celt_decoder.c ****    overlap = mode->overlap;
 384:../../opus/celt/celt_decoder.c ****    nbEBands = mode->nbEBands;
 385:../../opus/celt/celt_decoder.c ****    N = mode->shortMdctSize<<LM;
