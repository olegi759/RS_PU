 368:../../opus/celt/celt_decoder.c ****                     opus_val16 *oldBandE, int start, int effEnd, int C, int CC,
 369:../../opus/celt/celt_decoder.c ****                     int isTransient, int LM, int downsample,
 370:../../opus/celt/celt_decoder.c ****                     int silence, int arch)
 371:../../opus/celt/celt_decoder.c **** {
 372:../../opus/celt/celt_decoder.c ****    int c, i;
