 392:../../opus/celt/celt_decoder.c ****       NB = mode->shortMdctSize;
 393:../../opus/celt/celt_decoder.c ****       shift = mode->maxLM;
 394:../../opus/celt/celt_decoder.c ****    } else {
 395:../../opus/celt/celt_decoder.c ****       B = 1;
 396:../../opus/celt/celt_decoder.c ****       NB = mode->shortMdctSize<<LM;
 397:../../opus/celt/celt_decoder.c ****       shift = mode->maxLM-LM;
 398:../../opus/celt/celt_decoder.c ****    }
 399:../../opus/celt/celt_decoder.c **** 
 400:../../opus/celt/celt_decoder.c ****    if (CC==2&&C==1)
 401:../../opus/celt/celt_decoder.c ****    {
 402:../../opus/celt/celt_decoder.c ****       /* Copying a mono streams to two channels */
 403:../../opus/celt/celt_decoder.c ****       celt_sig *freq2;
 404:../../opus/celt/celt_decoder.c ****       denormalise_bands(mode, X, freq, oldBandE, start, effEnd, M,
 405:../../opus/celt/celt_decoder.c ****             downsample, silence);
 406:../../opus/celt/celt_decoder.c ****       /* Store a temporary copy in the output buffer because the IMDCT destroys its input. */
 407:../../opus/celt/celt_decoder.c ****       freq2 = out_syn[1]+overlap/2;
 408:../../opus/celt/celt_decoder.c ****       OPUS_COPY(freq2, freq, N);
