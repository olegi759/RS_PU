  43:../../opus/celt/mathops.h **** /* Multiplies two 16-bit fractional values. Bit-exactness of this macro is important */
  44:../../opus/celt/mathops.h **** #define FRAC_MUL16(a,b) ((16384+((opus_int32)(opus_int16)(a)*(opus_int16)(b)))>>15)
  45:../../opus/celt/mathops.h **** 
  46:../../opus/celt/mathops.h **** unsigned isqrt32(opus_uint32 _val);
  47:../../opus/celt/mathops.h **** 
  48:../../opus/celt/mathops.h **** /* CELT doesn't need it for fixed-point, by analysis.c does. */
  49:../../opus/celt/mathops.h **** #if !defined(FIXED_POINT) || defined(ANALYSIS_C)
  50:../../opus/celt/mathops.h **** #define cA 0.43157974f
  51:../../opus/celt/mathops.h **** #define cB 0.67848403f
  52:../../opus/celt/mathops.h **** #define cC 0.08595542f
  53:../../opus/celt/mathops.h **** #define cE ((float)PI/2)
  54:../../opus/celt/mathops.h **** static OPUS_INLINE float fast_atan2f(float y, float x) {
  55:../../opus/celt/mathops.h ****    float x2, y2;
  56:../../opus/celt/mathops.h ****    x2 = x*x;
  57:../../opus/celt/mathops.h ****    y2 = y*y;
  58:../../opus/celt/mathops.h ****    /* For very small values, we don't care about the answer, so
  59:../../opus/celt/mathops.h ****       we can just return 0. */
  60:../../opus/celt/mathops.h ****    if (x2 + y2 < 1e-18f)
  61:../../opus/celt/mathops.h ****    {
  62:../../opus/celt/mathops.h ****       return 0;
  63:../../opus/celt/mathops.h ****    }
  64:../../opus/celt/mathops.h ****    if(x2<y2){
  65:../../opus/celt/mathops.h ****       float den = (y2 + cB*x2) * (y2 + cC*x2);
  66:../../opus/celt/mathops.h ****       return -x*y*(y2 + cA*x2) / den + (y<0 ? -cE : cE);
  67:../../opus/celt/mathops.h ****    }else{
  68:../../opus/celt/mathops.h ****       float den = (x2 + cB*y2) * (x2 + cC*y2);
  69:../../opus/celt/mathops.h ****       return  x*y*(x2 + cA*y2) / den + (y<0 ? -cE : cE) - (x*y<0 ? -cE : cE);
  70:../../opus/celt/mathops.h ****    }
  71:../../opus/celt/mathops.h **** }
  72:../../opus/celt/mathops.h **** #undef cA
  73:../../opus/celt/mathops.h **** #undef cB
  74:../../opus/celt/mathops.h **** #undef cC
  75:../../opus/celt/mathops.h **** #undef cE
  76:../../opus/celt/mathops.h **** #endif
  77:../../opus/celt/mathops.h **** 
