 148:../../opus/celt/celt_decoder.c **** int celt_decoder_get_size(int channels)
 149:../../opus/celt/celt_decoder.c **** {
 150:../../opus/celt/celt_decoder.c ****    const CELTMode *mode = opus_custom_mode_create(48000, 960, NULL);
 151:../../opus/celt/celt_decoder.c ****    return opus_custom_decoder_get_size(mode, channels);
 152:../../opus/celt/celt_decoder.c **** }
 153:../../opus/celt/celt_decoder.c **** 
 154:../../opus/celt/celt_decoder.c **** OPUS_CUSTOM_NOSTATIC int opus_custom_decoder_get_size(const CELTMode *mode, int channels)
 155:../../opus/celt/celt_decoder.c **** {
 156:../../opus/celt/celt_decoder.c ****    int size = sizeof(struct CELTDecoder)
 157:../../opus/celt/celt_decoder.c ****             + (channels*(DECODE_BUFFER_SIZE+mode->overlap)-1)*sizeof(celt_sig)
 158:../../opus/celt/celt_decoder.c ****             + channels*LPC_ORDER*sizeof(opus_val16)
 159:../../opus/celt/celt_decoder.c ****             + 4*2*mode->nbEBands*sizeof(opus_val16);
 160:../../opus/celt/celt_decoder.c ****    return size;
 161:../../opus/celt/celt_decoder.c **** }
