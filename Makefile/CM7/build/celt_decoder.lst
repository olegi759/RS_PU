 387:../../opus/celt/celt_decoder.c ****    M = 1<<LM;
 388:../../opus/celt/celt_decoder.c **** 
 389:../../opus/celt/celt_decoder.c ****    if (isTransient)
 390:../../opus/celt/celt_decoder.c ****    {
