  61:../../opus/silk/VAD.c ****         psSilk_VAD->NL[ b ]     = silk_MUL( 100, psSilk_VAD->NoiseLevelBias[ b ] );
  62:../../opus/silk/VAD.c ****         psSilk_VAD->inv_NL[ b ] = silk_DIV32( silk_int32_MAX, psSilk_VAD->NL[ b ] );
  63:../../opus/silk/VAD.c ****     }
  64:../../opus/silk/VAD.c ****     psSilk_VAD->counter = 15;
  65:../../opus/silk/VAD.c **** 
