 209:../../opus/silk/VAD.c ****             }
 210:../../opus/silk/VAD.c **** 
 211:../../opus/silk/VAD.c ****             /* Convert to log domain */
 212:../../opus/silk/VAD.c ****             SNR_Q7 = silk_lin2log( NrgToNoiseRatio_Q8[ b ] ) - 8 * 128;
 213:../../opus/silk/VAD.c **** 
 214:../../opus/silk/VAD.c ****             /* Sum-of-squares */
