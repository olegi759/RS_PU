 168:../../opus/silk/VAD.c ****                 /* The energy will be less than dec_subframe_length * ( silk_int16_MIN / 8 ) ^ 2.  
 169:../../opus/silk/VAD.c ****                 /* Therefore we can accumulate with no risk of overflow (unless dec_subframe_length
 170:../../opus/silk/VAD.c ****                 x_tmp = silk_RSHIFT(
