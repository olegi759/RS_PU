 157:../../opus/silk/VAD.c **** 
 158:../../opus/silk/VAD.c ****         /* Split length into subframe lengths */
 159:../../opus/silk/VAD.c ****         dec_subframe_length = silk_RSHIFT( decimated_framelength, VAD_INTERNAL_SUBFRAMES_LOG2 );
 160:../../opus/silk/VAD.c ****         dec_subframe_offset = 0;
 161:../../opus/silk/VAD.c **** 
 162:../../opus/silk/VAD.c ****         /* Compute energy per sub-frame */
 163:../../opus/silk/VAD.c ****         /* initialize with summed energy of last subframe */
 164:../../opus/silk/VAD.c ****         Xnrg[ b ] = psSilk_VAD->XnrgSubfr[ b ];
