 420:../../opus/silk/SigProc_FIX.h **** #define silk_memcpy(dest, src, size)        memcpy((dest), (src), (size))
 421:../../opus/silk/SigProc_FIX.h **** #define silk_memset(dest, src, size)        memset((dest), (src), (size))
 422:../../opus/silk/SigProc_FIX.h **** #define silk_memmove(dest, src, size)       memmove((dest), (src), (size))
