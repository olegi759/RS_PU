 267:../../opus/silk/VAD.c ****     /* Copy the resulting speech activity in Q8 */
 268:../../opus/silk/VAD.c ****     psEncC->speech_activity_Q8 = silk_min_int( silk_RSHIFT( SA_Q15, 7 ), silk_uint8_MAX );
 269:../../opus/silk/VAD.c **** 
 270:../../opus/silk/VAD.c ****     /***********************************/
 271:../../opus/silk/VAD.c ****     /* Energy Level and SNR estimation */
 272:../../opus/silk/VAD.c ****     /***********************************/
 273:../../opus/silk/VAD.c ****     /* Smoothing coefficient */
 274:../../opus/silk/VAD.c ****     smooth_coef_Q16 = silk_SMULWB( VAD_SNR_SMOOTH_COEF_Q18, silk_SMULWB( (opus_int32)SA_Q15, SA_Q15
 275:../../opus/silk/VAD.c **** 
 276:../../opus/silk/VAD.c ****     if( psEncC->frame_length == 10 * psEncC->fs_kHz ) {
 277:../../opus/silk/VAD.c ****         smooth_coef_Q16 >>= 1;
 278:../../opus/silk/VAD.c ****     }
 279:../../opus/silk/VAD.c **** 
 280:../../opus/silk/VAD.c ****     for( b = 0; b < VAD_N_BANDS; b++ ) {
 281:../../opus/silk/VAD.c ****         /* compute smoothed energy-to-noise ratio per band */
 282:../../opus/silk/VAD.c ****         psSilk_VAD->NrgRatioSmth_Q8[ b ] = silk_SMLAWB( psSilk_VAD->NrgRatioSmth_Q8[ b ],
 283:../../opus/silk/VAD.c ****             NrgToNoiseRatio_Q8[ b ] - psSilk_VAD->NrgRatioSmth_Q8[ b ], smooth_coef_Q16 );
 284:../../opus/silk/VAD.c **** 
 285:../../opus/silk/VAD.c ****         /* signal to noise ratio in dB per band */
 286:../../opus/silk/VAD.c ****         SNR_Q7 = 3 * ( silk_lin2log( psSilk_VAD->NrgRatioSmth_Q8[b] ) - 8 * 128 );
 287:../../opus/silk/VAD.c ****         /* quality = sigmoid( 0.25 * ( SNR_dB - 16 ) ); */
 288:../../opus/silk/VAD.c ****         psEncC->input_quality_bands_Q15[ b ] = silk_sigm_Q15( silk_RSHIFT( SNR_Q7 - 16 * 128, 4 ) )
 289:../../opus/silk/VAD.c ****     }
 290:../../opus/silk/VAD.c **** 
 291:../../opus/silk/VAD.c ****     RESTORE_STACK;
 292:../../opus/silk/VAD.c ****     return( ret );
 293:../../opus/silk/VAD.c **** }
