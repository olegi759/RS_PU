  43:../../opus/celt/mathops.h **** /* Multiplies two 16-bit fractional values. Bit-exactness of this macro is important */
  44:../../opus/celt/mathops.h **** #define FRAC_MUL16(a,b) ((16384+((opus_int32)(opus_int16)(a)*(opus_int16)(b)))>>15)
  45:../../opus/celt/mathops.h **** 
  46:../../opus/celt/mathops.h **** unsigned isqrt32(opus_uint32 _val);
