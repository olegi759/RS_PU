  43:../../opus/celt/pitch.c **** static void find_best_pitch(opus_val32 *xcorr, opus_val16 *y, int len,
  44:../../opus/celt/pitch.c ****                             int max_pitch, int *best_pitch
  45:../../opus/celt/pitch.c **** #ifdef FIXED_POINT
  46:../../opus/celt/pitch.c ****                             , int yshift, opus_val32 maxcorr
  47:../../opus/celt/pitch.c **** #endif
  48:../../opus/celt/pitch.c ****                             )
  49:../../opus/celt/pitch.c **** {
  50:../../opus/celt/pitch.c ****    int i, j;
  51:../../opus/celt/pitch.c ****    opus_val32 Syy=1;
  52:../../opus/celt/pitch.c ****    opus_val16 best_num[2];
  53:../../opus/celt/pitch.c ****    opus_val32 best_den[2];
  54:../../opus/celt/pitch.c **** #ifdef FIXED_POINT
  55:../../opus/celt/pitch.c ****    int xshift;
  56:../../opus/celt/pitch.c **** 
  57:../../opus/celt/pitch.c ****    xshift = celt_ilog2(maxcorr)-14;
  58:../../opus/celt/pitch.c **** #endif
  59:../../opus/celt/pitch.c **** 
  60:../../opus/celt/pitch.c ****    best_num[0] = -1;
  61:../../opus/celt/pitch.c ****    best_num[1] = -1;
  62:../../opus/celt/pitch.c ****    best_den[0] = 0;
  63:../../opus/celt/pitch.c ****    best_den[1] = 0;
  64:../../opus/celt/pitch.c ****    best_pitch[0] = 0;
  65:../../opus/celt/pitch.c ****    best_pitch[1] = 1;
  66:../../opus/celt/pitch.c ****    for (j=0;j<len;j++)
  67:../../opus/celt/pitch.c ****       Syy = ADD32(Syy, SHR32(MULT16_16(y[j],y[j]), yshift));
  68:../../opus/celt/pitch.c ****    for (i=0;i<max_pitch;i++)
  69:../../opus/celt/pitch.c ****    {
  70:../../opus/celt/pitch.c ****       if (xcorr[i]>0)
  71:../../opus/celt/pitch.c ****       {
  72:../../opus/celt/pitch.c ****          opus_val16 num;
  73:../../opus/celt/pitch.c ****          opus_val32 xcorr16;
  74:../../opus/celt/pitch.c ****          xcorr16 = EXTRACT16(VSHR32(xcorr[i], xshift));
  75:../../opus/celt/pitch.c **** #ifndef FIXED_POINT
  76:../../opus/celt/pitch.c ****          /* Considering the range of xcorr16, this should avoid both underflows
  77:../../opus/celt/pitch.c ****             and overflows (inf) when squaring xcorr16 */
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccDzhtLX.s 			page 13


  78:../../opus/celt/pitch.c ****          xcorr16 *= 1e-12f;
  79:../../opus/celt/pitch.c **** #endif
  80:../../opus/celt/pitch.c ****          num = MULT16_16_Q15(xcorr16,xcorr16);
  81:../../opus/celt/pitch.c ****          if (MULT16_32_Q15(num,best_den[1]) > MULT16_32_Q15(best_num[1],Syy))
  82:../../opus/celt/pitch.c ****          {
  83:../../opus/celt/pitch.c ****             if (MULT16_32_Q15(num,best_den[0]) > MULT16_32_Q15(best_num[0],Syy))
  84:../../opus/celt/pitch.c ****             {
  85:../../opus/celt/pitch.c ****                best_num[1] = best_num[0];
  86:../../opus/celt/pitch.c ****                best_den[1] = best_den[0];
  87:../../opus/celt/pitch.c ****                best_pitch[1] = best_pitch[0];
  88:../../opus/celt/pitch.c ****                best_num[0] = num;
  89:../../opus/celt/pitch.c ****                best_den[0] = Syy;
  90:../../opus/celt/pitch.c ****                best_pitch[0] = i;
  91:../../opus/celt/pitch.c ****             } else {
  92:../../opus/celt/pitch.c ****                best_num[1] = num;
  93:../../opus/celt/pitch.c ****                best_den[1] = Syy;
  94:../../opus/celt/pitch.c ****                best_pitch[1] = i;
  95:../../opus/celt/pitch.c ****             }
  96:../../opus/celt/pitch.c ****          }
  97:../../opus/celt/pitch.c ****       }
  98:../../opus/celt/pitch.c ****       Syy += SHR32(MULT16_16(y[i+len],y[i+len]),yshift) - SHR32(MULT16_16(y[i],y[i]),yshift);
  99:../../opus/celt/pitch.c ****       Syy = MAX32(1, Syy);
 100:../../opus/celt/pitch.c ****    }
 101:../../opus/celt/pitch.c **** }
