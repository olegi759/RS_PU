  60:../../opus/celt/entcode.h **** /*The entropy encoder/decoder context.
  61:../../opus/celt/entcode.h ****   We use the same structure for both, so that common functions like ec_tell()
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccDzhtLX.s 			page 75


  62:../../opus/celt/entcode.h ****    can be used on either one.*/
  63:../../opus/celt/entcode.h **** struct ec_ctx{
  64:../../opus/celt/entcode.h ****    /*Buffered input/output.*/
  65:../../opus/celt/entcode.h ****    unsigned char *buf;
  66:../../opus/celt/entcode.h ****    /*The size of the buffer.*/
  67:../../opus/celt/entcode.h ****    opus_uint32    storage;
  68:../../opus/celt/entcode.h ****    /*The offset at which the last byte containing raw bits was read/written.*/
  69:../../opus/celt/entcode.h ****    opus_uint32    end_offs;
  70:../../opus/celt/entcode.h ****    /*Bits that will be read from/written at the end.*/
  71:../../opus/celt/entcode.h ****    ec_window      end_window;
  72:../../opus/celt/entcode.h ****    /*Number of valid bits in end_window.*/
  73:../../opus/celt/entcode.h ****    int            nend_bits;
  74:../../opus/celt/entcode.h ****    /*The total number of whole bits read/written.
  75:../../opus/celt/entcode.h ****      This does not include partial bits currently in the range coder.*/
  76:../../opus/celt/entcode.h ****    int            nbits_total;
  77:../../opus/celt/entcode.h ****    /*The offset at which the next range coder byte will be read/written.*/
  78:../../opus/celt/entcode.h ****    opus_uint32    offs;
  79:../../opus/celt/entcode.h ****    /*The number of values in the current range.*/
  80:../../opus/celt/entcode.h ****    opus_uint32    rng;
  81:../../opus/celt/entcode.h ****    /*In the decoder: the difference between the top of the current range and
  82:../../opus/celt/entcode.h ****       the input value, minus one.
  83:../../opus/celt/entcode.h ****      In the encoder: the low end of the current range.*/
  84:../../opus/celt/entcode.h ****    opus_uint32    val;
  85:../../opus/celt/entcode.h ****    /*In the decoder: the saved normalization factor from ec_decode().
  86:../../opus/celt/entcode.h ****      In the encoder: the number of oustanding carry propagating symbols.*/
  87:../../opus/celt/entcode.h ****    opus_uint32    ext;
  88:../../opus/celt/entcode.h ****    /*A buffered input/output symbol, awaiting carry propagation.*/
  89:../../opus/celt/entcode.h ****    int            rem;
  90:../../opus/celt/entcode.h ****    /*Nonzero if an error occurred.*/
  91:../../opus/celt/entcode.h ****    int            error;
  92:../../opus/celt/entcode.h **** };
