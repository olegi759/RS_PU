 126:../../opus/celt/mathops.h **** /* Note: This assumes radix-2 floating point with the exponent at bits 23..30 and an offset of 127
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccDzhtLX.s 			page 20


 127:../../opus/celt/mathops.h ****          denorm, +/- inf and NaN are *not* handled */
 128:../../opus/celt/mathops.h **** 
 129:../../opus/celt/mathops.h **** /** Base-2 log approximation (log2(x)). */
 130:../../opus/celt/mathops.h **** static OPUS_INLINE float celt_log2(float x)
 131:../../opus/celt/mathops.h **** {
 132:../../opus/celt/mathops.h ****    int integer;
 133:../../opus/celt/mathops.h ****    float frac;
 134:../../opus/celt/mathops.h ****    union {
 135:../../opus/celt/mathops.h ****       float f;
 136:../../opus/celt/mathops.h ****       opus_uint32 i;
 137:../../opus/celt/mathops.h ****    } in;
 138:../../opus/celt/mathops.h ****    in.f = x;
 139:../../opus/celt/mathops.h ****    integer = (in.i>>23)-127;
 140:../../opus/celt/mathops.h ****    in.i -= (opus_uint32)integer<<23;
 141:../../opus/celt/mathops.h ****    frac = in.f - 1.5f;
 142:../../opus/celt/mathops.h ****    frac = -0.41445418f + frac*(0.95909232f
 143:../../opus/celt/mathops.h ****           + frac*(-0.33951290f + frac*0.16541097f));
 144:../../opus/celt/mathops.h ****    return 1+integer+frac;
 145:../../opus/celt/mathops.h **** }
 146:../../opus/celt/mathops.h **** 
 147:../../opus/celt/mathops.h **** /** Base-2 exponential approximation (2^x). */
 148:../../opus/celt/mathops.h **** static OPUS_INLINE float celt_exp2(float x)
 149:../../opus/celt/mathops.h **** {
 150:../../opus/celt/mathops.h ****    int integer;
 151:../../opus/celt/mathops.h ****    float frac;
 152:../../opus/celt/mathops.h ****    union {
 153:../../opus/celt/mathops.h ****       float f;
 154:../../opus/celt/mathops.h ****       opus_uint32 i;
 155:../../opus/celt/mathops.h ****    } res;
 156:../../opus/celt/mathops.h ****    integer = (int)floor(x);
 157:../../opus/celt/mathops.h ****    if (integer < -50)
 158:../../opus/celt/mathops.h ****       return 0;
 159:../../opus/celt/mathops.h ****    frac = x-integer;
 160:../../opus/celt/mathops.h ****    /* K0 = 1, K1 = log(2), K2 = 3-4*log(2), K3 = 3*log(2) - 2 */
 161:../../opus/celt/mathops.h ****    res.f = 0.99992522f + frac * (0.69583354f
 162:../../opus/celt/mathops.h ****            + frac * (0.22606716f + 0.078024523f*frac));
 163:../../opus/celt/mathops.h ****    res.i = (res.i + ((opus_uint32)integer<<23)) & 0x7fffffff;
 164:../../opus/celt/mathops.h ****    return res.f;
 165:../../opus/celt/mathops.h **** }
 166:../../opus/celt/mathops.h **** 
 167:../../opus/celt/mathops.h **** #else
 168:../../opus/celt/mathops.h **** #define celt_log2(x) ((float)(1.442695040888963387*log(x)))
 169:../../opus/celt/mathops.h **** #define celt_exp2(x) ((float)exp(0.6931471805599453094*(x)))
