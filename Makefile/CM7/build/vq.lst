  71:../../opus/celt/vq.c **** 
  72:../../opus/celt/vq.c **** void exp_rotation(celt_norm *X, int len, int dir, int stride, int K, int spread)
  73:../../opus/celt/vq.c **** {
  74:../../opus/celt/vq.c ****    static const int SPREAD_FACTOR[3]={15,10,5};
  75:../../opus/celt/vq.c ****    int i;
  76:../../opus/celt/vq.c ****    opus_val16 c, s;
  77:../../opus/celt/vq.c ****    opus_val16 gain, theta;
  78:../../opus/celt/vq.c ****    int stride2=0;
  79:../../opus/celt/vq.c ****    int factor;
  80:../../opus/celt/vq.c **** 
  81:../../opus/celt/vq.c ****    if (2*K>=len || spread==SPREAD_NONE)
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccnoGg1f.s 			page 11


  82:../../opus/celt/vq.c ****       return;
  83:../../opus/celt/vq.c ****    factor = SPREAD_FACTOR[spread-1];
  84:../../opus/celt/vq.c **** 
  85:../../opus/celt/vq.c ****    gain = celt_div((opus_val32)MULT16_16(Q15_ONE,len),(opus_val32)(len+factor*K));
  86:../../opus/celt/vq.c ****    theta = HALF16(MULT16_16_Q15(gain,gain));
  87:../../opus/celt/vq.c **** 
  88:../../opus/celt/vq.c ****    c = celt_cos_norm(EXTEND32(theta));
  89:../../opus/celt/vq.c ****    s = celt_cos_norm(EXTEND32(SUB16(Q15ONE,theta))); /*  sin(theta) */
  90:../../opus/celt/vq.c **** 
  91:../../opus/celt/vq.c ****    if (len>=8*stride)
  92:../../opus/celt/vq.c ****    {
  93:../../opus/celt/vq.c ****       stride2 = 1;
  94:../../opus/celt/vq.c ****       /* This is just a simple (equivalent) way of computing sqrt(len/stride) with rounding.
  95:../../opus/celt/vq.c ****          It's basically incrementing long as (stride2+0.5)^2 < len/stride. */
  96:../../opus/celt/vq.c ****       while ((stride2*stride2+stride2)*stride + (stride>>2) < len)
  97:../../opus/celt/vq.c ****          stride2++;
  98:../../opus/celt/vq.c ****    }
  99:../../opus/celt/vq.c ****    /*NOTE: As a minor optimization, we could be passing around log2(B), not B, for both this and fo
 100:../../opus/celt/vq.c ****       extract_collapse_mask().*/
 101:../../opus/celt/vq.c ****    len = celt_udiv(len, stride);
 102:../../opus/celt/vq.c ****    for (i=0;i<stride;i++)
 103:../../opus/celt/vq.c ****    {
 104:../../opus/celt/vq.c ****       if (dir < 0)
 105:../../opus/celt/vq.c ****       {
 106:../../opus/celt/vq.c ****          if (stride2)
 107:../../opus/celt/vq.c ****             exp_rotation1(X+i*len, len, stride2, s, c);
 108:../../opus/celt/vq.c ****          exp_rotation1(X+i*len, len, 1, c, s);
 109:../../opus/celt/vq.c ****       } else {
 110:../../opus/celt/vq.c ****          exp_rotation1(X+i*len, len, 1, c, -s);
 111:../../opus/celt/vq.c ****          if (stride2)
 112:../../opus/celt/vq.c ****             exp_rotation1(X+i*len, len, stride2, s, -c);
 113:../../opus/celt/vq.c ****       }
 114:../../opus/celt/vq.c ****    }
 115:../../opus/celt/vq.c **** }
 116:../../opus/celt/vq.c **** 
 117:../../opus/celt/vq.c **** /** Takes the pitch vector and the decoded residual vector, computes the gain
 118:../../opus/celt/vq.c ****     that will give ||p+g*y||=1 and mixes the residual with the pitch. */
 119:../../opus/celt/vq.c **** static void normalise_residual(int * OPUS_RESTRICT iy, celt_norm * OPUS_RESTRICT X,
 120:../../opus/celt/vq.c ****       int N, opus_val32 Ryy, opus_val16 gain)
 121:../../opus/celt/vq.c **** {
 122:../../opus/celt/vq.c ****    int i;
 123:../../opus/celt/vq.c **** #ifdef FIXED_POINT
 124:../../opus/celt/vq.c ****    int k;
 125:../../opus/celt/vq.c **** #endif
 126:../../opus/celt/vq.c ****    opus_val32 t;
 127:../../opus/celt/vq.c ****    opus_val16 g;
 128:../../opus/celt/vq.c **** 
 129:../../opus/celt/vq.c **** #ifdef FIXED_POINT
 130:../../opus/celt/vq.c ****    k = celt_ilog2(Ryy)>>1;
 131:../../opus/celt/vq.c **** #endif
 132:../../opus/celt/vq.c ****    t = VSHR32(Ryy, 2*(k-7));
 133:../../opus/celt/vq.c ****    g = MULT16_16_P15(celt_rsqrt_norm(t),gain);
 134:../../opus/celt/vq.c **** 
 135:../../opus/celt/vq.c ****    i=0;
 136:../../opus/celt/vq.c ****    do
 137:../../opus/celt/vq.c ****       X[i] = EXTRACT16(PSHR32(MULT16_16(g, iy[i]), k+1));
 138:../../opus/celt/vq.c ****    while (++i < N);
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccnoGg1f.s 			page 12


 139:../../opus/celt/vq.c **** }
