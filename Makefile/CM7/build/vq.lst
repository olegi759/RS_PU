  63:../../opus/celt/pitch.h **** /* OPT: This is the kernel you really want to optimize. It gets used a lot
  64:../../opus/celt/pitch.h ****    by the prefilter and by the PLC. */
  65:../../opus/celt/pitch.h **** static OPUS_INLINE void xcorr_kernel_c(const opus_val16 * x, const opus_val16 * y, opus_val32 sum[4
  66:../../opus/celt/pitch.h **** {
  67:../../opus/celt/pitch.h ****    int j;
  68:../../opus/celt/pitch.h ****    opus_val16 y_0, y_1, y_2, y_3;
  69:../../opus/celt/pitch.h ****    celt_assert(len>=3);
  70:../../opus/celt/pitch.h ****    y_3=0; /* gcc doesn't realize that y_3 can't be used uninitialized */
  71:../../opus/celt/pitch.h ****    y_0=*y++;
  72:../../opus/celt/pitch.h ****    y_1=*y++;
  73:../../opus/celt/pitch.h ****    y_2=*y++;
  74:../../opus/celt/pitch.h ****    for (j=0;j<len-3;j+=4)
  75:../../opus/celt/pitch.h ****    {
  76:../../opus/celt/pitch.h ****       opus_val16 tmp;
  77:../../opus/celt/pitch.h ****       tmp = *x++;
  78:../../opus/celt/pitch.h ****       y_3=*y++;
  79:../../opus/celt/pitch.h ****       sum[0] = MAC16_16(sum[0],tmp,y_0);
  80:../../opus/celt/pitch.h ****       sum[1] = MAC16_16(sum[1],tmp,y_1);
  81:../../opus/celt/pitch.h ****       sum[2] = MAC16_16(sum[2],tmp,y_2);
  82:../../opus/celt/pitch.h ****       sum[3] = MAC16_16(sum[3],tmp,y_3);
  83:../../opus/celt/pitch.h ****       tmp=*x++;
  84:../../opus/celt/pitch.h ****       y_0=*y++;
  85:../../opus/celt/pitch.h ****       sum[0] = MAC16_16(sum[0],tmp,y_1);
  86:../../opus/celt/pitch.h ****       sum[1] = MAC16_16(sum[1],tmp,y_2);
  87:../../opus/celt/pitch.h ****       sum[2] = MAC16_16(sum[2],tmp,y_3);
  88:../../opus/celt/pitch.h ****       sum[3] = MAC16_16(sum[3],tmp,y_0);
  89:../../opus/celt/pitch.h ****       tmp=*x++;
