 233:../../opus/celt/mathops.h **** /** Base-2 exponential approximation (2^x). (Q10 input, Q16 output) */
 234:../../opus/celt/mathops.h **** static OPUS_INLINE opus_val32 celt_exp2(opus_val16 x)
 235:../../opus/celt/mathops.h **** {
 236:../../opus/celt/mathops.h ****    int integer;
 237:../../opus/celt/mathops.h ****    opus_val16 frac;
 238:../../opus/celt/mathops.h ****    integer = SHR16(x,10);
 239:../../opus/celt/mathops.h ****    if (integer>14)
 240:../../opus/celt/mathops.h ****       return 0x7f000000;
 241:../../opus/celt/mathops.h ****    else if (integer < -15)
 242:../../opus/celt/mathops.h ****       return 0;
 243:../../opus/celt/mathops.h ****    frac = celt_exp2_frac(x-SHL16(integer,10));
 244:../../opus/celt/mathops.h ****    return VSHR32(EXTEND32(frac), -integer-2);
 245:../../opus/celt/mathops.h **** }
