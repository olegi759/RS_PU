  79:../../opus/celt/mathops.h **** #ifndef OVERRIDE_CELT_MAXABS16
  80:../../opus/celt/mathops.h **** static OPUS_INLINE opus_val32 celt_maxabs16(const opus_val16 *x, int len)
  81:../../opus/celt/mathops.h **** {
  82:../../opus/celt/mathops.h ****    int i;
  83:../../opus/celt/mathops.h ****    opus_val16 maxval = 0;
  84:../../opus/celt/mathops.h ****    opus_val16 minval = 0;
  85:../../opus/celt/mathops.h ****    for (i=0;i<len;i++)
  86:../../opus/celt/mathops.h ****    {
  87:../../opus/celt/mathops.h ****       maxval = MAX16(maxval, x[i]);
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccnoGg1f.s 			page 3


  88:../../opus/celt/mathops.h ****       minval = MIN16(minval, x[i]);
  89:../../opus/celt/mathops.h ****    }
  90:../../opus/celt/mathops.h ****    return MAX32(EXTEND32(maxval),-EXTEND32(minval));
  91:../../opus/celt/mathops.h **** }
  92:../../opus/celt/mathops.h **** #endif
  93:../../opus/celt/mathops.h **** 
  94:../../opus/celt/mathops.h **** #ifndef OVERRIDE_CELT_MAXABS32
  95:../../opus/celt/mathops.h **** #ifdef FIXED_POINT
  96:../../opus/celt/mathops.h **** static OPUS_INLINE opus_val32 celt_maxabs32(const opus_val32 *x, int len)
  97:../../opus/celt/mathops.h **** {
  98:../../opus/celt/mathops.h ****    int i;
