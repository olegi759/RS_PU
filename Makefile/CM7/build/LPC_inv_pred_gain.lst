  39:../../opus/silk/Inlines.h **** 
  40:../../opus/silk/Inlines.h **** /* count leading zeros of opus_int64 */
  41:../../opus/silk/Inlines.h **** static OPUS_INLINE opus_int32 silk_CLZ64( opus_int64 in )
  42:../../opus/silk/Inlines.h **** {
  43:../../opus/silk/Inlines.h ****     opus_int32 in_upper;
  44:../../opus/silk/Inlines.h **** 
  45:../../opus/silk/Inlines.h ****     in_upper = (opus_int32)silk_RSHIFT64(in, 32);
  46:../../opus/silk/Inlines.h ****     if (in_upper == 0) {
  47:../../opus/silk/Inlines.h ****         /* Search in the lower 32 bits */
  48:../../opus/silk/Inlines.h ****         return 32 + silk_CLZ32( (opus_int32) in );
  49:../../opus/silk/Inlines.h ****     } else {
  50:../../opus/silk/Inlines.h ****         /* Search in the upper 32 bits */
  51:../../opus/silk/Inlines.h ****         return silk_CLZ32( in_upper );
  52:../../opus/silk/Inlines.h ****     }
  53:../../opus/silk/Inlines.h **** }
  54:../../opus/silk/Inlines.h **** 
  55:../../opus/silk/Inlines.h **** /* get number of leading zeros and fractional part (the bits right after the leading one */
  56:../../opus/silk/Inlines.h **** static OPUS_INLINE void silk_CLZ_FRAC(
  57:../../opus/silk/Inlines.h ****     opus_int32 in,            /* I  input                               */
  58:../../opus/silk/Inlines.h ****     opus_int32 *lz,           /* O  number of leading zeros             */
  59:../../opus/silk/Inlines.h ****     opus_int32 *frac_Q7       /* O  the 7 bits right after the leading one */
  60:../../opus/silk/Inlines.h **** )
  61:../../opus/silk/Inlines.h **** {
  62:../../opus/silk/Inlines.h ****     opus_int32 lzeros = silk_CLZ32(in);
  63:../../opus/silk/Inlines.h **** 
  64:../../opus/silk/Inlines.h ****     * lz = lzeros;
  65:../../opus/silk/Inlines.h ****     * frac_Q7 = silk_ROR32(in, 24 - lzeros) & 0x7f;
  66:../../opus/silk/Inlines.h **** }
  67:../../opus/silk/Inlines.h **** 
  68:../../opus/silk/Inlines.h **** /* Approximation of square root                                          */
  69:../../opus/silk/Inlines.h **** /* Accuracy: < +/- 10%  for output values > 15                           */
  70:../../opus/silk/Inlines.h **** /*           < +/- 2.5% for output values > 120                          */
  71:../../opus/silk/Inlines.h **** static OPUS_INLINE opus_int32 silk_SQRT_APPROX( opus_int32 x )
  72:../../opus/silk/Inlines.h **** {
  73:../../opus/silk/Inlines.h ****     opus_int32 y, lz, frac_Q7;
  74:../../opus/silk/Inlines.h **** 
  75:../../opus/silk/Inlines.h ****     if( x <= 0 ) {
  76:../../opus/silk/Inlines.h ****         return 0;
  77:../../opus/silk/Inlines.h ****     }
  78:../../opus/silk/Inlines.h **** 
  79:../../opus/silk/Inlines.h ****     silk_CLZ_FRAC(x, &lz, &frac_Q7);
  80:../../opus/silk/Inlines.h **** 
  81:../../opus/silk/Inlines.h ****     if( lz & 1 ) {
  82:../../opus/silk/Inlines.h ****         y = 32768;
  83:../../opus/silk/Inlines.h ****     } else {
  84:../../opus/silk/Inlines.h ****         y = 46214;        /* 46214 = sqrt(2) * 32768 */
  85:../../opus/silk/Inlines.h ****     }
  86:../../opus/silk/Inlines.h **** 
  87:../../opus/silk/Inlines.h ****     /* get scaling right */
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccBkS4jp.s 			page 3


  88:../../opus/silk/Inlines.h ****     y >>= silk_RSHIFT(lz, 1);
  89:../../opus/silk/Inlines.h **** 
  90:../../opus/silk/Inlines.h ****     /* increment using fractional part of input */
  91:../../opus/silk/Inlines.h ****     y = silk_SMLAWB(y, y, silk_SMULBB(213, frac_Q7));
  92:../../opus/silk/Inlines.h **** 
  93:../../opus/silk/Inlines.h ****     return y;
  94:../../opus/silk/Inlines.h **** }
  95:../../opus/silk/Inlines.h **** 
  96:../../opus/silk/Inlines.h **** /* Divide two int32 values and return result as int32 in a given Q-domain */
  97:../../opus/silk/Inlines.h **** static OPUS_INLINE opus_int32 silk_DIV32_varQ(   /* O    returns a good approximation of "(a32 << Q
  98:../../opus/silk/Inlines.h ****     const opus_int32     a32,               /* I    numerator (Q0)                  */
  99:../../opus/silk/Inlines.h ****     const opus_int32     b32,               /* I    denominator (Q0)                */
 100:../../opus/silk/Inlines.h ****     const opus_int       Qres               /* I    Q-domain of result (>= 0)       */
 101:../../opus/silk/Inlines.h **** )
 102:../../opus/silk/Inlines.h **** {
 103:../../opus/silk/Inlines.h ****     opus_int   a_headrm, b_headrm, lshift;
 104:../../opus/silk/Inlines.h ****     opus_int32 b32_inv, a32_nrm, b32_nrm, result;
 105:../../opus/silk/Inlines.h **** 
 106:../../opus/silk/Inlines.h ****     silk_assert( b32 != 0 );
 107:../../opus/silk/Inlines.h ****     silk_assert( Qres >= 0 );
 108:../../opus/silk/Inlines.h **** 
 109:../../opus/silk/Inlines.h ****     /* Compute number of bits head room and normalize inputs */
 110:../../opus/silk/Inlines.h ****     a_headrm = silk_CLZ32( silk_abs(a32) ) - 1;
 111:../../opus/silk/Inlines.h ****     a32_nrm = silk_LSHIFT(a32, a_headrm);                                       /* Q: a_headrm     
 112:../../opus/silk/Inlines.h ****     b_headrm = silk_CLZ32( silk_abs(b32) ) - 1;
 113:../../opus/silk/Inlines.h ****     b32_nrm = silk_LSHIFT(b32, b_headrm);                                       /* Q: b_headrm     
 114:../../opus/silk/Inlines.h **** 
 115:../../opus/silk/Inlines.h ****     /* Inverse of b32, with 14 bits of precision */
 116:../../opus/silk/Inlines.h ****     b32_inv = silk_DIV32_16( silk_int32_MAX >> 2, silk_RSHIFT(b32_nrm, 16) );   /* Q: 29 + 16 - b_h
 117:../../opus/silk/Inlines.h **** 
 118:../../opus/silk/Inlines.h ****     /* First approximation */
 119:../../opus/silk/Inlines.h ****     result = silk_SMULWB(a32_nrm, b32_inv);                                     /* Q: 29 + a_headrm
 120:../../opus/silk/Inlines.h **** 
 121:../../opus/silk/Inlines.h ****     /* Compute residual by subtracting product of denominator and first approximation */
 122:../../opus/silk/Inlines.h ****     /* It's OK to overflow because the final value of a32_nrm should always be small */
 123:../../opus/silk/Inlines.h ****     a32_nrm = silk_SUB32_ovflw(a32_nrm, silk_LSHIFT_ovflw( silk_SMMUL(b32_nrm, result), 3 ));  /* Q
 124:../../opus/silk/Inlines.h **** 
 125:../../opus/silk/Inlines.h ****     /* Refinement */
 126:../../opus/silk/Inlines.h ****     result = silk_SMLAWB(result, a32_nrm, b32_inv);                             /* Q: 29 + a_headrm
 127:../../opus/silk/Inlines.h **** 
 128:../../opus/silk/Inlines.h ****     /* Convert to Qres domain */
 129:../../opus/silk/Inlines.h ****     lshift = 29 + a_headrm - b_headrm - Qres;
 130:../../opus/silk/Inlines.h ****     if( lshift < 0 ) {
 131:../../opus/silk/Inlines.h ****         return silk_LSHIFT_SAT32(result, -lshift);
 132:../../opus/silk/Inlines.h ****     } else {
 133:../../opus/silk/Inlines.h ****         if( lshift < 32){
 134:../../opus/silk/Inlines.h ****             return silk_RSHIFT(result, lshift);
 135:../../opus/silk/Inlines.h ****         } else {
 136:../../opus/silk/Inlines.h ****             /* Avoid undefined result */
 137:../../opus/silk/Inlines.h ****             return 0;
 138:../../opus/silk/Inlines.h ****         }
 139:../../opus/silk/Inlines.h ****     }
 140:../../opus/silk/Inlines.h **** }
 141:../../opus/silk/Inlines.h **** 
 142:../../opus/silk/Inlines.h **** /* Invert int32 value and return result as int32 in a given Q-domain */
 143:../../opus/silk/Inlines.h **** static OPUS_INLINE opus_int32 silk_INVERSE32_varQ(   /* O    returns a good approximation of "(1 <<
 144:../../opus/silk/Inlines.h ****     const opus_int32     b32,                   /* I    denominator (Q0)                */
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccBkS4jp.s 			page 4


