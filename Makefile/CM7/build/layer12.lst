  65:../../libmad/layer12.c ****   MAD_F(0x10008004),  /* 2^13 / (2^13 - 1) == 1.00012208521548 */
  66:../../libmad/layer12.c ****   MAD_F(0x10004001),  /* 2^14 / (2^14 - 1) == 1.00006103888177 */
  67:../../libmad/layer12.c ****   MAD_F(0x10002000)   /* 2^15 / (2^15 - 1) == 1.00003051850948 */
  68:../../libmad/layer12.c **** };
