 214:../../libmad/layer12.c **** /* --- Layer II ------------------------------------------------------------ */
 215:../../libmad/layer12.c **** 
 216:../../libmad/layer12.c **** /* possible quantization per subband table */
 217:../../libmad/layer12.c **** static
 218:../../libmad/layer12.c **** struct {
 219:../../libmad/layer12.c ****   unsigned int sblimit;
 220:../../libmad/layer12.c ****   unsigned char const offsets[30];
 221:../../libmad/layer12.c **** } const sbquant_table[5] = {
 222:../../libmad/layer12.c ****   /* ISO/IEC 11172-3 Table B.2a */
