 100:../../libmad/layer12.c **** /*
 101:../../libmad/layer12.c ****  * NAME:	layer->I()
 102:../../libmad/layer12.c ****  * DESCRIPTION:	decode a single Layer I frame
 103:../../libmad/layer12.c ****  */
 104:../../libmad/layer12.c **** int mad_layer_I(struct mad_stream *stream, struct mad_frame *frame)
 105:../../libmad/layer12.c **** {
 106:../../libmad/layer12.c ****   struct mad_header *header = &frame->header;
 107:../../libmad/layer12.c ****   unsigned int nch, bound, ch, s, sb, nb;
 108:../../libmad/layer12.c ****   unsigned char allocation[2][32], scalefactor[2][32];
 109:../../libmad/layer12.c **** 
 110:../../libmad/layer12.c ****   nch = MAD_NCHANNELS(header);
 111:../../libmad/layer12.c **** 
 112:../../libmad/layer12.c ****   bound = 32;
 113:../../libmad/layer12.c ****   if (header->mode == MAD_MODE_JOINT_STEREO) {
 114:../../libmad/layer12.c ****     header->flags |= MAD_FLAG_I_STEREO;
 115:../../libmad/layer12.c ****     bound = 4 + header->mode_extension * 4;
 116:../../libmad/layer12.c ****   }
 117:../../libmad/layer12.c **** 
 118:../../libmad/layer12.c ****   /* check CRC word */
 119:../../libmad/layer12.c **** 
 120:../../libmad/layer12.c ****   if (header->flags & MAD_FLAG_PROTECTION) {
 121:../../libmad/layer12.c ****     header->crc_check =
 122:../../libmad/layer12.c ****       mad_bit_crc(stream->ptr, 4 * (bound * nch + (32 - bound)),
ARM GAS  C:\Users\oleg\AppData\Local\Temp\cc9p6uGj.s 			page 5


 123:../../libmad/layer12.c **** 		  header->crc_check);
 124:../../libmad/layer12.c **** 
 125:../../libmad/layer12.c ****     if (header->crc_check != header->crc_target &&
 126:../../libmad/layer12.c **** 	!(frame->options & MAD_OPTION_IGNORECRC)) {
 127:../../libmad/layer12.c ****       stream->error = MAD_ERROR_BADCRC;
 128:../../libmad/layer12.c ****       return -1;
 129:../../libmad/layer12.c ****     }
 130:../../libmad/layer12.c ****   }
 131:../../libmad/layer12.c **** 
 132:../../libmad/layer12.c ****   /* decode bit allocations */
 133:../../libmad/layer12.c **** 
 134:../../libmad/layer12.c ****   for (sb = 0; sb < bound; ++sb) {
 135:../../libmad/layer12.c ****     for (ch = 0; ch < nch; ++ch) {
 136:../../libmad/layer12.c ****       nb = mad_bit_read(&stream->ptr, 4);
 137:../../libmad/layer12.c **** 
 138:../../libmad/layer12.c ****       if (nb == 15) {
 139:../../libmad/layer12.c **** 	stream->error = MAD_ERROR_BADBITALLOC;
 140:../../libmad/layer12.c **** 	return -1;
 141:../../libmad/layer12.c ****       }
 142:../../libmad/layer12.c **** 
 143:../../libmad/layer12.c ****       allocation[ch][sb] = nb ? nb + 1 : 0;
 144:../../libmad/layer12.c ****     }
 145:../../libmad/layer12.c ****   }
 146:../../libmad/layer12.c **** 
 147:../../libmad/layer12.c ****   for (sb = bound; sb < 32; ++sb) {
 148:../../libmad/layer12.c ****     nb = mad_bit_read(&stream->ptr, 4);
 149:../../libmad/layer12.c **** 
 150:../../libmad/layer12.c ****     if (nb == 15) {
 151:../../libmad/layer12.c ****       stream->error = MAD_ERROR_BADBITALLOC;
 152:../../libmad/layer12.c ****       return -1;
 153:../../libmad/layer12.c ****     }
 154:../../libmad/layer12.c **** 
 155:../../libmad/layer12.c ****     allocation[0][sb] =
 156:../../libmad/layer12.c ****     allocation[1][sb] = nb ? nb + 1 : 0;
 157:../../libmad/layer12.c ****   }
 158:../../libmad/layer12.c **** 
 159:../../libmad/layer12.c ****   /* decode scalefactors */
 160:../../libmad/layer12.c **** 
 161:../../libmad/layer12.c ****   for (sb = 0; sb < 32; ++sb) {
 162:../../libmad/layer12.c ****     for (ch = 0; ch < nch; ++ch) {
 163:../../libmad/layer12.c ****       if (allocation[ch][sb]) {
 164:../../libmad/layer12.c **** 	scalefactor[ch][sb] = mad_bit_read(&stream->ptr, 6);
 165:../../libmad/layer12.c **** 
 166:../../libmad/layer12.c **** # if defined(OPT_STRICT)
 167:../../libmad/layer12.c **** 	/*
 168:../../libmad/layer12.c **** 	 * Scalefactor index 63 does not appear in Table B.1 of
 169:../../libmad/layer12.c **** 	 * ISO/IEC 11172-3. Nonetheless, other implementations accept it,
 170:../../libmad/layer12.c **** 	 * so we only reject it if OPT_STRICT is defined.
 171:../../libmad/layer12.c **** 	 */
 172:../../libmad/layer12.c **** 	if (scalefactor[ch][sb] == 63) {
 173:../../libmad/layer12.c **** 	  stream->error = MAD_ERROR_BADSCALEFACTOR;
 174:../../libmad/layer12.c **** 	  return -1;
 175:../../libmad/layer12.c **** 	}
 176:../../libmad/layer12.c **** # endif
 177:../../libmad/layer12.c ****       }
 178:../../libmad/layer12.c ****     }
 179:../../libmad/layer12.c ****   }
ARM GAS  C:\Users\oleg\AppData\Local\Temp\cc9p6uGj.s 			page 6


 180:../../libmad/layer12.c **** 
 181:../../libmad/layer12.c ****   /* decode samples */
 182:../../libmad/layer12.c **** 
 183:../../libmad/layer12.c ****   for (s = 0; s < 12; ++s) {
 184:../../libmad/layer12.c ****     for (sb = 0; sb < bound; ++sb) {
 185:../../libmad/layer12.c ****       for (ch = 0; ch < nch; ++ch) {
 186:../../libmad/layer12.c **** 	nb = allocation[ch][sb];
 187:../../libmad/layer12.c **** 	frame->sbsample[ch][s][sb] = nb ?
 188:../../libmad/layer12.c **** 	  mad_f_mul(I_sample(&stream->ptr, nb),
 189:../../libmad/layer12.c **** 		    sf_table[scalefactor[ch][sb]]) : 0;
 190:../../libmad/layer12.c ****       }
 191:../../libmad/layer12.c ****     }
 192:../../libmad/layer12.c **** 
 193:../../libmad/layer12.c ****     for (sb = bound; sb < 32; ++sb) {
 194:../../libmad/layer12.c ****       if ((nb = allocation[0][sb])) {
 195:../../libmad/layer12.c **** 	mad_fixed_t sample;
 196:../../libmad/layer12.c **** 
 197:../../libmad/layer12.c **** 	sample = I_sample(&stream->ptr, nb);
 198:../../libmad/layer12.c **** 
 199:../../libmad/layer12.c **** 	for (ch = 0; ch < nch; ++ch) {
 200:../../libmad/layer12.c **** 	  frame->sbsample[ch][s][sb] =
 201:../../libmad/layer12.c **** 	    mad_f_mul(sample, sf_table[scalefactor[ch][sb]]);
 202:../../libmad/layer12.c **** 	}
 203:../../libmad/layer12.c ****       }
 204:../../libmad/layer12.c ****       else {
 205:../../libmad/layer12.c **** 	for (ch = 0; ch < nch; ++ch)
 206:../../libmad/layer12.c **** 	  frame->sbsample[ch][s][sb] = 0;
 207:../../libmad/layer12.c ****       }
 208:../../libmad/layer12.c ****     }
 209:../../libmad/layer12.c ****   }
 210:../../libmad/layer12.c **** 
 211:../../libmad/layer12.c ****   return 0;
 212:../../libmad/layer12.c **** }
