 393:../../opus/silk/SigProc_FIX.h **** 
 394:../../opus/silk/SigProc_FIX.h **** /* Rotate a32 right by 'rot' bits. Negative rot values result in rotating
 395:../../opus/silk/SigProc_FIX.h ****    left. Output is 32bit int.
 396:../../opus/silk/SigProc_FIX.h ****    Note: contemporary compilers recognize the C expression below and
 397:../../opus/silk/SigProc_FIX.h ****    compile it into a 'ror' instruction if available. No need for OPUS_INLINE ASM! */
 398:../../opus/silk/SigProc_FIX.h **** static OPUS_INLINE opus_int32 silk_ROR32( opus_int32 a32, opus_int rot )
 399:../../opus/silk/SigProc_FIX.h **** {
 400:../../opus/silk/SigProc_FIX.h ****     opus_uint32 x = (opus_uint32) a32;
 401:../../opus/silk/SigProc_FIX.h ****     opus_uint32 r = (opus_uint32) rot;
 402:../../opus/silk/SigProc_FIX.h ****     opus_uint32 m = (opus_uint32) -rot;
 403:../../opus/silk/SigProc_FIX.h ****     if( rot == 0 ) {
 404:../../opus/silk/SigProc_FIX.h ****         return a32;
 405:../../opus/silk/SigProc_FIX.h ****     } else if( rot < 0 ) {
 406:../../opus/silk/SigProc_FIX.h ****         return (opus_int32) ((x << m) | (x >> (32 - m)));
 407:../../opus/silk/SigProc_FIX.h ****     } else {
 408:../../opus/silk/SigProc_FIX.h ****         return (opus_int32) ((x << (32 - r)) | (x >> r));
 409:../../opus/silk/SigProc_FIX.h ****     }
 410:../../opus/silk/SigProc_FIX.h **** }
 411:../../opus/silk/SigProc_FIX.h **** 
 412:../../opus/silk/SigProc_FIX.h **** /* Allocate opus_int16 aligned to 4-byte memory address */
 413:../../opus/silk/SigProc_FIX.h **** #if EMBEDDED_ARM
 414:../../opus/silk/SigProc_FIX.h **** #define silk_DWORD_ALIGN __attribute__((aligned(4)))
 415:../../opus/silk/SigProc_FIX.h **** #else
 416:../../opus/silk/SigProc_FIX.h **** #define silk_DWORD_ALIGN
 417:../../opus/silk/SigProc_FIX.h **** #endif
