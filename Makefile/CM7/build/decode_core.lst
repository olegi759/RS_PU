 143:../../opus/silk/Inlines.h **** static OPUS_INLINE opus_int32 silk_INVERSE32_varQ(   /* O    returns a good approximation of "(1 <<
 144:../../opus/silk/Inlines.h ****     const opus_int32     b32,                   /* I    denominator (Q0)                */
