  40:../../opus/silk/Inlines.h **** /* count leading zeros of opus_int64 */
  41:../../opus/silk/Inlines.h **** static OPUS_INLINE opus_int32 silk_CLZ64( opus_int64 in )
  42:../../opus/silk/Inlines.h **** {
  43:../../opus/silk/Inlines.h ****     opus_int32 in_upper;
  44:../../opus/silk/Inlines.h **** 
  45:../../opus/silk/Inlines.h ****     in_upper = (opus_int32)silk_RSHIFT64(in, 32);
  46:../../opus/silk/Inlines.h ****     if (in_upper == 0) {
  47:../../opus/silk/Inlines.h ****         /* Search in the lower 32 bits */
  48:../../opus/silk/Inlines.h ****         return 32 + silk_CLZ32( (opus_int32) in );
  49:../../opus/silk/Inlines.h ****     } else {
  50:../../opus/silk/Inlines.h ****         /* Search in the upper 32 bits */
  51:../../opus/silk/Inlines.h ****         return silk_CLZ32( in_upper );
  52:../../opus/silk/Inlines.h ****     }
  53:../../opus/silk/Inlines.h **** }
  54:../../opus/silk/Inlines.h **** 
  55:../../opus/silk/Inlines.h **** /* get number of leading zeros and fractional part (the bits right after the leading one */
  56:../../opus/silk/Inlines.h **** static OPUS_INLINE void silk_CLZ_FRAC(
  57:../../opus/silk/Inlines.h ****     opus_int32 in,            /* I  input                               */
  58:../../opus/silk/Inlines.h ****     opus_int32 *lz,           /* O  number of leading zeros             */
  59:../../opus/silk/Inlines.h ****     opus_int32 *frac_Q7       /* O  the 7 bits right after the leading one */
  60:../../opus/silk/Inlines.h **** )
  61:../../opus/silk/Inlines.h **** {
  62:../../opus/silk/Inlines.h ****     opus_int32 lzeros = silk_CLZ32(in);
  63:../../opus/silk/Inlines.h **** 
  64:../../opus/silk/Inlines.h ****     * lz = lzeros;
  65:../../opus/silk/Inlines.h ****     * frac_Q7 = silk_ROR32(in, 24 - lzeros) & 0x7f;
  66:../../opus/silk/Inlines.h **** }
  67:../../opus/silk/Inlines.h **** 
  68:../../opus/silk/Inlines.h **** /* Approximation of square root                                          */
  69:../../opus/silk/Inlines.h **** /* Accuracy: < +/- 10%  for output values > 15                           */
  70:../../opus/silk/Inlines.h **** /*           < +/- 2.5% for output values > 120                          */
  71:../../opus/silk/Inlines.h **** static OPUS_INLINE opus_int32 silk_SQRT_APPROX( opus_int32 x )
  72:../../opus/silk/Inlines.h **** {
  73:../../opus/silk/Inlines.h ****     opus_int32 y, lz, frac_Q7;
  74:../../opus/silk/Inlines.h **** 
  75:../../opus/silk/Inlines.h ****     if( x <= 0 ) {
  76:../../opus/silk/Inlines.h ****         return 0;
  77:../../opus/silk/Inlines.h ****     }
  78:../../opus/silk/Inlines.h **** 
  79:../../opus/silk/Inlines.h ****     silk_CLZ_FRAC(x, &lz, &frac_Q7);
  80:../../opus/silk/Inlines.h **** 
ARM GAS  C:\Users\oleg\AppData\Local\Temp\cccQ6vMQ.s 			page 15


  81:../../opus/silk/Inlines.h ****     if( lz & 1 ) {
  82:../../opus/silk/Inlines.h ****         y = 32768;
  83:../../opus/silk/Inlines.h ****     } else {
  84:../../opus/silk/Inlines.h ****         y = 46214;        /* 46214 = sqrt(2) * 32768 */
  85:../../opus/silk/Inlines.h ****     }
  86:../../opus/silk/Inlines.h **** 
  87:../../opus/silk/Inlines.h ****     /* get scaling right */
  88:../../opus/silk/Inlines.h ****     y >>= silk_RSHIFT(lz, 1);
  89:../../opus/silk/Inlines.h **** 
  90:../../opus/silk/Inlines.h ****     /* increment using fractional part of input */
  91:../../opus/silk/Inlines.h ****     y = silk_SMLAWB(y, y, silk_SMULBB(213, frac_Q7));
  92:../../opus/silk/Inlines.h **** 
  93:../../opus/silk/Inlines.h ****     return y;
  94:../../opus/silk/Inlines.h **** }
