  63:../../opus/silk/PLC.c **** void silk_PLC(
  64:../../opus/silk/PLC.c ****     silk_decoder_state                  *psDec,             /* I/O Decoder state        */
  65:../../opus/silk/PLC.c ****     silk_decoder_control                *psDecCtrl,         /* I/O Decoder control      */
