  69:../../opus/silk/PLC.c **** )
  70:../../opus/silk/PLC.c **** {
  71:../../opus/silk/PLC.c ****     /* PLC control function */
  72:../../opus/silk/PLC.c ****     if( psDec->fs_kHz != psDec->sPLC.fs_kHz ) {
  73:../../opus/silk/PLC.c ****         silk_PLC_Reset( psDec );
  74:../../opus/silk/PLC.c ****         psDec->sPLC.fs_kHz = psDec->fs_kHz;
  75:../../opus/silk/PLC.c ****     }
  76:../../opus/silk/PLC.c **** 
  77:../../opus/silk/PLC.c ****     if( lost ) {
  78:../../opus/silk/PLC.c ****         /****************************/
  79:../../opus/silk/PLC.c ****         /* Generate Signal          */
  80:../../opus/silk/PLC.c ****         /****************************/
  81:../../opus/silk/PLC.c ****         silk_PLC_conceal( psDec, psDecCtrl, frame, arch );
  82:../../opus/silk/PLC.c **** 
  83:../../opus/silk/PLC.c ****         psDec->lossCnt++;
  84:../../opus/silk/PLC.c ****     } else {
  85:../../opus/silk/PLC.c ****         /****************************/
