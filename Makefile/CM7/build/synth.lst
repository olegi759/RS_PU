  32:../../libmad/synth.c **** /*
  33:../../libmad/synth.c ****  * NAME:	synth->init()
  34:../../libmad/synth.c ****  * DESCRIPTION:	initialize synth struct
  35:../../libmad/synth.c ****  */
  36:../../libmad/synth.c **** void mad_synth_init(struct mad_synth *synth)
  37:../../libmad/synth.c **** {
  38:../../libmad/synth.c ****   mad_synth_mute(synth);
  39:../../libmad/synth.c **** 
  40:../../libmad/synth.c ****   synth->phase = 0;
  41:../../libmad/synth.c **** 
  42:../../libmad/synth.c ****   synth->pcm.samplerate = 0;
  43:../../libmad/synth.c ****   synth->pcm.channels   = 0;
  44:../../libmad/synth.c ****   synth->pcm.length     = 0;
  45:../../libmad/synth.c **** }
  46:../../libmad/synth.c **** 
  47:../../libmad/synth.c **** /*
  48:../../libmad/synth.c ****  * NAME:	synth->mute()
  49:../../libmad/synth.c ****  * DESCRIPTION:	zero all polyphase filterbank values, resetting synthesis
  50:../../libmad/synth.c ****  */
  51:../../libmad/synth.c **** void mad_synth_mute(struct mad_synth *synth)
  52:../../libmad/synth.c **** {
  53:../../libmad/synth.c ****   unsigned int ch, s, v;
  54:../../libmad/synth.c **** 
  55:../../libmad/synth.c ****   for (ch = 0; ch < 2; ++ch) {
  56:../../libmad/synth.c ****     for (s = 0; s < 16; ++s) {
  57:../../libmad/synth.c ****       for (v = 0; v < 8; ++v) {
  58:../../libmad/synth.c **** 	synth->filter[ch][0][0][s][v] = synth->filter[ch][0][1][s][v] =
  59:../../libmad/synth.c **** 	synth->filter[ch][1][0][s][v] = synth->filter[ch][1][1][s][v] = 0;
  60:../../libmad/synth.c ****       }
  61:../../libmad/synth.c ****     }
  62:../../libmad/synth.c ****   }
  63:../../libmad/synth.c **** }
  64:../../libmad/synth.c **** 
  65:../../libmad/synth.c **** /*
  66:../../libmad/synth.c ****  * An optional optimization called here the Subband Synthesis Optimization
  67:../../libmad/synth.c ****  * (SSO) improves the performance of subband synthesis at the expense of
  68:../../libmad/synth.c ****  * accuracy.
  69:../../libmad/synth.c ****  *
  70:../../libmad/synth.c ****  * The idea is to simplify 32x32->64-bit multiplication to 32x32->32 such
  71:../../libmad/synth.c ****  * that extra scaling and rounding are not necessary. This often allows the
  72:../../libmad/synth.c ****  * compiler to use faster 32-bit multiply-accumulate instructions instead of
  73:../../libmad/synth.c ****  * explicit 64-bit multiply, shift, and add instructions.
  74:../../libmad/synth.c ****  *
  75:../../libmad/synth.c ****  * SSO works like this: a full 32x32->64-bit multiply of two mad_fixed_t
  76:../../libmad/synth.c ****  * values requires the result to be right-shifted 28 bits to be properly
  77:../../libmad/synth.c ****  * scaled to the same fixed-point format. Right shifts can be applied at any
  78:../../libmad/synth.c ****  * time to either operand or to the result, so the optimization involves
  79:../../libmad/synth.c ****  * careful placement of these shifts to minimize the loss of accuracy.
  80:../../libmad/synth.c ****  *
  81:../../libmad/synth.c ****  * First, a 14-bit shift is applied with rounding at compile-time to the D[]
  82:../../libmad/synth.c ****  * table of coefficients for the subband synthesis window. This only loses 2
  83:../../libmad/synth.c ****  * bits of accuracy because the lower 12 bits are always zero. A second
  84:../../libmad/synth.c ****  * 12-bit shift occurs after the DCT calculation. This loses 12 bits of
  85:../../libmad/synth.c ****  * accuracy. Finally, a third 2-bit shift occurs just before the sample is
  86:../../libmad/synth.c ****  * saved in the PCM buffer. 14 + 12 + 2 == 28 bits.
  87:../../libmad/synth.c ****  */
  88:../../libmad/synth.c **** 
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccteunTO.s 			page 3


  89:../../libmad/synth.c **** /* FPM_DEFAULT without OPT_SSO will actually lose accuracy and performance */
  90:../../libmad/synth.c **** 
  91:../../libmad/synth.c **** # if defined(FPM_DEFAULT) && !defined(OPT_SSO)
  92:../../libmad/synth.c **** #  define OPT_SSO
  93:../../libmad/synth.c **** # endif
  94:../../libmad/synth.c **** 
  95:../../libmad/synth.c **** /* second SSO shift, with rounding */
  96:../../libmad/synth.c **** 
  97:../../libmad/synth.c **** # if defined(OPT_SSO)
  98:../../libmad/synth.c **** #  define SHIFT(x)  (((x) + (1L << 11)) >> 12)
  99:../../libmad/synth.c **** # else
 100:../../libmad/synth.c **** #  define SHIFT(x)  (x)
 101:../../libmad/synth.c **** # endif
 102:../../libmad/synth.c **** 
 103:../../libmad/synth.c **** /* possible DCT speed optimization */
 104:../../libmad/synth.c **** 
 105:../../libmad/synth.c **** # if defined(OPT_SPEED) && defined(MAD_F_MLX)
 106:../../libmad/synth.c **** #  define OPT_DCTO
 107:../../libmad/synth.c **** #  define MUL(x, y)  \
 108:../../libmad/synth.c ****     ({ mad_fixed64hi_t hi;  \
 109:../../libmad/synth.c ****        mad_fixed64lo_t lo;  \
 110:../../libmad/synth.c ****        MAD_F_MLX(hi, lo, (x), (y));  \
 111:../../libmad/synth.c ****        hi << (32 - MAD_F_SCALEBITS - 3);  \
 112:../../libmad/synth.c ****     })
 113:../../libmad/synth.c **** # else
 114:../../libmad/synth.c **** #  undef OPT_DCTO
 115:../../libmad/synth.c **** #  define MUL(x, y)  mad_f_mul((x), (y))
 116:../../libmad/synth.c **** # endif
