  53:../../CM7/Core/Src/playmp3.c **** 
  54:../../CM7/Core/Src/playmp3.c **** 
  55:../../CM7/Core/Src/playmp3.c **** 	rc = mad_read_next_frame(&global_mad_data);
  56:../../CM7/Core/Src/playmp3.c **** 	if (rc == -1) {
  57:../../CM7/Core/Src/playmp3.c **** 		playmp3_stop();
  58:../../CM7/Core/Src/playmp3.c **** 		return;
  59:../../CM7/Core/Src/playmp3.c **** 	}
  60:../../CM7/Core/Src/playmp3.c **** 	if (rc != 1)  return;
  61:../../CM7/Core/Src/playmp3.c **** 
  62:../../CM7/Core/Src/playmp3.c **** 	mad_synth_frame(&global_mad_data.synth, &global_mad_data.frame);
  63:../../CM7/Core/Src/playmp3.c **** 
  64:../../CM7/Core/Src/playmp3.c **** 	if (global_mad_data.frame.header.samplerate && !playmp3_sample_rate) {
