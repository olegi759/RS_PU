 121:../../opus/silk/NLSF_stabilize.c ****         /* Insertion sort (fast for already almost sorted arrays):   */
 122:../../opus/silk/NLSF_stabilize.c ****         /* Best case:  O(n)   for an already sorted array            */
 123:../../opus/silk/NLSF_stabilize.c ****         /* Worst case: O(n^2) for an inversely sorted array          */
 124:../../opus/silk/NLSF_stabilize.c ****         silk_insertion_sort_increasing_all_values_int16( &NLSF_Q15[0], L );
 125:../../opus/silk/NLSF_stabilize.c **** 
 126:../../opus/silk/NLSF_stabilize.c ****         /* First NLSF should be no less than NDeltaMin[0] */
 127:../../opus/silk/NLSF_stabilize.c ****         NLSF_Q15[0] = silk_max_int( NLSF_Q15[0], NDeltaMin_Q15[0] );
 128:../../opus/silk/NLSF_stabilize.c **** 
 129:../../opus/silk/NLSF_stabilize.c ****         /* Keep delta_min distance between the NLSFs */
 130:../../opus/silk/NLSF_stabilize.c ****         for( i = 1; i < L; i++ )
 131:../../opus/silk/NLSF_stabilize.c ****             NLSF_Q15[i] = silk_max_int( NLSF_Q15[i], silk_ADD_SAT16( NLSF_Q15[i-1], NDeltaMin_Q15[i
 132:../../opus/silk/NLSF_stabilize.c **** 
 133:../../opus/silk/NLSF_stabilize.c ****         /* Last NLSF should be no higher than 1 - NDeltaMin[L] */
 134:../../opus/silk/NLSF_stabilize.c ****         NLSF_Q15[L-1] = silk_min_int( NLSF_Q15[L-1], (1<<15) - NDeltaMin_Q15[L] );
 135:../../opus/silk/NLSF_stabilize.c **** 
 136:../../opus/silk/NLSF_stabilize.c ****         /* Keep NDeltaMin distance between the NLSFs */
 137:../../opus/silk/NLSF_stabilize.c ****         for( i = L-2; i >= 0; i-- )
 138:../../opus/silk/NLSF_stabilize.c ****             NLSF_Q15[i] = silk_min_int( NLSF_Q15[i], NLSF_Q15[i+1] - NDeltaMin_Q15[i+1] );
 139:../../opus/silk/NLSF_stabilize.c ****     }
