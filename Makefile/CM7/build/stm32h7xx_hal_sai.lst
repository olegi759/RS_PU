 297:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c **** 
 298:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       (+) User must implement HAL_SAI_MspInit() function in which he configures
 299:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****           all related peripherals resources (CLOCK, GPIO, DMA, IT and NVIC ).
 300:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c **** 
 301:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       (+) Call the function HAL_SAI_Init() to configure the selected device with
 302:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****           the selected configuration:
 303:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****         (++) Mode (Master/slave TX/RX)
 304:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****         (++) Protocol
 305:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****         (++) Data Size
 306:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****         (++) MCLK Output
 307:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****         (++) Audio frequency
 308:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****         (++) FIFO Threshold
 309:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****         (++) Frame Config
 310:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****         (++) Slot Config
 311:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****         (++) PDM Config
 312:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c **** 
 313:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       (+) Call the function HAL_SAI_DeInit() to restore the default configuration
 314:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****           of the selected SAI peripheral.
