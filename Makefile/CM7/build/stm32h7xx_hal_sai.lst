 651:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****     /* Round result to the nearest integer */
 652:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****     if ((tmpval % 10U) > 8U)
 653:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****     {
