 612:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****     /* Configure Master Clock Divider using the following formula :
 613:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****        - If NODIV = 1 :
 614:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****          MCKDIV[5:0] = SAI_CK_x / (FS * (FRL + 1))
 615:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****        - If NODIV = 0 :
 616:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****          MCKDIV[5:0] = SAI_CK_x / (FS * (OSR + 1) * 256) */
 617:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****     if (hsai->Init.NoDivider == SAI_MASTERDIVIDER_DISABLE)
 618:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****     {
 619:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       /* NODIV = 1 */
 620:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       uint32_t tmpframelength;
 621:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c **** 
 622:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       if (hsai->Init.Protocol == SAI_SPDIF_PROTOCOL)
 623:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       {
 624:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****         /* For SPDIF protocol, frame length is set by hardware to 64 */
 625:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****         tmpframelength = SAI_SPDIF_FRAME_LENGTH;
 626:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       }
 627:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       else if (hsai->Init.Protocol == SAI_AC97_PROTOCOL)
 628:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       {
 629:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****         /* For AC97 protocol, frame length is set by hardware to 256 */
 630:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****         tmpframelength = SAI_AC97_FRAME_LENGTH;
 631:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       }
 632:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       else
 633:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       {
 634:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****         /* For free protocol, frame length is set by user */
 635:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****         tmpframelength = hsai->FrameInit.FrameLength;
 636:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       }
 637:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c **** 
 638:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       /* (freq x 10) to keep Significant digits */
 639:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       tmpval = (freq * 10U) / (hsai->Init.AudioFrequency * tmpframelength);
 640:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****     }
 641:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****     else
 642:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****     {
 643:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       /* NODIV = 0 */
 644:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       uint32_t tmposr;
 645:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       tmposr = (hsai->Init.MckOverSampling == SAI_MCK_OVERSAMPLING_ENABLE) ? 2U : 1U;
 646:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       /* (freq x 10) to keep Significant digits */
 647:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       tmpval = (freq * 10U) / (hsai->Init.AudioFrequency * tmposr * 256U);
 648:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****     }
