1071:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c **** /** @defgroup SAI_Exported_Functions_Group2 IO operation functions
1072:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****   * @brief    Data transfers functions
1073:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****   *
1074:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c **** @verbatim
1075:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****   ==============================================================================
1076:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****                       ##### IO operation functions #####
1077:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****   ==============================================================================
1078:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****   [..]
1079:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****     This subsection provides a set of functions allowing to manage the SAI data
1080:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****     transfers.
1081:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c **** 
1082:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****     (+) There are two modes of transfer:
1083:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       (++) Blocking mode : The communication is performed in the polling mode.
1084:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****            The status of all data processing is returned by the same function
1085:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****            after finishing transfer.
1086:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       (++) No-Blocking mode : The communication is performed using Interrupts
1087:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****            or DMA. These functions return the status of the transfer startup.
1088:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****            The end of the data processing will be indicated through the
1089:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****            dedicated SAI IRQ when using Interrupt mode or the DMA IRQ when
1090:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****            using DMA mode.
1091:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c **** 
1092:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****     (+) Blocking mode functions are :
1093:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       (++) HAL_SAI_Transmit()
1094:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       (++) HAL_SAI_Receive()
1095:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c **** 
1096:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****     (+) Non Blocking mode functions with Interrupt are :
1097:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       (++) HAL_SAI_Transmit_IT()
1098:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       (++) HAL_SAI_Receive_IT()
1099:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c **** 
1100:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****     (+) Non Blocking mode functions with DMA are :
1101:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       (++) HAL_SAI_Transmit_DMA()
1102:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       (++) HAL_SAI_Receive_DMA()
1103:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c **** 
1104:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****     (+) A set of Transfer Complete Callbacks are provided in non Blocking mode:
1105:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       (++) HAL_SAI_TxCpltCallback()
1106:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       (++) HAL_SAI_RxCpltCallback()
1107:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c ****       (++) HAL_SAI_ErrorCallback()
1108:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c **** 
1109:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_sai.c **** @endverbatim
