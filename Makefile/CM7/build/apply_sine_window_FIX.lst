  31:../../opus/silk/fixed/apply_sine_window_FIX.c **** 
  32:../../opus/silk/fixed/apply_sine_window_FIX.c **** /* Apply sine window to signal vector.                                      */
  33:../../opus/silk/fixed/apply_sine_window_FIX.c **** /* Window types:                                                            */
  34:../../opus/silk/fixed/apply_sine_window_FIX.c **** /*    1 -> sine window from 0 to pi/2                                       */
  35:../../opus/silk/fixed/apply_sine_window_FIX.c **** /*    2 -> sine window from pi/2 to pi                                      */
  36:../../opus/silk/fixed/apply_sine_window_FIX.c **** /* Every other sample is linearly interpolated, for speed.                  */
  37:../../opus/silk/fixed/apply_sine_window_FIX.c **** /* Window length must be between 16 and 120 (incl) and a multiple of 4.     */
  38:../../opus/silk/fixed/apply_sine_window_FIX.c **** 
  39:../../opus/silk/fixed/apply_sine_window_FIX.c **** /* Matlab code for table:
  40:../../opus/silk/fixed/apply_sine_window_FIX.c ****    for k=16:9*4:16+2*9*4, fprintf(' %7.d,', -round(65536*pi ./ (k:4:k+8*4))); fprintf('\n'); end
  41:../../opus/silk/fixed/apply_sine_window_FIX.c **** */
