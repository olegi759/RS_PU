  33:../../opus/celt/entcode.c **** #if !defined(EC_CLZ)
  34:../../opus/celt/entcode.c **** /*This is a fallback for systems where we don't know how to access
  35:../../opus/celt/entcode.c ****    a BSR or CLZ instruction (see ecintrin.h).
  36:../../opus/celt/entcode.c ****   If you are optimizing Opus on a new platform and it has a native CLZ or
  37:../../opus/celt/entcode.c ****    BZR (e.g. cell, MIPS, x86, etc) then making it available to Opus will be
  38:../../opus/celt/entcode.c ****    an easy performance win.*/
  39:../../opus/celt/entcode.c **** int ec_ilog(opus_uint32 _v){
  40:../../opus/celt/entcode.c ****   /*On a Pentium M, this branchless version tested as the fastest on
  41:../../opus/celt/entcode.c ****      1,000,000,000 random 32-bit integers, edging out a similar version with
  42:../../opus/celt/entcode.c ****      branches, and a 256-entry LUT version.*/
  43:../../opus/celt/entcode.c ****   int ret;
  44:../../opus/celt/entcode.c ****   int m;
  45:../../opus/celt/entcode.c ****   ret=!!_v;
  46:../../opus/celt/entcode.c ****   m=!!(_v&0xFFFF0000)<<4;
  47:../../opus/celt/entcode.c ****   _v>>=m;
  48:../../opus/celt/entcode.c ****   ret|=m;
  49:../../opus/celt/entcode.c ****   m=!!(_v&0xFF00)<<3;
  50:../../opus/celt/entcode.c ****   _v>>=m;
  51:../../opus/celt/entcode.c ****   ret|=m;
  52:../../opus/celt/entcode.c ****   m=!!(_v&0xF0)<<2;
  53:../../opus/celt/entcode.c ****   _v>>=m;
  54:../../opus/celt/entcode.c ****   ret|=m;
  55:../../opus/celt/entcode.c ****   m=!!(_v&0xC)<<1;
  56:../../opus/celt/entcode.c ****   _v>>=m;
  57:../../opus/celt/entcode.c ****   ret|=m;
  58:../../opus/celt/entcode.c ****   ret+=!!(_v&0x2);
  59:../../opus/celt/entcode.c ****   return ret;
  60:../../opus/celt/entcode.c **** }
  61:../../opus/celt/entcode.c **** #endif
