 393:../../opus/silk/SigProc_FIX.h **** 
 394:../../opus/silk/SigProc_FIX.h **** /* Rotate a32 right by 'rot' bits. Negative rot values result in rotating
 395:../../opus/silk/SigProc_FIX.h ****    left. Output is 32bit int.
 396:../../opus/silk/SigProc_FIX.h ****    Note: contemporary compilers recognize the C expression below and
 397:../../opus/silk/SigProc_FIX.h ****    compile it into a 'ror' instruction if available. No need for OPUS_INLINE ASM! */
 398:../../opus/silk/SigProc_FIX.h **** static OPUS_INLINE opus_int32 silk_ROR32( opus_int32 a32, opus_int rot )
 399:../../opus/silk/SigProc_FIX.h **** {
 400:../../opus/silk/SigProc_FIX.h ****     opus_uint32 x = (opus_uint32) a32;
 401:../../opus/silk/SigProc_FIX.h ****     opus_uint32 r = (opus_uint32) rot;
 402:../../opus/silk/SigProc_FIX.h ****     opus_uint32 m = (opus_uint32) -rot;
 403:../../opus/silk/SigProc_FIX.h ****     if( rot == 0 ) {
 404:../../opus/silk/SigProc_FIX.h ****         return a32;
 405:../../opus/silk/SigProc_FIX.h ****     } else if( rot < 0 ) {
 406:../../opus/silk/SigProc_FIX.h ****         return (opus_int32) ((x << m) | (x >> (32 - m)));
 407:../../opus/silk/SigProc_FIX.h ****     } else {
 408:../../opus/silk/SigProc_FIX.h ****         return (opus_int32) ((x << (32 - r)) | (x >> r));
 409:../../opus/silk/SigProc_FIX.h ****     }
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccPM6oFx.s 			page 22


 410:../../opus/silk/SigProc_FIX.h **** }
 411:../../opus/silk/SigProc_FIX.h **** 
 412:../../opus/silk/SigProc_FIX.h **** /* Allocate opus_int16 aligned to 4-byte memory address */
 413:../../opus/silk/SigProc_FIX.h **** #if EMBEDDED_ARM
 414:../../opus/silk/SigProc_FIX.h **** #define silk_DWORD_ALIGN __attribute__((aligned(4)))
 415:../../opus/silk/SigProc_FIX.h **** #else
 416:../../opus/silk/SigProc_FIX.h **** #define silk_DWORD_ALIGN
 417:../../opus/silk/SigProc_FIX.h **** #endif
 418:../../opus/silk/SigProc_FIX.h **** 
 419:../../opus/silk/SigProc_FIX.h **** /* Useful Macros that can be adjusted to other platforms */
 420:../../opus/silk/SigProc_FIX.h **** #define silk_memcpy(dest, src, size)        memcpy((dest), (src), (size))
 421:../../opus/silk/SigProc_FIX.h **** #define silk_memset(dest, src, size)        memset((dest), (src), (size))
 422:../../opus/silk/SigProc_FIX.h **** #define silk_memmove(dest, src, size)       memmove((dest), (src), (size))
 423:../../opus/silk/SigProc_FIX.h **** 
 424:../../opus/silk/SigProc_FIX.h **** /* Fixed point macros */
 425:../../opus/silk/SigProc_FIX.h **** 
 426:../../opus/silk/SigProc_FIX.h **** /* (a32 * b32) output have to be 32bit int */
 427:../../opus/silk/SigProc_FIX.h **** #define silk_MUL(a32, b32)                  ((a32) * (b32))
 428:../../opus/silk/SigProc_FIX.h **** 
 429:../../opus/silk/SigProc_FIX.h **** /* (a32 * b32) output have to be 32bit uint */
 430:../../opus/silk/SigProc_FIX.h **** #define silk_MUL_uint(a32, b32)             silk_MUL(a32, b32)
 431:../../opus/silk/SigProc_FIX.h **** 
 432:../../opus/silk/SigProc_FIX.h **** /* a32 + (b32 * c32) output have to be 32bit int */
 433:../../opus/silk/SigProc_FIX.h **** #define silk_MLA(a32, b32, c32)             silk_ADD32((a32),((b32) * (c32)))
 434:../../opus/silk/SigProc_FIX.h **** 
 435:../../opus/silk/SigProc_FIX.h **** /* a32 + (b32 * c32) output have to be 32bit uint */
 436:../../opus/silk/SigProc_FIX.h **** #define silk_MLA_uint(a32, b32, c32)        silk_MLA(a32, b32, c32)
 437:../../opus/silk/SigProc_FIX.h **** 
 438:../../opus/silk/SigProc_FIX.h **** /* ((a32 >> 16)  * (b32 >> 16)) output have to be 32bit int */
 439:../../opus/silk/SigProc_FIX.h **** #define silk_SMULTT(a32, b32)               (((a32) >> 16) * ((b32) >> 16))
 440:../../opus/silk/SigProc_FIX.h **** 
