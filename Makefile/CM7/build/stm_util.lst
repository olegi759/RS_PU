 438:../../util/stm_util.c **** 		val = 0;
 439:../../util/stm_util.c **** 		memcpy(&val, &pval[i], data_len);
 440:../../util/stm_util.c **** 		res = HAL_FLASH_Program(FLASH_TYPEPROGRAM_DOUBLEWORD, flash_address, val);
