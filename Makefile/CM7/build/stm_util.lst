 519:../../util/stm_util.c **** void stm32_get_bank_sector_page(uint8_t stm32flashtype, uint32_t address, stm32_type_flash_part_t *
 520:../../util/stm_util.c **** {
 521:../../util/stm_util.c **** 
 522:../../util/stm_util.c **** 	 uint32_t addr_diff_base;
 523:../../util/stm_util.c **** 
 524:../../util/stm_util.c **** 	 memset(bank, 0xFF, sizeof(stm32_type_flash_part_t));
 525:../../util/stm_util.c **** 	 memset(sector, 0xFF, sizeof(stm32_type_flash_part_t));
 526:../../util/stm_util.c **** 	 memset(page, 0xFF, sizeof(stm32_type_flash_part_t));
 527:../../util/stm_util.c **** 
 528:../../util/stm_util.c **** 	 addr_diff_base = address - FLASH_BASE;
 529:../../util/stm_util.c **** 
 530:../../util/stm_util.c **** 	switch (stm32flashtype) {
 531:../../util/stm_util.c **** 		case STM32F1XX_LOW_FLASH_TYPE:
 532:../../util/stm_util.c **** 			bank->number = 1;
 533:../../util/stm_util.c **** 			page->size = 1024;
 534:../../util/stm_util.c **** 			if (addr_diff_base < 32 * 1024) page->number = addr_diff_base / page->size;
 535:../../util/stm_util.c **** 			page->count = 32;
 536:../../util/stm_util.c **** 			break;
 537:../../util/stm_util.c **** 		case STM32F1XX_MEDIUM_FLASH_TYPE:
 538:../../util/stm_util.c **** 			bank->number = 1;
 539:../../util/stm_util.c **** 			page->size = 1024;
 540:../../util/stm_util.c **** 			if (addr_diff_base < 128 * 1024) page->number = addr_diff_base / page->size;
 541:../../util/stm_util.c **** 			page->count = 128;
 542:../../util/stm_util.c **** 			break;
 543:../../util/stm_util.c **** 		case STM32F1XX_HIGH_FLASH_TYPE:
 544:../../util/stm_util.c **** 			bank->number = 1;
 545:../../util/stm_util.c **** 			page->size = 2 * 1024;
 546:../../util/stm_util.c **** 			if (addr_diff_base < 512 * 1024) page->number = addr_diff_base / page->size;
 547:../../util/stm_util.c **** 			page->count = 256;
 548:../../util/stm_util.c **** 			break;
 549:../../util/stm_util.c **** 		case STM32F1XX_CONNECT_FLASH_TYPE:
 550:../../util/stm_util.c **** 			bank->number = 1;
 551:../../util/stm_util.c **** 			page->size = 2 * 1024;
 552:../../util/stm_util.c **** 			if (addr_diff_base < 256 * 1024) page->number = addr_diff_base / page->size;
 553:../../util/stm_util.c **** 			page->count = 128;
 554:../../util/stm_util.c **** 			break;
 555:../../util/stm_util.c **** 		case STM32F2XX_FLASH_TYPE:
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccl6htcc.s 			page 32


 556:../../util/stm_util.c **** 			bank->number = 1;
 557:../../util/stm_util.c **** 			//sector->size dinamic
 558:../../util/stm_util.c **** 			sector->count = 12;
 559:../../util/stm_util.c **** 			if (address < 0x08010000) {
 560:../../util/stm_util.c **** 				//sector->size = 16 * 1024;
 561:../../util/stm_util.c **** 				sector->number = addr_diff_base / (16 * 1024);
 562:../../util/stm_util.c **** 			}
 563:../../util/stm_util.c **** 			else if (address < 0x08020000) {
 564:../../util/stm_util.c **** 				//sector->size = 64 * 1024;
 565:../../util/stm_util.c **** 				sector->number = 4;
 566:../../util/stm_util.c **** 			}
 567:../../util/stm_util.c **** 			else if (address < 0x08100000) {
 568:../../util/stm_util.c **** 				//sector->size = 128 * 1024;
 569:../../util/stm_util.c **** 				sector->number = (address - 0x08020000) / (128 * 1024);
 570:../../util/stm_util.c **** 			}
 571:../../util/stm_util.c **** 			break;
 572:../../util/stm_util.c **** 		case STM32G4XX_SINGLE_BANK_FLASH_TYPE:
 573:../../util/stm_util.c **** 			bank->number = 1;
 574:../../util/stm_util.c **** 			page->size = 4 * 1024;
 575:../../util/stm_util.c **** 			if (addr_diff_base < 512 * 1024) page->number = addr_diff_base / page->size;
 576:../../util/stm_util.c **** 			page->count = 128;
 577:../../util/stm_util.c **** 			break;
 578:../../util/stm_util.c **** 		case STM32G4XX_DUAL_BANK_FLASH_TYPE:
 579:../../util/stm_util.c **** 			page->size = 2 * 1024;
 580:../../util/stm_util.c **** 			if (address < 0x08040000) {
 581:../../util/stm_util.c **** 				bank->number = 1;
 582:../../util/stm_util.c **** 				page->number = addr_diff_base / page->size;
 583:../../util/stm_util.c **** 			}
 584:../../util/stm_util.c **** 			else if (address < 0x08080000) {
 585:../../util/stm_util.c **** 				bank->number = 2;
 586:../../util/stm_util.c **** 				page->number = (address - 0x08040000) / page->size;
 587:../../util/stm_util.c **** 			}
 588:../../util/stm_util.c **** 			page->count = 128;
 589:../../util/stm_util.c **** 			break;
 590:../../util/stm_util.c **** 		case STM32H7XX_FLASH_TYPE: //не точно
 591:../../util/stm_util.c **** 			page->size = 4 * 1024;
 592:../../util/stm_util.c **** 			if (address < 0x08100000) {
 593:../../util/stm_util.c **** 				bank->number = 1;
 594:../../util/stm_util.c **** 				page->number = addr_diff_base / page->size;
 595:../../util/stm_util.c **** 			}
 596:../../util/stm_util.c **** 			else if (address < 0x08200000) {
 597:../../util/stm_util.c **** 				bank->number = 2;
 598:../../util/stm_util.c **** 				page->number = (address - 0x08040000) / page->size;
 599:../../util/stm_util.c **** 			}
 600:../../util/stm_util.c **** 			page->count = 256;
 601:../../util/stm_util.c **** 			break;
 602:../../util/stm_util.c **** 	}
 603:../../util/stm_util.c **** 
 604:../../util/stm_util.c **** 
 605:../../util/stm_util.c **** }
