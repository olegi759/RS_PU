1119:../../util/stm_util.c **** 
1120:../../util/stm_util.c ****   // Clear All Errors (if needed)
1121:../../util/stm_util.c ****   if (READ_BIT(huart->Instance->ISR, UART_FLAG_ORE | UART_FLAG_FE | UART_FLAG_NE)) {
1122:../../util/stm_util.c **** 
1123:../../util/stm_util.c **** 	__HAL_UART_CLEAR_PEFLAG(huart);
1124:../../util/stm_util.c **** 	__HAL_UART_CLEAR_OREFLAG(huart);
1125:../../util/stm_util.c **** 	__HAL_UART_CLEAR_FEFLAG(huart);
