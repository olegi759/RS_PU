 961:../../util/stm_util.c ****       __flash_buf_pos -= FLASH_PAGE_SIZE; //позиция для записи
 962:../../util/stm_util.c ****     }
 963:../../util/stm_util.c ****   }
 964:../../util/stm_util.c **** }
