 638:../../util/stm_util.c **** 
 639:../../util/stm_util.c **** uint32_t stm32_get_sector_or_page_size(uint8_t stm32flashtype, uint32_t number)
 640:../../util/stm_util.c **** {
 641:../../util/stm_util.c **** 
 642:../../util/stm_util.c **** 	if (number >= stm32_get_sector_or_page_count(stm32flashtype)) return 0;
 643:../../util/stm_util.c **** 
 644:../../util/stm_util.c **** 	switch (stm32flashtype) {
 645:../../util/stm_util.c **** 		case STM32F1XX_LOW_FLASH_TYPE: return 1024;
 646:../../util/stm_util.c **** 		case STM32F1XX_MEDIUM_FLASH_TYPE: return 1024;
 647:../../util/stm_util.c **** 		case STM32F1XX_HIGH_FLASH_TYPE: return 2 * 1024;
 648:../../util/stm_util.c **** 		case STM32F1XX_CONNECT_FLASH_TYPE: return 2 * 1024;
 649:../../util/stm_util.c **** 		case STM32F2XX_FLASH_TYPE:
 650:../../util/stm_util.c **** 			switch(number) {
 651:../../util/stm_util.c **** 				case 0:
 652:../../util/stm_util.c **** 				case 1:
 653:../../util/stm_util.c **** 				case 2:
 654:../../util/stm_util.c **** 				case 3:
 655:../../util/stm_util.c **** 					return 16 * 1024;
 656:../../util/stm_util.c **** 				case 4:
 657:../../util/stm_util.c **** 					return 64 * 1024;
 658:../../util/stm_util.c **** 				default:
 659:../../util/stm_util.c **** 					return 128 * 1024;
 660:../../util/stm_util.c **** 			}
 661:../../util/stm_util.c **** 		case STM32G4XX_SINGLE_BANK_FLASH_TYPE:	return 4 * 1024;
 662:../../util/stm_util.c **** 		case STM32G4XX_DUAL_BANK_FLASH_TYPE:	return 2 * 1024;
 663:../../util/stm_util.c **** 		case STM32H7XX_FLASH_TYPE: return 4 * 1024; //не точно
 664:../../util/stm_util.c **** 	}
 665:../../util/stm_util.c **** 	return 0;
 666:../../util/stm_util.c **** }
