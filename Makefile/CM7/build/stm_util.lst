 670:../../util/stm_util.c **** int stm32_get_sector_or_page_number(uint32_t address, uint8_t stm32flashtype)
 671:../../util/stm_util.c **** {
 672:../../util/stm_util.c ****   uint32_t addr_begin, addr_end, i;
 673:../../util/stm_util.c ****   uint32_t sector_or_page_count, sector_or_page_size;
 674:../../util/stm_util.c **** 
 675:../../util/stm_util.c ****   sector_or_page_count = stm32_get_sector_or_page_count(stm32flashtype);
 676:../../util/stm_util.c ****   if (!sector_or_page_count) return -1;
 677:../../util/stm_util.c **** 
 678:../../util/stm_util.c **** 
 679:../../util/stm_util.c ****   addr_begin = FLASH_BASE;
 680:../../util/stm_util.c **** 
 681:../../util/stm_util.c ****   for (i = 0; i < sector_or_page_count; ++i) {
 682:../../util/stm_util.c **** 	  sector_or_page_size = stm32_get_sector_or_page_size(stm32flashtype, i);
 683:../../util/stm_util.c **** 	  addr_end = addr_begin + sector_or_page_size;
 684:../../util/stm_util.c **** 	  if ((address >= addr_begin) && (address < addr_end)) return i;
 685:../../util/stm_util.c **** 	  addr_begin += sector_or_page_size;
 686:../../util/stm_util.c ****   }
 687:../../util/stm_util.c **** 
 688:../../util/stm_util.c **** 
 689:../../util/stm_util.c ****   return -1;
 690:../../util/stm_util.c **** }
