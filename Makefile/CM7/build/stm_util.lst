 632:../../util/stm_util.c **** 		case STM32G4XX_DUAL_BANK_FLASH_TYPE: return 256;
 633:../../util/stm_util.c **** 		case STM32H7XX_FLASH_TYPE: return 256; //не точно
 634:../../util/stm_util.c **** 	}
