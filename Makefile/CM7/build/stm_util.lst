 609:../../util/stm_util.c **** {
 610:../../util/stm_util.c **** 	switch (stm32flashtype) {
 611:../../util/stm_util.c **** 		case STM32F1XX_LOW_FLASH_TYPE: return 1;
 612:../../util/stm_util.c **** 		case STM32F1XX_MEDIUM_FLASH_TYPE: return 1;
