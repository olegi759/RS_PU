 846:../../util/stm_util.c **** //запись во флэш
 847:../../util/stm_util.c **** uint32_t  hal_write_to_flash(uint32_t Address, char * data, uint32_t  data_len)
 848:../../util/stm_util.c **** {
 849:../../util/stm_util.c **** 	if (data_len == 0) return 0;
 850:../../util/stm_util.c **** 
 851:../../util/stm_util.c **** 	char * ptr = data;
 852:../../util/stm_util.c **** 	uint32_t ptr_Address = Address;
 853:../../util/stm_util.c **** 	uint32_t offset;
 854:../../util/stm_util.c **** 	uint32_t byte_to_write;
 855:../../util/stm_util.c **** 	uint32_t page_address;
 856:../../util/stm_util.c **** 	HAL_StatusTypeDef erase_error, prog;
 857:../../util/stm_util.c **** 	uint64_t Data;
 858:../../util/stm_util.c **** 
 859:../../util/stm_util.c **** 	hal_flash_unlocked();
 860:../../util/stm_util.c **** 
 861:../../util/stm_util.c **** 	while (data_len > 0) {
 862:../../util/stm_util.c **** 
 863:../../util/stm_util.c **** 		page_address = GET_FLASH_PAGE_ADDRESS(ptr_Address);
 864:../../util/stm_util.c **** 
 865:../../util/stm_util.c **** 		//копируем страницу в буфер
 866:../../util/stm_util.c **** 		memcpy((void *)__flash_buf, (void *)page_address, FLASH_PAGE_SIZE);
 867:../../util/stm_util.c **** 
 868:../../util/stm_util.c **** 		//очищаем страницу
 869:../../util/stm_util.c **** 		erase_error = hal_erase_pages(page_address, 1);
 870:../../util/stm_util.c **** 		if (erase_error == HAL_ERROR) break;
 871:../../util/stm_util.c **** 
 872:../../util/stm_util.c **** 		offset = ptr_Address - page_address; //смещение в странице
 873:../../util/stm_util.c **** 		byte_to_write = FLASH_PAGE_SIZE - offset; //кол-во байтов для записи
 874:../../util/stm_util.c **** 		if (data_len < byte_to_write) byte_to_write = data_len;
 875:../../util/stm_util.c **** 
 876:../../util/stm_util.c **** 		//копируем данные в буфер
 877:../../util/stm_util.c **** 		memcpy((void *)(__flash_buf + offset), (void *)ptr, byte_to_write);
 878:../../util/stm_util.c **** 
 879:../../util/stm_util.c **** 		prog = HAL_OK;
 880:../../util/stm_util.c **** 		//записываем страницу во флэш
 881:../../util/stm_util.c **** 		for (uint16_t j = 0; j < FLASH_PAGE_SIZE / 8; j++) {
 882:../../util/stm_util.c **** 			Data = *(uint64_t *)(__flash_buf + j * 8);
 883:../../util/stm_util.c **** 			prog = HAL_FLASH_Program(FLASH_TYPEPROGRAM_DOUBLEWORD, page_address  + j * 8, Data);
 884:../../util/stm_util.c **** 			FLASH_WaitForLastOperation(FLASH_TIMEOUT_VALUE);  // Ожидаем окончания опер�
 885:../../util/stm_util.c **** 			if (prog != HAL_OK) break;
 886:../../util/stm_util.c **** 		}
 887:../../util/stm_util.c **** 		if (prog != HAL_OK) break;
 888:../../util/stm_util.c **** 
 889:../../util/stm_util.c **** 		data_len -= byte_to_write;
 890:../../util/stm_util.c **** 		ptr += byte_to_write;
 891:../../util/stm_util.c **** 		ptr_Address += byte_to_write;
 892:../../util/stm_util.c **** 	}
 893:../../util/stm_util.c **** 
 894:../../util/stm_util.c **** 	hal_flash_locked();
 895:../../util/stm_util.c **** 
 896:../../util/stm_util.c **** 	return ptr_Address - Address;
 897:../../util/stm_util.c **** }
