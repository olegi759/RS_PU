 951:../../util/stm_util.c ****     memcpy(__flash_buf + __flash_buf_pos, ptr, byte_write); //копирум данные в буф
 952:../../util/stm_util.c ****     len -= byte_write;
 953:../../util/stm_util.c ****     __flash_buf_pos += byte_write;
 954:../../util/stm_util.c ****     ptr += byte_write;
