 503:../../libmad/layer3.c **** /*
 504:../../libmad/layer3.c ****  * NAME:	III_sideinfo()
 505:../../libmad/layer3.c ****  * DESCRIPTION:	decode frame side information from a bitstream
 506:../../libmad/layer3.c ****  */
 507:../../libmad/layer3.c **** static
 508:../../libmad/layer3.c **** enum mad_error III_sideinfo(struct mad_bitptr *ptr, unsigned int nch,
 509:../../libmad/layer3.c **** 			    int lsf, struct sideinfo *si,
 510:../../libmad/layer3.c **** 			    unsigned int *data_bitlen,
 511:../../libmad/layer3.c **** 			    unsigned int *priv_bitlen)
 512:../../libmad/layer3.c **** {
 513:../../libmad/layer3.c ****   unsigned int ngr, gr, ch, i;
 514:../../libmad/layer3.c ****   enum mad_error result = MAD_ERROR_NONE;
 515:../../libmad/layer3.c **** 
 516:../../libmad/layer3.c ****   *data_bitlen = 0;
 517:../../libmad/layer3.c ****   *priv_bitlen = lsf ? ((nch == 1) ? 1 : 2) : ((nch == 1) ? 5 : 3);
 518:../../libmad/layer3.c **** 
 519:../../libmad/layer3.c ****   si->main_data_begin = mad_bit_read(ptr, lsf ? 8 : 9);
 520:../../libmad/layer3.c ****   si->private_bits    = mad_bit_read(ptr, *priv_bitlen);
 521:../../libmad/layer3.c **** 
 522:../../libmad/layer3.c ****   ngr = 1;
 523:../../libmad/layer3.c ****   if (!lsf) {
 524:../../libmad/layer3.c ****     ngr = 2;
 525:../../libmad/layer3.c **** 
 526:../../libmad/layer3.c ****     for (ch = 0; ch < nch; ++ch)
 527:../../libmad/layer3.c ****       si->scfsi[ch] = mad_bit_read(ptr, 4);
 528:../../libmad/layer3.c ****   }
 529:../../libmad/layer3.c **** 
 530:../../libmad/layer3.c ****   for (gr = 0; gr < ngr; ++gr) {
 531:../../libmad/layer3.c ****     struct granule *granule = &si->gr[gr];
 532:../../libmad/layer3.c **** 
 533:../../libmad/layer3.c ****     for (ch = 0; ch < nch; ++ch) {
 534:../../libmad/layer3.c ****       struct channel *channel = &granule->ch[ch];
 535:../../libmad/layer3.c **** 
 536:../../libmad/layer3.c ****       channel->part2_3_length    = mad_bit_read(ptr, 12);
 537:../../libmad/layer3.c ****       channel->big_values        = mad_bit_read(ptr, 9);
 538:../../libmad/layer3.c ****       channel->global_gain       = mad_bit_read(ptr, 8);
 539:../../libmad/layer3.c ****       channel->scalefac_compress = mad_bit_read(ptr, lsf ? 9 : 4);
 540:../../libmad/layer3.c **** 
 541:../../libmad/layer3.c ****       *data_bitlen += channel->part2_3_length;
 542:../../libmad/layer3.c **** 
 543:../../libmad/layer3.c ****       if (channel->big_values > 288 && result == 0)
 544:../../libmad/layer3.c **** 	result = MAD_ERROR_BADBIGVALUES;
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccKOSoMu.s 			page 11


 545:../../libmad/layer3.c **** 
 546:../../libmad/layer3.c ****       channel->flags = 0;
 547:../../libmad/layer3.c **** 
 548:../../libmad/layer3.c ****       /* window_switching_flag */
 549:../../libmad/layer3.c ****       if (mad_bit_read(ptr, 1)) {
 550:../../libmad/layer3.c **** 	channel->block_type = mad_bit_read(ptr, 2);
 551:../../libmad/layer3.c **** 
 552:../../libmad/layer3.c **** 	if (channel->block_type == 0 && result == 0)
 553:../../libmad/layer3.c **** 	  result = MAD_ERROR_BADBLOCKTYPE;
 554:../../libmad/layer3.c **** 
 555:../../libmad/layer3.c **** 	if (!lsf && channel->block_type == 2 && si->scfsi[ch] && result == 0)
 556:../../libmad/layer3.c **** 	  result = MAD_ERROR_BADSCFSI;
 557:../../libmad/layer3.c **** 
 558:../../libmad/layer3.c **** 	channel->region0_count = 7;
 559:../../libmad/layer3.c **** 	channel->region1_count = 36;
 560:../../libmad/layer3.c **** 
 561:../../libmad/layer3.c **** 	if (mad_bit_read(ptr, 1))
 562:../../libmad/layer3.c **** 	  channel->flags |= mixed_block_flag;
 563:../../libmad/layer3.c **** 	else if (channel->block_type == 2)
 564:../../libmad/layer3.c **** 	  channel->region0_count = 8;
 565:../../libmad/layer3.c **** 
 566:../../libmad/layer3.c **** 	for (i = 0; i < 2; ++i)
 567:../../libmad/layer3.c **** 	  channel->table_select[i] = mad_bit_read(ptr, 5);
 568:../../libmad/layer3.c **** 
 569:../../libmad/layer3.c **** # if defined(DEBUG)
 570:../../libmad/layer3.c **** 	channel->table_select[2] = 4;  /* not used */
 571:../../libmad/layer3.c **** # endif
 572:../../libmad/layer3.c **** 
 573:../../libmad/layer3.c **** 	for (i = 0; i < 3; ++i)
 574:../../libmad/layer3.c **** 	  channel->subblock_gain[i] = mad_bit_read(ptr, 3);
 575:../../libmad/layer3.c ****       }
 576:../../libmad/layer3.c ****       else {
 577:../../libmad/layer3.c **** 	channel->block_type = 0;
 578:../../libmad/layer3.c **** 
 579:../../libmad/layer3.c **** 	for (i = 0; i < 3; ++i)
 580:../../libmad/layer3.c **** 	  channel->table_select[i] = mad_bit_read(ptr, 5);
 581:../../libmad/layer3.c **** 
 582:../../libmad/layer3.c **** 	channel->region0_count = mad_bit_read(ptr, 4);
 583:../../libmad/layer3.c **** 	channel->region1_count = mad_bit_read(ptr, 3);
 584:../../libmad/layer3.c ****       }
 585:../../libmad/layer3.c **** 
 586:../../libmad/layer3.c ****       /* [preflag,] scalefac_scale, count1table_select */
 587:../../libmad/layer3.c ****       channel->flags |= mad_bit_read(ptr, lsf ? 2 : 3);
 588:../../libmad/layer3.c ****     }
 589:../../libmad/layer3.c ****   }
 590:../../libmad/layer3.c **** 
 591:../../libmad/layer3.c ****   return result;
 592:../../libmad/layer3.c **** }
