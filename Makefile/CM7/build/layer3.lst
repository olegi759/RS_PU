 785:../../libmad/layer3.c **** /*
 786:../../libmad/layer3.c ****  * The Layer III formula for requantization and scaling is defined by
 787:../../libmad/layer3.c ****  * section 2.4.3.4.7.1 of ISO/IEC 11172-3, as follows:
 788:../../libmad/layer3.c ****  *
 789:../../libmad/layer3.c ****  *   long blocks:
 790:../../libmad/layer3.c ****  *   xr[i] = sign(is[i]) * abs(is[i])^(4/3) *
 791:../../libmad/layer3.c ****  *           2^((1/4) * (global_gain - 210)) *
 792:../../libmad/layer3.c ****  *           2^-(scalefac_multiplier *
 793:../../libmad/layer3.c ****  *               (scalefac_l[sfb] + preflag * pretab[sfb]))
 794:../../libmad/layer3.c ****  *
 795:../../libmad/layer3.c ****  *   short blocks:
 796:../../libmad/layer3.c ****  *   xr[i] = sign(is[i]) * abs(is[i])^(4/3) *
 797:../../libmad/layer3.c ****  *           2^((1/4) * (global_gain - 210 - 8 * subblock_gain[w])) *
 798:../../libmad/layer3.c ****  *           2^-(scalefac_multiplier * scalefac_s[sfb][w])
 799:../../libmad/layer3.c ****  *
 800:../../libmad/layer3.c ****  *   where:
 801:../../libmad/layer3.c ****  *   scalefac_multiplier = (scalefac_scale + 1) / 2
 802:../../libmad/layer3.c ****  *
 803:../../libmad/layer3.c ****  * The routines III_exponents() and III_requantize() facilitate this
 804:../../libmad/layer3.c ****  * calculation.
 805:../../libmad/layer3.c ****  */
