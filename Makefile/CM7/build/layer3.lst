2443:../../libmad/layer3.c **** 
2444:../../libmad/layer3.c ****       /* subbands 0-1 */
2445:../../libmad/layer3.c **** 
2446:../../libmad/layer3.c ****       if (channel->block_type != 2 || (channel->flags & mixed_block_flag)) {
