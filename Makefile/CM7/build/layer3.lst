2450:../../libmad/layer3.c **** 	if (channel->flags & mixed_block_flag)
2451:../../libmad/layer3.c **** 	  block_type = 0;
2452:../../libmad/layer3.c **** 
2453:../../libmad/layer3.c **** 	/* long blocks */
2454:../../libmad/layer3.c **** 	for (sb = 0; sb < 2; ++sb, l += 18) {
2455:../../libmad/layer3.c **** 	  III_imdct_l(&xr[ch][l], output, block_type);
2456:../../libmad/layer3.c **** 	  III_overlap(output, (*frame->overlap)[ch][sb], sample, sb);
2457:../../libmad/layer3.c **** 	}
2458:../../libmad/layer3.c ****       }
2459:../../libmad/layer3.c ****       else {
2460:../../libmad/layer3.c **** 	/* short blocks */
2461:../../libmad/layer3.c **** 	for (sb = 0; sb < 2; ++sb, l += 18) {
2462:../../libmad/layer3.c **** 	  III_imdct_s(&xr[ch][l], output);
2463:../../libmad/layer3.c **** 	  III_overlap(output, (*frame->overlap)[ch][sb], sample, sb);
2464:../../libmad/layer3.c **** 	}
2465:../../libmad/layer3.c ****       }
2466:../../libmad/layer3.c **** 
2467:../../libmad/layer3.c ****       III_freqinver(sample, 1);
