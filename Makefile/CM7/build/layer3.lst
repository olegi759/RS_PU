2428:../../libmad/layer3.c **** 	/*
2429:../../libmad/layer3.c **** 	 * According to ISO/IEC 11172-3, "Alias reduction is not applied for
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccKOSoMu.s 			page 182


2430:../../libmad/layer3.c **** 	 * granules with block_type == 2 (short block)." However, other
2431:../../libmad/layer3.c **** 	 * sources suggest alias reduction should indeed be performed on the
2432:../../libmad/layer3.c **** 	 * lower two subbands of mixed blocks. Most other implementations do
2433:../../libmad/layer3.c **** 	 * this, so by default we will too.
2434:../../libmad/layer3.c **** 	 */
2435:../../libmad/layer3.c **** 	if (channel->flags & mixed_block_flag)
2436:../../libmad/layer3.c **** 	  III_aliasreduce(xr[ch], 36);
2437:../../libmad/layer3.c **** # endif
2438:../../libmad/layer3.c ****       }
2439:../../libmad/layer3.c ****       else
2440:../../libmad/layer3.c **** 	III_aliasreduce(xr[ch], 576);
2441:../../libmad/layer3.c **** 
