2416:../../libmad/layer3.c ****     /* reordering, alias reduction, IMDCT, overlap-add, frequency inversion */
2417:../../libmad/layer3.c **** 
2418:../../libmad/layer3.c ****     for (ch = 0; ch < nch; ++ch) {
2419:../../libmad/layer3.c ****       struct channel const *channel = &granule->ch[ch];
2420:../../libmad/layer3.c ****       mad_fixed_t (*sample)[32] = &frame->sbsample[ch][18 * gr];
