  33:../../opus/src/opus.c **** #ifndef DISABLE_FLOAT_API
  34:../../opus/src/opus.c **** OPUS_EXPORT void opus_pcm_soft_clip(float *_x, int N, int C, float *declip_mem)
  35:../../opus/src/opus.c **** {
  36:../../opus/src/opus.c ****    int c;
  37:../../opus/src/opus.c ****    int i;
  38:../../opus/src/opus.c ****    float *x;
  39:../../opus/src/opus.c **** 
  40:../../opus/src/opus.c ****    if (C<1 || N<1 || !_x || !declip_mem) return;
  41:../../opus/src/opus.c **** 
  42:../../opus/src/opus.c ****    /* First thing: saturate everything to +/- 2 which is the highest level our
  43:../../opus/src/opus.c ****       non-linearity can handle. At the point where the signal reaches +/-2,
  44:../../opus/src/opus.c ****       the derivative will be zero anyway, so this doesn't introduce any
  45:../../opus/src/opus.c ****       discontinuity in the derivative. */
  46:../../opus/src/opus.c ****    for (i=0;i<N*C;i++)
  47:../../opus/src/opus.c ****       _x[i] = MAX16(-2.f, MIN16(2.f, _x[i]));
  48:../../opus/src/opus.c ****    for (c=0;c<C;c++)
  49:../../opus/src/opus.c ****    {
  50:../../opus/src/opus.c ****       float a;
  51:../../opus/src/opus.c ****       float x0;
  52:../../opus/src/opus.c ****       int curr;
  53:../../opus/src/opus.c **** 
  54:../../opus/src/opus.c ****       x = _x+c;
  55:../../opus/src/opus.c ****       a = declip_mem[c];
  56:../../opus/src/opus.c ****       /* Continue applying the non-linearity from the previous frame to avoid
  57:../../opus/src/opus.c ****          any discontinuity. */
  58:../../opus/src/opus.c ****       for (i=0;i<N;i++)
  59:../../opus/src/opus.c ****       {
  60:../../opus/src/opus.c ****          if (x[i*C]*a>=0)
  61:../../opus/src/opus.c ****             break;
  62:../../opus/src/opus.c ****          x[i*C] = x[i*C]+a*x[i*C]*x[i*C];
  63:../../opus/src/opus.c ****       }
  64:../../opus/src/opus.c **** 
  65:../../opus/src/opus.c ****       curr=0;
  66:../../opus/src/opus.c ****       x0 = x[0];
  67:../../opus/src/opus.c ****       while(1)
  68:../../opus/src/opus.c ****       {
  69:../../opus/src/opus.c ****          int start, end;
  70:../../opus/src/opus.c ****          float maxval;
  71:../../opus/src/opus.c ****          int special=0;
  72:../../opus/src/opus.c ****          int peak_pos;
  73:../../opus/src/opus.c ****          for (i=curr;i<N;i++)
  74:../../opus/src/opus.c ****          {
  75:../../opus/src/opus.c ****             if (x[i*C]>1 || x[i*C]<-1)
  76:../../opus/src/opus.c ****                break;
  77:../../opus/src/opus.c ****          }
  78:../../opus/src/opus.c ****          if (i==N)
  79:../../opus/src/opus.c ****          {
  80:../../opus/src/opus.c ****             a=0;
  81:../../opus/src/opus.c ****             break;
  82:../../opus/src/opus.c ****          }
  83:../../opus/src/opus.c ****          peak_pos = i;
  84:../../opus/src/opus.c ****          start=end=i;
  85:../../opus/src/opus.c ****          maxval=ABS16(x[i*C]);
  86:../../opus/src/opus.c ****          /* Look for first zero crossing before clipping */
  87:../../opus/src/opus.c ****          while (start>0 && x[i*C]*x[(start-1)*C]>=0)
  88:../../opus/src/opus.c ****             start--;
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccF4SaMs.s 			page 3


  89:../../opus/src/opus.c ****          /* Look for first zero crossing after clipping */
  90:../../opus/src/opus.c ****          while (end<N && x[i*C]*x[end*C]>=0)
  91:../../opus/src/opus.c ****          {
  92:../../opus/src/opus.c ****             /* Look for other peaks until the next zero-crossing. */
  93:../../opus/src/opus.c ****             if (ABS16(x[end*C])>maxval)
  94:../../opus/src/opus.c ****             {
  95:../../opus/src/opus.c ****                maxval = ABS16(x[end*C]);
  96:../../opus/src/opus.c ****                peak_pos = end;
  97:../../opus/src/opus.c ****             }
  98:../../opus/src/opus.c ****             end++;
  99:../../opus/src/opus.c ****          }
 100:../../opus/src/opus.c ****          /* Detect the special case where we clip before the first zero crossing */
 101:../../opus/src/opus.c ****          special = (start==0 && x[i*C]*x[0]>=0);
 102:../../opus/src/opus.c **** 
 103:../../opus/src/opus.c ****          /* Compute a such that maxval + a*maxval^2 = 1 */
 104:../../opus/src/opus.c ****          a=(maxval-1)/(maxval*maxval);
 105:../../opus/src/opus.c ****          /* Slightly boost "a" by 2^-22. This is just enough to ensure -ffast-math
 106:../../opus/src/opus.c ****             does not cause output values larger than +/-1, but small enough not
 107:../../opus/src/opus.c ****             to matter even for 24-bit output.  */
 108:../../opus/src/opus.c ****          a += a*2.4e-7f;
 109:../../opus/src/opus.c ****          if (x[i*C]>0)
 110:../../opus/src/opus.c ****             a = -a;
 111:../../opus/src/opus.c ****          /* Apply soft clipping */
 112:../../opus/src/opus.c ****          for (i=start;i<end;i++)
 113:../../opus/src/opus.c ****             x[i*C] = x[i*C]+a*x[i*C]*x[i*C];
 114:../../opus/src/opus.c **** 
 115:../../opus/src/opus.c ****          if (special && peak_pos>=2)
 116:../../opus/src/opus.c ****          {
 117:../../opus/src/opus.c ****             /* Add a linear ramp from the first sample to the signal peak.
 118:../../opus/src/opus.c ****                This avoids a discontinuity at the beginning of the frame. */
 119:../../opus/src/opus.c ****             float delta;
 120:../../opus/src/opus.c ****             float offset = x0-x[0];
 121:../../opus/src/opus.c ****             delta = offset / peak_pos;
 122:../../opus/src/opus.c ****             for (i=curr;i<peak_pos;i++)
 123:../../opus/src/opus.c ****             {
 124:../../opus/src/opus.c ****                offset -= delta;
 125:../../opus/src/opus.c ****                x[i*C] += offset;
 126:../../opus/src/opus.c ****                x[i*C] = MAX16(-1.f, MIN16(1.f, x[i*C]));
 127:../../opus/src/opus.c ****             }
 128:../../opus/src/opus.c ****          }
 129:../../opus/src/opus.c ****          curr = end;
 130:../../opus/src/opus.c ****          if (curr==N)
 131:../../opus/src/opus.c ****             break;
 132:../../opus/src/opus.c ****       }
 133:../../opus/src/opus.c ****       declip_mem[c] = a;
 134:../../opus/src/opus.c ****    }
 135:../../opus/src/opus.c **** }
 136:../../opus/src/opus.c **** #endif
