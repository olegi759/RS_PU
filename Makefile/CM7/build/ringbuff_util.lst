 111:../../util/ringbuff_util.c **** /**
 112:../../util/ringbuff_util.c ****  * \brief           Write data to buffer.
 113:../../util/ringbuff_util.c ****  * Copies data from `data` array to buffer and marks buffer as full for maximum `btw` number of byt
 114:../../util/ringbuff_util.c ****  *
 115:../../util/ringbuff_util.c ****  * \param[in]       buff: Buffer handle
 116:../../util/ringbuff_util.c ****  * \param[in]       data: Pointer to data to write into buffer
 117:../../util/ringbuff_util.c ****  * \param[in]       btw: Number of bytes to write
 118:../../util/ringbuff_util.c ****  * \return          Number of bytes written to buffer.
 119:../../util/ringbuff_util.c ****  *                      When returned value is less than `btw`, there was no enough memory availabl
 120:../../util/ringbuff_util.c ****  *                      to copy full data array
 121:../../util/ringbuff_util.c ****  */
 122:../../util/ringbuff_util.c **** size_t
 123:../../util/ringbuff_util.c **** ringbuff_write(RINGBUFF_VOLATILE ringbuff_t* buff, const void* data, size_t btw) {
 124:../../util/ringbuff_util.c ****     size_t tocopy, free;
 125:../../util/ringbuff_util.c ****     const uint8_t* d = data;
 126:../../util/ringbuff_util.c **** 
 127:../../util/ringbuff_util.c ****     if (!BUF_IS_VALID(buff) || data == NULL || btw == 0) {
 128:../../util/ringbuff_util.c ****         return 0;
 129:../../util/ringbuff_util.c ****     }
 130:../../util/ringbuff_util.c **** 
 131:../../util/ringbuff_util.c ****     /* Calculate maximum number of bytes available to write */
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccBv7duL.s 			page 9


 132:../../util/ringbuff_util.c ****     free = ringbuff_get_free(buff);
 133:../../util/ringbuff_util.c ****     btw = BUF_MIN(free, btw);
 134:../../util/ringbuff_util.c ****     if (btw == 0) {
 135:../../util/ringbuff_util.c ****         return 0;
 136:../../util/ringbuff_util.c ****     }
 137:../../util/ringbuff_util.c **** 
 138:../../util/ringbuff_util.c ****     /* Step 1: Write data to linear part of buffer */
 139:../../util/ringbuff_util.c ****     tocopy = BUF_MIN(buff->size - buff->w, btw);
 140:../../util/ringbuff_util.c ****     BUF_MEMCPY(&buff->buff[buff->w], d, tocopy);
 141:../../util/ringbuff_util.c ****     buff->w += tocopy;
 142:../../util/ringbuff_util.c ****     btw -= tocopy;
 143:../../util/ringbuff_util.c **** 
 144:../../util/ringbuff_util.c ****     /* Step 2: Write data to beginning of buffer (overflow part) */
 145:../../util/ringbuff_util.c ****     if (btw > 0) {
 146:../../util/ringbuff_util.c ****         BUF_MEMCPY(buff->buff, &d[tocopy], btw);
 147:../../util/ringbuff_util.c ****         buff->w = btw;
 148:../../util/ringbuff_util.c ****     }
 149:../../util/ringbuff_util.c **** 
 150:../../util/ringbuff_util.c ****     /* Step 3: Check end of buffer */
 151:../../util/ringbuff_util.c ****     if (buff->w >= buff->size) {
 152:../../util/ringbuff_util.c ****         buff->w = 0;
 153:../../util/ringbuff_util.c ****     }
 154:../../util/ringbuff_util.c ****     BUF_SEND_EVT(buff, RINGBUFF_EVT_WRITE, tocopy + btw);
 155:../../util/ringbuff_util.c ****     return tocopy + btw;
 156:../../util/ringbuff_util.c **** }
