 239:../../util/ringbuff_util.c ****     }
 240:../../util/ringbuff_util.c **** 
 241:../../util/ringbuff_util.c ****     /* Step 1: Read data from linear part of buffer */
 242:../../util/ringbuff_util.c ****     tocopy = BUF_MIN(buff->size - r, btp);
 243:../../util/ringbuff_util.c ****     BUF_MEMCPY(d, &buff->buff[r], tocopy);
