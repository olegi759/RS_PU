 220:../../util/ringbuff_util.c ****     r = buff->r;
 221:../../util/ringbuff_util.c **** 
 222:../../util/ringbuff_util.c ****     /* Calculate maximum number of bytes available to read */
 223:../../util/ringbuff_util.c ****     full = ringbuff_get_full(buff);
 224:../../util/ringbuff_util.c **** 
 225:../../util/ringbuff_util.c ****     /* Skip beginning of buffer */
