 203:../../util/ringbuff_util.c **** /**
 204:../../util/ringbuff_util.c ****  * \brief           Read from buffer without changing read pointer (peek only)
 205:../../util/ringbuff_util.c ****  * \param[in]       buff: Buffer handle
 206:../../util/ringbuff_util.c ****  * \param[in]       skip_count: Number of bytes to skip before reading data
 207:../../util/ringbuff_util.c ****  * \param[out]      data: Pointer to output memory to copy buffer data to
 208:../../util/ringbuff_util.c ****  * \param[in]       btp: Number of bytes to peek
 209:../../util/ringbuff_util.c ****  * \return          Number of bytes peeked and written to output array
 210:../../util/ringbuff_util.c ****  */
 211:../../util/ringbuff_util.c **** size_t
 212:../../util/ringbuff_util.c **** ringbuff_peek(RINGBUFF_VOLATILE ringbuff_t* buff, size_t skip_count, void* data, size_t btp) {
 213:../../util/ringbuff_util.c ****     size_t full, tocopy, r;
 214:../../util/ringbuff_util.c ****     uint8_t *d = data;
 215:../../util/ringbuff_util.c **** 
 216:../../util/ringbuff_util.c ****     if (!BUF_IS_VALID(buff) || data == NULL || btp == 0) {
