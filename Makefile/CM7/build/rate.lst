  50:../../opus/celt/rate.c **** /*Determines if V(N,K) fits in a 32-bit unsigned integer.
  51:../../opus/celt/rate.c ****   N and K are themselves limited to 15 bits.*/
  52:../../opus/celt/rate.c **** static int fits_in32(int _n, int _k)
  53:../../opus/celt/rate.c **** {
  54:../../opus/celt/rate.c ****    static const opus_int16 maxN[15] = {
  55:../../opus/celt/rate.c ****       32767, 32767, 32767, 1476, 283, 109,  60,  40,
  56:../../opus/celt/rate.c ****        29,  24,  20,  18,  16,  14,  13};
  57:../../opus/celt/rate.c ****    static const opus_int16 maxK[15] = {
  58:../../opus/celt/rate.c ****       32767, 32767, 32767, 32767, 1172, 238,  95,  53,
  59:../../opus/celt/rate.c ****        36,  27,  22,  18,  16,  15,  13};
  60:../../opus/celt/rate.c ****    if (_n>=14)
  61:../../opus/celt/rate.c ****    {
  62:../../opus/celt/rate.c ****       if (_k>=14)
  63:../../opus/celt/rate.c ****          return 0;
  64:../../opus/celt/rate.c ****       else
  65:../../opus/celt/rate.c ****          return _n <= maxN[_k];
  66:../../opus/celt/rate.c ****    } else {
  67:../../opus/celt/rate.c ****       return _k <= maxK[_n];
  68:../../opus/celt/rate.c ****    }
  69:../../opus/celt/rate.c **** }
