  44:../../opus/celt/entcode.h **** /*OPT: ec_window must be at least 32 bits, but if you have fast arithmetic on a
  45:../../opus/celt/entcode.h ****    larger type, you can speed up the decoder by using it here.*/
  46:../../opus/celt/entcode.h **** typedef opus_uint32           ec_window;
  47:../../opus/celt/entcode.h **** typedef struct ec_ctx         ec_ctx;
  48:../../opus/celt/entcode.h **** typedef struct ec_ctx         ec_enc;
  49:../../opus/celt/entcode.h **** typedef struct ec_ctx         ec_dec;
  50:../../opus/celt/entcode.h **** 
  51:../../opus/celt/entcode.h **** # define EC_WINDOW_SIZE ((int)sizeof(ec_window)*CHAR_BIT)
  52:../../opus/celt/entcode.h **** 
  53:../../opus/celt/entcode.h **** /*The number of bits to use for the range-coded part of unsigned integers.*/
  54:../../opus/celt/entcode.h **** # define EC_UINT_BITS   (8)
  55:../../opus/celt/entcode.h **** 
  56:../../opus/celt/entcode.h **** /*The resolution of fractional-precision bit usage measurements, i.e.,
  57:../../opus/celt/entcode.h ****    3 => 1/8th bits.*/
  58:../../opus/celt/entcode.h **** # define BITRES 3
  59:../../opus/celt/entcode.h **** 
  60:../../opus/celt/entcode.h **** /*The entropy encoder/decoder context.
  61:../../opus/celt/entcode.h ****   We use the same structure for both, so that common functions like ec_tell()
  62:../../opus/celt/entcode.h ****    can be used on either one.*/
  63:../../opus/celt/entcode.h **** struct ec_ctx{
  64:../../opus/celt/entcode.h ****    /*Buffered input/output.*/
  65:../../opus/celt/entcode.h ****    unsigned char *buf;
  66:../../opus/celt/entcode.h ****    /*The size of the buffer.*/
  67:../../opus/celt/entcode.h ****    opus_uint32    storage;
  68:../../opus/celt/entcode.h ****    /*The offset at which the last byte containing raw bits was read/written.*/
  69:../../opus/celt/entcode.h ****    opus_uint32    end_offs;
  70:../../opus/celt/entcode.h ****    /*Bits that will be read from/written at the end.*/
  71:../../opus/celt/entcode.h ****    ec_window      end_window;
  72:../../opus/celt/entcode.h ****    /*Number of valid bits in end_window.*/
  73:../../opus/celt/entcode.h ****    int            nend_bits;
  74:../../opus/celt/entcode.h ****    /*The total number of whole bits read/written.
  75:../../opus/celt/entcode.h ****      This does not include partial bits currently in the range coder.*/
  76:../../opus/celt/entcode.h ****    int            nbits_total;
  77:../../opus/celt/entcode.h ****    /*The offset at which the next range coder byte will be read/written.*/
  78:../../opus/celt/entcode.h ****    opus_uint32    offs;
  79:../../opus/celt/entcode.h ****    /*The number of values in the current range.*/
  80:../../opus/celt/entcode.h ****    opus_uint32    rng;
  81:../../opus/celt/entcode.h ****    /*In the decoder: the difference between the top of the current range and
  82:../../opus/celt/entcode.h ****       the input value, minus one.
  83:../../opus/celt/entcode.h ****      In the encoder: the low end of the current range.*/
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccPN0kdb.s 			page 20


  84:../../opus/celt/entcode.h ****    opus_uint32    val;
  85:../../opus/celt/entcode.h ****    /*In the decoder: the saved normalization factor from ec_decode().
  86:../../opus/celt/entcode.h ****      In the encoder: the number of oustanding carry propagating symbols.*/
  87:../../opus/celt/entcode.h ****    opus_uint32    ext;
  88:../../opus/celt/entcode.h ****    /*A buffered input/output symbol, awaiting carry propagation.*/
  89:../../opus/celt/entcode.h ****    int            rem;
  90:../../opus/celt/entcode.h ****    /*Nonzero if an error occurred.*/
  91:../../opus/celt/entcode.h ****    int            error;
  92:../../opus/celt/entcode.h **** };
  93:../../opus/celt/entcode.h **** 
  94:../../opus/celt/entcode.h **** static OPUS_INLINE opus_uint32 ec_range_bytes(ec_ctx *_this){
  95:../../opus/celt/entcode.h ****   return _this->offs;
  96:../../opus/celt/entcode.h **** }
  97:../../opus/celt/entcode.h **** 
  98:../../opus/celt/entcode.h **** static OPUS_INLINE unsigned char *ec_get_buffer(ec_ctx *_this){
  99:../../opus/celt/entcode.h ****   return _this->buf;
 100:../../opus/celt/entcode.h **** }
 101:../../opus/celt/entcode.h **** 
 102:../../opus/celt/entcode.h **** static OPUS_INLINE int ec_get_error(ec_ctx *_this){
 103:../../opus/celt/entcode.h ****   return _this->error;
 104:../../opus/celt/entcode.h **** }
 105:../../opus/celt/entcode.h **** 
 106:../../opus/celt/entcode.h **** /*Returns the number of bits "used" by the encoded or decoded symbols so far.
 107:../../opus/celt/entcode.h ****   This same number can be computed in either the encoder or the decoder, and is
 108:../../opus/celt/entcode.h ****    suitable for making coding decisions.
 109:../../opus/celt/entcode.h ****   Return: The number of bits.
 110:../../opus/celt/entcode.h ****           This will always be slightly larger than the exact value (e.g., all
 111:../../opus/celt/entcode.h ****            rounding error is in the positive direction).*/
 112:../../opus/celt/entcode.h **** static OPUS_INLINE int ec_tell(ec_ctx *_this){
 113:../../opus/celt/entcode.h ****   return _this->nbits_total-EC_ILOG(_this->rng);
 114:../../opus/celt/entcode.h **** }
 115:../../opus/celt/entcode.h **** 
 116:../../opus/celt/entcode.h **** /*Returns the number of bits "used" by the encoded or decoded symbols so far.
 117:../../opus/celt/entcode.h ****   This same number can be computed in either the encoder or the decoder, and is
 118:../../opus/celt/entcode.h ****    suitable for making coding decisions.
 119:../../opus/celt/entcode.h ****   Return: The number of bits scaled by 2**BITRES.
 120:../../opus/celt/entcode.h ****           This will always be slightly larger than the exact value (e.g., all
 121:../../opus/celt/entcode.h ****            rounding error is in the positive direction).*/
 122:../../opus/celt/entcode.h **** opus_uint32 ec_tell_frac(ec_ctx *_this);
