  47:../../opus/silk/fixed/encode_frame_FIX.c **** {
  48:../../opus/silk/fixed/encode_frame_FIX.c ****     const opus_int activity_threshold = SILK_FIX_CONST( SPEECH_ACTIVITY_DTX_THRES, 8 );
  49:../../opus/silk/fixed/encode_frame_FIX.c **** 
  50:../../opus/silk/fixed/encode_frame_FIX.c ****     /****************************/
  51:../../opus/silk/fixed/encode_frame_FIX.c ****     /* Voice Activity Detection */
  52:../../opus/silk/fixed/encode_frame_FIX.c ****     /****************************/
  53:../../opus/silk/fixed/encode_frame_FIX.c ****     silk_VAD_GetSA_Q8( &psEnc->sCmn, psEnc->sCmn.inputBuf + 1, psEnc->sCmn.arch );
  54:../../opus/silk/fixed/encode_frame_FIX.c ****     /* If Opus VAD is inactive and Silk VAD is active: lower Silk VAD to just under the threshold *
  55:../../opus/silk/fixed/encode_frame_FIX.c ****     if( activity == VAD_NO_ACTIVITY && psEnc->sCmn.speech_activity_Q8 >= activity_threshold ) {
  56:../../opus/silk/fixed/encode_frame_FIX.c ****         psEnc->sCmn.speech_activity_Q8 = activity_threshold - 1;
  57:../../opus/silk/fixed/encode_frame_FIX.c ****     }
  58:../../opus/silk/fixed/encode_frame_FIX.c **** 
  59:../../opus/silk/fixed/encode_frame_FIX.c ****     /**************************************************/
  60:../../opus/silk/fixed/encode_frame_FIX.c ****     /* Convert speech activity into VAD and DTX flags */
  61:../../opus/silk/fixed/encode_frame_FIX.c ****     /**************************************************/
  62:../../opus/silk/fixed/encode_frame_FIX.c ****     if( psEnc->sCmn.speech_activity_Q8 < activity_threshold ) {
  63:../../opus/silk/fixed/encode_frame_FIX.c ****         psEnc->sCmn.indices.signalType = TYPE_NO_VOICE_ACTIVITY;
  64:../../opus/silk/fixed/encode_frame_FIX.c ****         psEnc->sCmn.noSpeechCounter++;
  65:../../opus/silk/fixed/encode_frame_FIX.c ****         if( psEnc->sCmn.noSpeechCounter <= NB_SPEECH_FRAMES_BEFORE_DTX ) {
  66:../../opus/silk/fixed/encode_frame_FIX.c ****             psEnc->sCmn.inDTX = 0;
  67:../../opus/silk/fixed/encode_frame_FIX.c ****         } else if( psEnc->sCmn.noSpeechCounter > MAX_CONSECUTIVE_DTX + NB_SPEECH_FRAMES_BEFORE_DTX 
  68:../../opus/silk/fixed/encode_frame_FIX.c ****             psEnc->sCmn.noSpeechCounter = NB_SPEECH_FRAMES_BEFORE_DTX;
  69:../../opus/silk/fixed/encode_frame_FIX.c ****             psEnc->sCmn.inDTX           = 0;
  70:../../opus/silk/fixed/encode_frame_FIX.c ****         }
  71:../../opus/silk/fixed/encode_frame_FIX.c ****         psEnc->sCmn.VAD_flags[ psEnc->sCmn.nFramesEncoded ] = 0;
  72:../../opus/silk/fixed/encode_frame_FIX.c ****     } else {
  73:../../opus/silk/fixed/encode_frame_FIX.c ****         psEnc->sCmn.noSpeechCounter    = 0;
  74:../../opus/silk/fixed/encode_frame_FIX.c ****         psEnc->sCmn.inDTX              = 0;
  75:../../opus/silk/fixed/encode_frame_FIX.c ****         psEnc->sCmn.indices.signalType = TYPE_UNVOICED;
  76:../../opus/silk/fixed/encode_frame_FIX.c ****         psEnc->sCmn.VAD_flags[ psEnc->sCmn.nFramesEncoded ] = 1;
  77:../../opus/silk/fixed/encode_frame_FIX.c ****     }
  78:../../opus/silk/fixed/encode_frame_FIX.c **** }
