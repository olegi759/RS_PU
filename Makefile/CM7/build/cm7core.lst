 254:../../CM7/Core/Src/cm7core.c **** //парсинг от ядра СМ4 комманды
 255:../../CM7/Core/Src/cm7core.c **** void cm7core_rcv_from_CM4(uint8_t * packet, uint16_t packet_len)
 256:../../CM7/Core/Src/cm7core.c **** {
 257:../../CM7/Core/Src/cm7core.c **** 
 258:../../CM7/Core/Src/cm7core.c **** 	packet[packet_len] = 0;
 259:../../CM7/Core/Src/cm7core.c **** 
 260:../../CM7/Core/Src/cm7core.c **** 	switch (packet[0]) {
 261:../../CM7/Core/Src/cm7core.c **** 		case CORE_CMD_CONSOLE_RCV: //от консоли CM4
 262:../../CM7/Core/Src/cm7core.c **** 			cm7_console_rcv((char *)&packet[1]);
 263:../../CM7/Core/Src/cm7core.c **** 		break;
 264:../../CM7/Core/Src/cm7core.c **** 		case CORE_CMD_CHANGE_SETTING:
 265:../../CM7/Core/Src/cm7core.c **** 			memcpy(&setting, &packet[1], MIN(sizeof(setting_t), (packet_len - 1)));
 266:../../CM7/Core/Src/cm7core.c **** 			ulog(CONM"OK_CHANGE_SETTING"CRLF);
 267:../../CM7/Core/Src/cm7core.c **** 			if (!already_change_setting)	{
 268:../../CM7/Core/Src/cm7core.c **** 				ulog_fmt(CONM"setting: SAI volume=%d"CRLF, setting.sai_volume);
 269:../../CM7/Core/Src/cm7core.c **** 				ulog_fmt(CONM"setting: name=%s"CRLF, get_pu_name());
 270:../../CM7/Core/Src/cm7core.c **** 				already_change_setting = TRUE;
 271:../../CM7/Core/Src/cm7core.c **** 
 272:../../CM7/Core/Src/cm7core.c **** 				uarts_transmit_change_mode();
 273:../../CM7/Core/Src/cm7core.c **** 			}
 274:../../CM7/Core/Src/cm7core.c **** 		break;
 275:../../CM7/Core/Src/cm7core.c **** 		break;
 276:../../CM7/Core/Src/cm7core.c **** 		case CORE_CMD_MKI_BUTTON_PRESS:
 277:../../CM7/Core/Src/cm7core.c **** 			screens_button_press(packet[1]);
 278:../../CM7/Core/Src/cm7core.c **** 		break;
 279:../../CM7/Core/Src/cm7core.c **** 		case CORE_CMD_MKI_BUTTON_UNPRESS:
 280:../../CM7/Core/Src/cm7core.c **** 			screens_button_unpress(packet[1]);
 281:../../CM7/Core/Src/cm7core.c **** 		break;
 282:../../CM7/Core/Src/cm7core.c **** 		case CORE_CMD_CHANGE_MKK_INSIG_LIN:
 283:../../CM7/Core/Src/cm7core.c **** 			memcpy(&mkk_insig_lin_replay, &packet[1], MIN(sizeof(mkk_insig_lin_replay), (packet_len - 1)));
 284:../../CM7/Core/Src/cm7core.c **** 			mkk_change_insig_lin();
 285:../../CM7/Core/Src/cm7core.c **** 			ulog(CONM"OK_CHANGE_INSIG_LIN_REPLAY"CRLF);
 286:../../CM7/Core/Src/cm7core.c **** 		break;
 287:../../CM7/Core/Src/cm7core.c **** 		case CORE_CMD_GET_VERSION:
 288:../../CM7/Core/Src/cm7core.c **** 			cm7core_send_to_CM4_cmd(CORE_CMD_GET_VERSION_RESULT, (uint8_t *)VERSION, strlen(VERSION));
 289:../../CM7/Core/Src/cm7core.c **** 		break;
 290:../../CM7/Core/Src/cm7core.c **** 		case CORE_CMD_RTC_UPDATE:
 291:../../CM7/Core/Src/cm7core.c **** 			memcpy(date_time, &packet[1], MIN(sizeof(date_time), (packet_len - 1)));
 292:../../CM7/Core/Src/cm7core.c **** 		break;
 293:../../CM7/Core/Src/cm7core.c **** 		case CORE_CMD_PD_RECV:
 294:../../CM7/Core/Src/cm7core.c **** 			if (packet[1] == setting.uart_local_addr) {
 295:../../CM7/Core/Src/cm7core.c **** 				//в pd_rcv входим только с локальным адресом
 296:../../CM7/Core/Src/cm7core.c **** 				pd_rcv(&packet[1], packet_len - 1, 0);
 297:../../CM7/Core/Src/cm7core.c **** 			} else {
 298:../../CM7/Core/Src/cm7core.c **** 				packet[2] = packet[2] + setting.uart_local_addr; //шлюз
 299:../../CM7/Core/Src/cm7core.c **** 				count_tx_id++;
 300:../../CM7/Core/Src/cm7core.c **** 				packet[3] = count_tx_id >> 8;
