 352:../../CM7/Core/Src/cm7core.c **** BOOL cm7core_wait_cmd_from_CM4(uint8_t cmd, uint8_t * cmd_data, uint16_t cmd_data_size, uint32_t ti
 353:../../CM7/Core/Src/cm7core.c **** {
 354:../../CM7/Core/Src/cm7core.c **** 	uint32_t start_tick;
 355:../../CM7/Core/Src/cm7core.c **** 	uint16_t packet_len, len;
 356:../../CM7/Core/Src/cm7core.c **** 	uint8_t packet[SM_MAX_PACKET_SIZE];
 357:../../CM7/Core/Src/cm7core.c **** 
 358:../../CM7/Core/Src/cm7core.c **** 	start_tick = HAL_GetTick();
 359:../../CM7/Core/Src/cm7core.c **** 
 360:../../CM7/Core/Src/cm7core.c **** 	while (HAL_DiffTick(start_tick) < timeout) {
 361:../../CM7/Core/Src/cm7core.c **** 		if ( (!sm->rb_cm4_to_cm7.busy) && (ringbuff_get_full(&sm->rb_cm4_to_cm7) > 4) ) {
 362:../../CM7/Core/Src/cm7core.c **** 			sm->rb_cm4_to_cm7.busy = 1;
 363:../../CM7/Core/Src/cm7core.c **** 			packet_len = ringbuff_read_packet(&sm->rb_cm4_to_cm7, packet, sizeof(packet));
 364:../../CM7/Core/Src/cm7core.c **** 			sm->rb_cm4_to_cm7.busy = 0;
 365:../../CM7/Core/Src/cm7core.c **** 			if (packet_len)  {
 366:../../CM7/Core/Src/cm7core.c **** 				if (packet[0] == cmd) {
 367:../../CM7/Core/Src/cm7core.c **** 					len = packet_len - 1;
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccGttwTH.s 			page 13


 368:../../CM7/Core/Src/cm7core.c **** 					if (len > cmd_data_size) len = cmd_data_size;
 369:../../CM7/Core/Src/cm7core.c **** 					if (len) memcpy(cmd_data, &packet[1], len);
 370:../../CM7/Core/Src/cm7core.c **** 					*cmd_data_len = len;
 371:../../CM7/Core/Src/cm7core.c **** 					return TRUE;
 372:../../CM7/Core/Src/cm7core.c **** 				}
 373:../../CM7/Core/Src/cm7core.c **** 				cm7core_rcv_from_CM4(packet, packet_len);
 374:../../CM7/Core/Src/cm7core.c **** 			}
 375:../../CM7/Core/Src/cm7core.c **** 
 376:../../CM7/Core/Src/cm7core.c **** 		}
 377:../../CM7/Core/Src/cm7core.c **** 		HAL_IWDG_Refresh(&hiwdg);
 378:../../CM7/Core/Src/cm7core.c **** 	}
 379:../../CM7/Core/Src/cm7core.c **** 	return FALSE;
