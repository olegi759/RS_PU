 201:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** uint8_t DHCP_allocated_gw[4]  = {0, };    // Gateway address from DHCP
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccX0OfIc.s 			page 5


 202:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** uint8_t DHCP_allocated_sn[4]  = {0, };    // Subnet mask from DHCP
 203:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** uint8_t DHCP_allocated_dns[4] = {0, };    // DNS address from DHCP
 204:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 
 205:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 
 206:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** int8_t   dhcp_state        = STATE_DHCP_INIT;   // DHCP state
 207:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** int8_t   dhcp_retry_count  = 0;                 
 208:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 
