 872:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 			dhcp_tick_next = dhcp_tick_1s + DHCP_WAIT_TIME;
 873:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 			dhcp_retry_count++;
 874:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 		}
 875:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 	} else { // timeout occurred
 876:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 
 877:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 		switch(dhcp_state) {
 878:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 			case STATE_DHCP_DISCOVER:
 879:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 				dhcp_state = STATE_DHCP_INIT;
