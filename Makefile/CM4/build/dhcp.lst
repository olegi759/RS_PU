 860:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 
 861:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 				case STATE_DHCP_REREQUEST :
 862:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** //					ulog_fmt("<<timeout>> state : STATE_DHCP_REREQUEST\r\n");
 863:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 					
 864:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 					send_DHCP_REQUEST();
