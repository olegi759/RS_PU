  62:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** /* DHCP state machine. */
  63:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define STATE_DHCP_INIT          0        ///< Initialize
  64:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define STATE_DHCP_DISCOVER      1        ///< send DISCOVER and wait OFFER
  65:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define STATE_DHCP_REQUEST       2        ///< send REQEUST and wait ACK or NACK
  66:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define STATE_DHCP_LEASED        3        ///< ReceiveD ACK and IP leased
  67:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define STATE_DHCP_REREQUEST     4        ///< send REQUEST for maintaining leased IP
  68:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define STATE_DHCP_RELEASE       5        ///< No use
  69:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define STATE_DHCP_STOP          6        ///< Stop processing DHCP
  70:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 
  71:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define DHCP_FLAGSBROADCAST      0x8000   ///< The broadcast value of flags in @ref RIP_MSG 
  72:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define DHCP_FLAGSUNICAST        0x0000   ///< The unicast   value of flags in @ref RIP_MSG
  73:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 
  74:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** /* DHCP message OP code */
  75:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define DHCP_BOOTREQUEST         1        ///< Request Message used in op of @ref RIP_MSG
  76:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define DHCP_BOOTREPLY           2        ///< Reply Message used i op of @ref RIP_MSG
  77:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 
  78:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** /* DHCP message type */
  79:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define DHCP_DISCOVER            1        ///< DISCOVER message in OPT of @ref RIP_MSG
  80:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define DHCP_OFFER               2        ///< OFFER message in OPT of @ref RIP_MSG
  81:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define DHCP_REQUEST             3        ///< REQUEST message in OPT of @ref RIP_MSG
  82:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define DHCP_DECLINE             4        ///< DECLINE message in OPT of @ref RIP_MSG
  83:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define DHCP_ACK                 5        ///< ACK message in OPT of @ref RIP_MSG
  84:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define DHCP_NAK                 6        ///< NACK message in OPT of @ref RIP_MSG
  85:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define DHCP_RELEASE             7        ///< RELEASE message in OPT of @ref RIP_MSG. No use
  86:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define DHCP_INFORM              8        ///< INFORM message in OPT of @ref RIP_MSG. No use
  87:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccX0OfIc.s 			page 3


  88:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define DHCP_HTYPE10MB           1        ///< Used in type of @ref RIP_MSG
  89:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define DHCP_HTYPE100MB          2        ///< Used in type of @ref RIP_MSG
  90:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 
  91:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define DHCP_HLENETHERNET        6        ///< Used in hlen of @ref RIP_MSG
  92:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define DHCP_HOPS                0        ///< Used in hops of @ref RIP_MSG
  93:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define DHCP_SECS                0        ///< Used in secs of @ref RIP_MSG
  94:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 
  95:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define INFINITE_LEASETIME       0xffffffff	///< Infinite lease time
  96:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 
  97:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define OPT_SIZE                 312               /// Max OPT size of @ref RIP_MSG
  98:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** #define RIP_MSG_SIZE             (236+OPT_SIZE)    /// Max size of @ref RIP_MSG
  99:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 
