 170:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** /*
 171:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c ****  * @brief DHCP message format
 172:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c ****  */ 
 173:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** typedef struct {
 174:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 	uint8_t  op;            ///< @ref DHCP_BOOTREQUEST or @ref DHCP_BOOTREPLY
 175:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 	uint8_t  htype;         ///< @ref DHCP_HTYPE10MB or @ref DHCP_HTYPE100MB
 176:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 	uint8_t  hlen;          ///< @ref DHCP_HLENETHERNET
 177:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 	uint8_t  hops;          ///< @ref DHCP_HOPS
 178:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 	uint32_t xid;           ///< @ref DHCP_XID  This increase one every DHCP transaction.
 179:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 	uint16_t secs;          ///< @ref DHCP_SECS
 180:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 	uint16_t flags;         ///< @ref DHCP_FLAGSBROADCAST or @ref DHCP_FLAGSUNICAST
 181:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 	uint8_t  ciaddr[4];     ///< @ref Request IP to DHCP sever
 182:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 	uint8_t  yiaddr[4];     ///< @ref Offered IP from DHCP server
 183:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 	uint8_t  siaddr[4];     ///< No use 
 184:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 	uint8_t  giaddr[4];     ///< No use
 185:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 	uint8_t  chaddr[16];    ///< DHCP client 6bytes MAC address. Others is filled to zero
 186:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 	uint8_t  sname[64];     ///< No use
 187:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 	uint8_t  file[128];     ///< No use
 188:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 	uint8_t  OPT[OPT_SIZE]; ///< Option
 189:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** } RIP_MSG;
 190:../../w5500/ioLibrary_driver/Internet/DHCP/dhcp.c **** 
