 188:../../CM4/Core/Src/main.c **** void UART_flush(UART_HandleTypeDef *huart) {
 189:../../CM4/Core/Src/main.c ****   // Flush UART RX buffer if RXNE is set
 190:../../CM4/Core/Src/main.c ****   if READ_BIT(huart->Instance->ISR, UART_FLAG_RXNE) {
 191:../../CM4/Core/Src/main.c ****     SET_BIT(huart->Instance->RQR, UART_RXDATA_FLUSH_REQUEST);
 192:../../CM4/Core/Src/main.c ****   }
 193:../../CM4/Core/Src/main.c **** 
 194:../../CM4/Core/Src/main.c ****   // Not available on F030xx devices!
 195:../../CM4/Core/Src/main.c ****   SET_BIT(huart->Instance->RQR, UART_TXDATA_FLUSH_REQUEST);
 196:../../CM4/Core/Src/main.c **** 
 197:../../CM4/Core/Src/main.c ****   // Clear All Errors (if needed)
 198:../../CM4/Core/Src/main.c ****   if (READ_BIT(huart->Instance->ISR, UART_FLAG_ORE | UART_FLAG_FE | UART_FLAG_NE)) {
 199:../../CM4/Core/Src/main.c **** 
 200:../../CM4/Core/Src/main.c **** 	__HAL_UART_CLEAR_PEFLAG(huart);
 201:../../CM4/Core/Src/main.c **** 	__HAL_UART_CLEAR_OREFLAG(huart);
 202:../../CM4/Core/Src/main.c **** 	__HAL_UART_CLEAR_FEFLAG(huart);
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccdv6Nnm.s 			page 5


 203:../../CM4/Core/Src/main.c **** 	__HAL_UART_CLEAR_NEFLAG(huart);
 204:../../CM4/Core/Src/main.c **** 	__HAL_UART_CLEAR_IDLEFLAG(huart);
 205:../../CM4/Core/Src/main.c **** 	__HAL_UART_CLEAR_TXFECF(huart);
 206:../../CM4/Core/Src/main.c **** 
 207:../../CM4/Core/Src/main.c ****   }
 208:../../CM4/Core/Src/main.c **** }
