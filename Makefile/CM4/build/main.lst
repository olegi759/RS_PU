 206:../../CM4/Core/Src/main.c **** void UART_flush(UART_HandleTypeDef *huart) {
 207:../../CM4/Core/Src/main.c ****   // Flush UART RX buffer if RXNE is set
 208:../../CM4/Core/Src/main.c ****   if READ_BIT(huart->Instance->ISR, UART_FLAG_RXNE) {
 209:../../CM4/Core/Src/main.c ****     SET_BIT(huart->Instance->RQR, UART_RXDATA_FLUSH_REQUEST);
 210:../../CM4/Core/Src/main.c ****   }
 211:../../CM4/Core/Src/main.c **** 
 212:../../CM4/Core/Src/main.c ****   // Not available on F030xx devices!
 213:../../CM4/Core/Src/main.c ****   SET_BIT(huart->Instance->RQR, UART_TXDATA_FLUSH_REQUEST);
 214:../../CM4/Core/Src/main.c **** 
 215:../../CM4/Core/Src/main.c ****   // Clear All Errors (if needed)
 216:../../CM4/Core/Src/main.c ****   if (READ_BIT(huart->Instance->ISR, UART_FLAG_ORE | UART_FLAG_FE | UART_FLAG_NE)) {
 217:../../CM4/Core/Src/main.c **** 
 218:../../CM4/Core/Src/main.c **** 	__HAL_UART_CLEAR_PEFLAG(huart);
 219:../../CM4/Core/Src/main.c **** 	__HAL_UART_CLEAR_OREFLAG(huart);
 220:../../CM4/Core/Src/main.c **** 	__HAL_UART_CLEAR_FEFLAG(huart);
 221:../../CM4/Core/Src/main.c **** 	__HAL_UART_CLEAR_NEFLAG(huart);
 222:../../CM4/Core/Src/main.c **** 	__HAL_UART_CLEAR_IDLEFLAG(huart);
 223:../../CM4/Core/Src/main.c **** 	__HAL_UART_CLEAR_TXFECF(huart);
 224:../../CM4/Core/Src/main.c **** 
 225:../../CM4/Core/Src/main.c ****   }
 226:../../CM4/Core/Src/main.c **** }
 227:../../CM4/Core/Src/main.c **** 
 228:../../CM4/Core/Src/main.c **** 
