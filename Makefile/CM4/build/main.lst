 290:../../CM4/Core/Src/main.c **** //Активный уровень у сигналов 0
 291:../../CM4/Core/Src/main.c **** void zash_per_um_task(void)
 292:../../CM4/Core/Src/main.c **** {
 293:../../CM4/Core/Src/main.c **** 	uint8_t zash_um1_now;
 294:../../CM4/Core/Src/main.c **** 	uint8_t per_um1_now;
 295:../../CM4/Core/Src/main.c **** 	uint8_t zash_um2_now;
 296:../../CM4/Core/Src/main.c **** 	uint8_t per_um2_now;
 297:../../CM4/Core/Src/main.c **** 
 298:../../CM4/Core/Src/main.c **** 	zash_um1_now = PIN_GET(ZASH_UM1_P);
 299:../../CM4/Core/Src/main.c **** 	if (zash_um1_now != zash_um1_old) {
 300:../../CM4/Core/Src/main.c **** 		if (zash_um1_now) fault_unset(FAULT_ZASH_UM1);
 301:../../CM4/Core/Src/main.c **** 		else fault_set(FAULT_ZASH_UM1);
 302:../../CM4/Core/Src/main.c **** 		zash_um1_old = zash_um1_now;
