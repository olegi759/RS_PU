 193:../../CM4/Core/Src/main.c **** void UART_flush(UART_HandleTypeDef *huart) {
 194:../../CM4/Core/Src/main.c ****   // Flush UART RX buffer if RXNE is set
 195:../../CM4/Core/Src/main.c ****   if READ_BIT(huart->Instance->ISR, UART_FLAG_RXNE) {
 196:../../CM4/Core/Src/main.c ****     SET_BIT(huart->Instance->RQR, UART_RXDATA_FLUSH_REQUEST);
 197:../../CM4/Core/Src/main.c ****   }
 198:../../CM4/Core/Src/main.c **** 
 199:../../CM4/Core/Src/main.c ****   // Not available on F030xx devices!
 200:../../CM4/Core/Src/main.c ****   SET_BIT(huart->Instance->RQR, UART_TXDATA_FLUSH_REQUEST);
 201:../../CM4/Core/Src/main.c **** 
 202:../../CM4/Core/Src/main.c ****   // Clear All Errors (if needed)
