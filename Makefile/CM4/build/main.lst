 203:../../CM4/Core/Src/main.c ****   if (READ_BIT(huart->Instance->ISR, UART_FLAG_ORE | UART_FLAG_FE | UART_FLAG_NE)) {
 204:../../CM4/Core/Src/main.c **** 
 205:../../CM4/Core/Src/main.c **** 	__HAL_UART_CLEAR_PEFLAG(huart);
 206:../../CM4/Core/Src/main.c **** 	__HAL_UART_CLEAR_OREFLAG(huart);
 207:../../CM4/Core/Src/main.c **** 	__HAL_UART_CLEAR_FEFLAG(huart);
 208:../../CM4/Core/Src/main.c **** 	__HAL_UART_CLEAR_NEFLAG(huart);
 209:../../CM4/Core/Src/main.c **** 	__HAL_UART_CLEAR_IDLEFLAG(huart);
