 332:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** #ifdef _HTTPSERVER_DEBUG_
 333:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 		ulog_fmt("> HTTPSocket[%d] : [Send] HTTP Response Header [ %d ]byte\r\n", s, (uint16_t)strlen((ch
 334:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** #endif
 335:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 		send(s, http_response, strlen((char *)http_response));
