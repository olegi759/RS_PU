 147:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 			{
 148:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 				setSn_IR(s, Sn_IR_CON);
 149:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 			}
 150:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 
