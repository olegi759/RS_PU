 140:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 
 141:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 	/* HTTP Service Start */
 142:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 	switch(getSn_SR(s))
 143:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 	{
 144:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 		case SOCK_ESTABLISHED:
 145:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 			// Interrupt clear
