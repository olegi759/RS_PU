 308:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** #endif
 309:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 				// CGI/XML type request does not respond HTTP header to client
 310:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 				http_status = 0;
 311:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 			}
 312:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 			break;
 313:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 		case STATUS_BAD_REQ: 	// HTTP/1.1 400 OK
 314:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** #ifdef _HTTPSERVER_DEBUG_
 315:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 			ulog_fmt("> HTTPSocket[%d] : HTTP Response Header - STATUS_BAD_REQ\r\n", s);
 316:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** #endif
 317:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 			memcpy(http_response, ERROR_REQUEST_PAGE, sizeof(ERROR_REQUEST_PAGE));
 318:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 			break;
 319:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 		case STATUS_NOT_FOUND:	// HTTP/1.1 404 Not Found
 320:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** #ifdef _HTTPSERVER_DEBUG_
 321:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 			ulog_fmt("> HTTPSocket[%d] : HTTP Response Header - STATUS_NOT_FOUND\r\n", s);
