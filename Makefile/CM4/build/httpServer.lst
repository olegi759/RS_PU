 301:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** #endif
 302:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 				make_http_response_head((char*)http_response, content_type, body_len);
 303:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 			}
 304:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 			else
 305:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 			{
 306:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** #ifdef _HTTPSERVER_DEBUG_
 307:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 			ulog_fmt("> HTTPSocket[%d] : HTTP Response Header - NONE / CGI or XML\r\n", s);
