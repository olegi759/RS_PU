 153:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 			{
 154:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 
 155:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 				case STATE_HTTP_IDLE :
 156:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 					if ((len = getSn_RX_RSR(s)) > 0)
 157:../../w5500/ioLibrary_driver/Internet/httpServer/httpServer.c **** 					{
