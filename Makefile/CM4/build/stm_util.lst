 427:../../util/stm_util.c **** 	pval = (uint32_t *)data;
 428:../../util/stm_util.c **** 	while (data_len > 1) {
 429:../../util/stm_util.c **** 		res = HAL_FLASH_Program(FLASH_TYPEPROGRAM_DOUBLEWORD, flash_address, pval[i]);
 430:../../util/stm_util.c **** 		hal_flash_wait_for_last_operation();
 431:../../util/stm_util.c **** 		if (res != HAL_OK) 	break;
 432:../../util/stm_util.c **** 		data_len -= 2;
 433:../../util/stm_util.c **** 		flash_address += 2;
 434:../../util/stm_util.c **** 		i++;
 435:../../util/stm_util.c **** 	}
 436:../../util/stm_util.c **** 
 437:../../util/stm_util.c **** 	if (data_len) {
