 913:../../util/stm_util.c **** 
 914:../../util/stm_util.c **** 
 915:../../util/stm_util.c **** 	if (erase_error != HAL_ERROR) {
 916:../../util/stm_util.c **** 
 917:../../util/stm_util.c **** 		//записываем страницу во флэш
 918:../../util/stm_util.c **** 		for (uint16_t j = 0; j < FLASH_PAGE_SIZE / 8; j++) {
 919:../../util/stm_util.c **** 			Data = *(uint64_t *)(__flash_buf + j * 8);
