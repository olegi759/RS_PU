 420:../../util/stm_util.c **** #else
 421:../../util/stm_util.c **** 
 422:../../util/stm_util.c **** #ifdef FLASH_TYPEPROGRAM_HALFWORD
 423:../../util/stm_util.c **** 
 424:../../util/stm_util.c **** 	uint16_t * pval, val;
 425:../../util/stm_util.c **** 
