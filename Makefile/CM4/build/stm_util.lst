 441:../../util/stm_util.c **** 		hal_flash_wait_for_last_operation();
 442:../../util/stm_util.c **** 	}
 443:../../util/stm_util.c **** 
 444:../../util/stm_util.c **** #else
 445:../../util/stm_util.c **** 
 446:../../util/stm_util.c **** #ifdef FLASH_TYPEPROGRAM_WORD
 447:../../util/stm_util.c **** 
 448:../../util/stm_util.c **** 
