 401:../../util/stm_util.c **** HAL_StatusTypeDef hal_write_data_to_flash(uint32_t address, uint8_t * data, uint32_t data_len)
 402:../../util/stm_util.c **** {
 403:../../util/stm_util.c **** 	uint32_t i;
 404:../../util/stm_util.c **** 	HAL_StatusTypeDef res;
 405:../../util/stm_util.c **** 	uint32_t flash_address;
 406:../../util/stm_util.c **** 
 407:../../util/stm_util.c **** 	flash_address = address;
 408:../../util/stm_util.c **** 	res = HAL_OK;
 409:../../util/stm_util.c **** 
 410:../../util/stm_util.c **** 
 411:../../util/stm_util.c **** 	hal_flash_unlocked();
 412:../../util/stm_util.c **** 
 413:../../util/stm_util.c **** #ifdef FLASH_TYPEPROGRAM_BYTE
 414:../../util/stm_util.c **** 	for (i = 0; i < data_len; ++i) {
 415:../../util/stm_util.c **** 		res = HAL_FLASH_Program(FLASH_TYPEPROGRAM_BYTE, flash_address, data[i]);
 416:../../util/stm_util.c **** 		hal_flash_wait_for_last_operation();
 417:../../util/stm_util.c **** 		if (res != HAL_OK) break;
 418:../../util/stm_util.c **** 		flash_address++;
