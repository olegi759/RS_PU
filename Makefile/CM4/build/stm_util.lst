 921:../../util/stm_util.c **** 			FLASH_WaitForLastOperation(FLASH_TIMEOUT_VALUE);  // Ожидаем окончания опер�
 922:../../util/stm_util.c **** 		}
 923:../../util/stm_util.c **** 		res = TRUE;
 924:../../util/stm_util.c **** 	}
 925:../../util/stm_util.c **** 
 926:../../util/stm_util.c **** 	hal_flash_locked();
 927:../../util/stm_util.c **** 
 928:../../util/stm_util.c **** 	return res;
 929:../../util/stm_util.c **** }
