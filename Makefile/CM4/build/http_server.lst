  23:../../CM4/Core/Src/http_server.c **** 
  24:../../CM4/Core/Src/http_server.c **** uint32_t w5500_send_all(uint8_t sn, uint8_t * buf, uint32_t len)
  25:../../CM4/Core/Src/http_server.c **** {
  26:../../CM4/Core/Src/http_server.c **** 	uint32_t size;
  27:../../CM4/Core/Src/http_server.c **** 	uint32_t send_len;
  28:../../CM4/Core/Src/http_server.c **** 	int32_t rc;
  29:../../CM4/Core/Src/http_server.c **** 
  30:../../CM4/Core/Src/http_server.c **** 
  31:../../CM4/Core/Src/http_server.c **** 	size = 0;
  32:../../CM4/Core/Src/http_server.c **** 	while (size < len) {
  33:../../CM4/Core/Src/http_server.c **** 		send_len = len - size;
  34:../../CM4/Core/Src/http_server.c **** 		if (send_len > 1024) send_len = 1024;
  35:../../CM4/Core/Src/http_server.c **** 		rc = send(sn, &buf[size], send_len);
  36:../../CM4/Core/Src/http_server.c **** 		if (rc > 0) {
  37:../../CM4/Core/Src/http_server.c **** 			size += rc;
  38:../../CM4/Core/Src/http_server.c **** 		}
  39:../../CM4/Core/Src/http_server.c **** 		else {
  40:../../CM4/Core/Src/http_server.c **** 			HAL_Delay(10);
  41:../../CM4/Core/Src/http_server.c **** 			rc = send(sn, &buf[size], send_len);
  42:../../CM4/Core/Src/http_server.c **** 			if (rc > 0) {
  43:../../CM4/Core/Src/http_server.c **** 				size += rc;
  44:../../CM4/Core/Src/http_server.c **** 			}
  45:../../CM4/Core/Src/http_server.c **** 			else break;
  46:../../CM4/Core/Src/http_server.c **** 		}
  47:../../CM4/Core/Src/http_server.c **** 	}
  48:../../CM4/Core/Src/http_server.c **** 	return size;
  49:../../CM4/Core/Src/http_server.c **** }
  50:../../CM4/Core/Src/http_server.c **** 
  51:../../CM4/Core/Src/http_server.c **** 
  52:../../CM4/Core/Src/http_server.c **** uint32_t w5500_recv_all(uint8_t sn, uint8_t * buf, uint32_t len)
  53:../../CM4/Core/Src/http_server.c **** {
  54:../../CM4/Core/Src/http_server.c **** 
  55:../../CM4/Core/Src/http_server.c **** 	uint32_t offset;
  56:../../CM4/Core/Src/http_server.c **** 	uint16_t size;
  57:../../CM4/Core/Src/http_server.c **** 	int32_t rc;
  58:../../CM4/Core/Src/http_server.c **** 	uint16_t available;
  59:../../CM4/Core/Src/http_server.c **** 
  60:../../CM4/Core/Src/http_server.c **** 
  61:../../CM4/Core/Src/http_server.c **** 
  62:../../CM4/Core/Src/http_server.c **** 	offset = 0;
  63:../../CM4/Core/Src/http_server.c **** 	while (offset < len) {
  64:../../CM4/Core/Src/http_server.c **** 		available = getSn_RX_RSR(sn);
  65:../../CM4/Core/Src/http_server.c **** 		if (available < 1) break;
  66:../../CM4/Core/Src/http_server.c **** 		size = len - offset;
  67:../../CM4/Core/Src/http_server.c **** 		if (size > available) size = available;
  68:../../CM4/Core/Src/http_server.c **** 		rc = recv(sn, &buf[offset], size);
  69:../../CM4/Core/Src/http_server.c **** 		if (rc > 0)	offset += rc;
  70:../../CM4/Core/Src/http_server.c **** 		HAL_Delay(10);
  71:../../CM4/Core/Src/http_server.c **** 	}
  72:../../CM4/Core/Src/http_server.c **** 
  73:../../CM4/Core/Src/http_server.c **** 
  74:../../CM4/Core/Src/http_server.c **** 	return offset;
  75:../../CM4/Core/Src/http_server.c **** 
  76:../../CM4/Core/Src/http_server.c **** }
