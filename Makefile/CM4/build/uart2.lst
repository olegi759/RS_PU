 205:../../CM4/Core/Src/uart2.c **** void uart2_task_tx(void)
 206:../../CM4/Core/Src/uart2.c **** {
 207:../../CM4/Core/Src/uart2.c **** 
 208:../../CM4/Core/Src/uart2.c **** 	if (uart2_tick < 20) {
 209:../../CM4/Core/Src/uart2.c **** 		uart2_tick++;
 210:../../CM4/Core/Src/uart2.c **** 		if (mki_int_p) {
 211:../../CM4/Core/Src/uart2.c **** 			mki_send_key();
