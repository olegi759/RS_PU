 218:../../CM4/Core/Src/uart2.c **** 
 219:../../CM4/Core/Src/uart2.c **** 	if (uart2_mup_tick < 60) { //60 сек
 220:../../CM4/Core/Src/uart2.c **** 		uart2_mup_tick++;
 221:../../CM4/Core/Src/uart2.c **** 	} else {
 222:../../CM4/Core/Src/uart2.c **** 		uart2_mup_tick = 0;
