 453:../../util/fatfs_util.c **** BOOL f_erase_and_copy_to_flash(const char * file_name, uint32_t address, uint8_t stm32flashtype)
 454:../../util/fatfs_util.c **** {
 455:../../util/fatfs_util.c **** 	FSIZE_t fsz;
 456:../../util/fatfs_util.c **** 	uint64_t file_crc, mem_crc;
 457:../../util/fatfs_util.c **** 	BOOL res;
 458:../../util/fatfs_util.c **** 
 459:../../util/fatfs_util.c **** 
 460:../../util/fatfs_util.c **** 	if (!f_exists(file_name)) return FALSE;
 461:../../util/fatfs_util.c **** 
 462:../../util/fatfs_util.c **** 	if (f_file_size2(file_name, &fsz) != FR_OK) return FALSE;
 463:../../util/fatfs_util.c **** 
 464:../../util/fatfs_util.c **** 	if (!fsz) return FALSE;
 465:../../util/fatfs_util.c **** 
 466:../../util/fatfs_util.c **** 
 467:../../util/fatfs_util.c **** 
 468:../../util/fatfs_util.c ****     ulog_fmt("hal_erase_by_address:0x%s, size:%lu"CRLF, ul2hexstr(address), fsz);
 469:../../util/fatfs_util.c **** 	//очищаем флэш
 470:../../util/fatfs_util.c **** 	if (hal_erase_by_address(address, address + fsz, stm32flashtype) != HAL_OK) {
 471:../../util/fatfs_util.c **** 	    ulog("f_erase_and_copy_to_flash: invalid erase by address"CRLF);
 472:../../util/fatfs_util.c **** 	    return FALSE;
 473:../../util/fatfs_util.c **** 	}
 474:../../util/fatfs_util.c **** 
 475:../../util/fatfs_util.c **** 	//копируем данные во флэщ
 476:../../util/fatfs_util.c **** 	res = f_copy_to_flash(file_name, address);
 477:../../util/fatfs_util.c **** 	if (!res) {
 478:../../util/fatfs_util.c **** 	    ulog("f_erase_and_copy_to_flash: error f_copy_to_flash"CRLF);
 479:../../util/fatfs_util.c **** 		return FALSE;
 480:../../util/fatfs_util.c **** 	}
 481:../../util/fatfs_util.c **** 
 482:../../util/fatfs_util.c **** 	file_crc = f_crc(file_name);
 483:../../util/fatfs_util.c **** 	mem_crc = ulCrcSum((unsigned char *)address, fsz); //кс файла в памяти
 484:../../util/fatfs_util.c **** 	res = (mem_crc == file_crc);
 485:../../util/fatfs_util.c **** 
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccrpEabC.s 			page 46


 486:../../util/fatfs_util.c **** 	ulog_fmt("f_erase_and_copy_to_flash: file_size:%lu file_crc:%s mem_crc:%s res:%s"CRLF, fsz, ull2st
 487:../../util/fatfs_util.c **** 
 488:../../util/fatfs_util.c **** 	if (!res) hal_erase_by_address(address, address + fsz, stm32flashtype);
 489:../../util/fatfs_util.c **** 
 490:../../util/fatfs_util.c **** 
 491:../../util/fatfs_util.c **** 	return res;
 492:../../util/fatfs_util.c **** }
