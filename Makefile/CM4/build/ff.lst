4910:../../fatfs/ff.c **** #endif
4911:../../fatfs/ff.c **** 		if (res != FR_OK) ABORT(fs, res);
4912:../../fatfs/ff.c **** 	}
4913:../../fatfs/ff.c **** 
4914:../../fatfs/ff.c **** 	LEAVE_FF(fs, res);
4915:../../fatfs/ff.c **** }
