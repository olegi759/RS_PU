3277:../../fatfs/ff.c **** 		*buff++ = (BYTE)seed;
3278:../../fatfs/ff.c **** 	} while (--n);
3279:../../fatfs/ff.c **** 	return seed;
3280:../../fatfs/ff.c **** }
