4302:../../fatfs/ff.c **** FRESULT f_getcwd (
4303:../../fatfs/ff.c **** 	TCHAR* buff,	/* Pointer to the directory path */
4304:../../fatfs/ff.c **** 	UINT len		/* Size of buff in unit of TCHAR */
4305:../../fatfs/ff.c **** )
4306:../../fatfs/ff.c **** {
4307:../../fatfs/ff.c **** 	FRESULT res;
