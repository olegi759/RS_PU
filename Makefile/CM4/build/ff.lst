4240:../../fatfs/ff.c **** FRESULT f_chdir (
4241:../../fatfs/ff.c **** 	const TCHAR* path	/* Pointer to the directory path */
4242:../../fatfs/ff.c **** )
4243:../../fatfs/ff.c **** {
4244:../../fatfs/ff.c **** #if FF_STR_VOLUME_ID == 2
4245:../../fatfs/ff.c **** 	UINT i;
