3266:../../fatfs/ff.c **** 	DWORD seed,		/* Seed value */
3267:../../fatfs/ff.c **** 	BYTE* buff,		/* Output buffer */
3268:../../fatfs/ff.c **** 	UINT n			/* Data length */
3269:../../fatfs/ff.c **** )
3270:../../fatfs/ff.c **** {
3271:../../fatfs/ff.c **** 	UINT r;
3272:../../fatfs/ff.c **** 
