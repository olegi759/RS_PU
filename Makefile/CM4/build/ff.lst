4257:../../fatfs/ff.c **** 		INIT_NAMBUF(fs);
4258:../../fatfs/ff.c **** 		res = follow_path(&dj, path);		/* Follow the path */
4259:../../fatfs/ff.c **** 		if (res == FR_OK) {					/* Follow completed */
