 184:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** #ifdef _OLD_
 185:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** /**
 186:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****  @brief	get next parameter value in the request
 187:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****  */
 188:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** uint8_t * get_http_param_value(
 189:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	char* uri, 
 190:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	char* param_name
 191:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	)
 192:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** {
 193:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	char tempURI[MAX_URI_SIZE];
 194:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uint8_t * name = 0;
 195:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	
 196:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 197:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	if(!uri || !param_name) return 0;
 198:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	
 199:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	strcpy((char*)tempURI,uri);
 200:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	if((name = (uint8_t*)strstr(tempURI, param_name)))
 201:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	{
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccISG8Fg.s 			page 5


 202:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		name += strlen(param_name) + 1; // strlen(para_name) + strlen("=")
 203:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		if((name = (uint8_t*)strtok((char *)name,"& \r\n\t\0")))
 204:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		{
 205:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 			unescape_http_url((char *)name);
 206:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 			replacetochar(name, '+', ' ');
 207:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		}
 208:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	}
 209:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** #ifdef _HTTPPARSER_DEBUG_
 210:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	ulog_fmt("  %s=%s",param_name,name);
 211:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** #endif	
 212:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 213:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	return name;
 214:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** }
 215:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** #else
 216:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** /**
 217:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****  @brief	get next parameter value in the request
 218:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****  */
 219:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** uint8_t * get_http_param_value(char* uri, char* param_name)
 220:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** {
 221:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 222:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uint8_t * name = 0;
 223:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uint8_t * ret = BUFPUB;
 224:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uint8_t * pos2;
 225:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uint16_t len = 0, content_len = 0;
 226:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uint8_t tmp_buf[10]={0x00, };
 227:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 228:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	if(!uri || !param_name) return 0;
 229:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 230:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	/***************/
 231:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	mid(uri, "Content-Length: ", "\r\n", (char *)tmp_buf);
 232:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	content_len = ATOI(tmp_buf, 10);
 233:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uri = strstr(uri, "\r\n\r\n");
 234:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uri += 4;
 235:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uri[content_len] = 0;
 236:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	/***************/
 237:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 238:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	if((name = (uint8_t *)strstr(uri, param_name)))
 239:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	{
 240:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		name += strlen(param_name) + 1;
 241:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		pos2 = (uint8_t*)strstr((char*)name, "&");
 242:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		if(!pos2)
 243:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		{
 244:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 			pos2 = name + strlen((char*)name);
 245:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		}
 246:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		len = pos2 - name;
 247:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 248:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		if(len)
 249:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		{
 250:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 			ret[len] = 0;
 251:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 			strncpy((char*)ret,(char*)name, len);
 252:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 			unescape_http_url((char *)ret);
 253:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 			replacetochar(ret, '+' ,' ');
 254:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 			//ret[len] = 0;
 255:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 			//ret[strlen((int8*)ret)] = 0;
 256:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 			//ulog_fmt("len=%d\r\n",len);
 257:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		}
 258:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		else
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccISG8Fg.s 			page 6


 259:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		{
 260:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 			ret[0] = 0;
 261:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		}
 262:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	}
 263:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else
 264:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	{
 265:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		return 0;
 266:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	}
 267:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** #ifdef _HTTPPARSER_DEBUG_
 268:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	ulog_fmt("  %s=%s\r\n", param_name, ret);
