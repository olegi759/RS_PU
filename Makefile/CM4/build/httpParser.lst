 342:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** uint16_t ATOI(
 343:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uint8_t * str,	/**< is a pointer to convert */
 344:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uint8_t base	/**< is a base value (must be in the range 2 - 16) */
