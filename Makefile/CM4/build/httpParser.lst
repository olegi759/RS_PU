 318:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** {
 319:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uint8_t i;
 320:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uint8_t taddr[30];
 321:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uint8_t * nexttok;
 322:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uint8_t num;
 323:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 324:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	strcpy((char *)taddr, (char *)addr);
 325:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 326:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	nexttok = taddr;
 327:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	for(i = 0; i < 4 ; i++)
 328:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	{
 329:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		nexttok = (uint8_t *)strtok((char *)nexttok, ".");
 330:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		if(nexttok[0] == '0' && nexttok[1] == 'x') num = ATOI(nexttok+2,0x10);
 331:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		else num = ATOI(nexttok,10);
 332:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		ip[i] = num;
 333:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		nexttok = NULL;
 334:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	}
 335:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** }
