  23:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** /**
  24:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****  @brief	convert escape characters(%XX) to ASCII character
  25:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****  */ 
  26:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** void unescape_http_url(
  27:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	char * url	/**< pointer to be converted ( escape characters )*/
  28:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	)
  29:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** {
  30:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	int x, y;
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccISG8Fg.s 			page 2


  31:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
  32:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	for (x = 0, y = 0; url[y]; ++x, ++y) {
  33:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		if ((url[x] = url[y]) == '%') {
  34:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 			url[x] = C2D(url[y+1])*0x10+C2D(url[y+2]);
  35:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 			y+=2;
  36:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		}
  37:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	}
  38:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	url[x] = '\0';
  39:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** }
  40:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
  41:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
  42:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** /**
  43:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****  @brief	make response header such as html, gif, jpeg,etc.
  44:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****  */ 
  45:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** void make_http_response_head(
  46:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	char * buf, 	/**< pointer to response header to be made */
  47:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	char type, 	/**< response type */
  48:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uint32_t len	/**< size of response header */
  49:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	)
  50:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** {
  51:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	char * head;
  52:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	char tmp[10];
  53:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 			
  54:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	/*  file type*/
  55:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	if 	(type == PTYPE_HTML) 		head = RES_HTMLHEAD_OK;
  56:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (type == PTYPE_GIF)		head = RES_GIFHEAD_OK;
  57:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (type == PTYPE_TEXT)	head = RES_TEXTHEAD_OK;
  58:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (type == PTYPE_JPEG)	head = RES_JPEGHEAD_OK;
  59:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (type == PTYPE_FLASH)	head = RES_FLASHHEAD_OK;
  60:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (type == PTYPE_XML) 	head =  RES_XMLHEAD_OK;
  61:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (type == PTYPE_CSS) 	head = RES_CSSHEAD_OK;
  62:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (type == PTYPE_JSON)	head = RES_JSONHEAD_OK;
  63:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (type == PTYPE_JS)		head = RES_JSHEAD_OK;
  64:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (type == PTYPE_CGI)		head = RES_CGIHEAD_OK;
  65:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (type == PTYPE_PNG)		head = RES_PNGHEAD_OK;
  66:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (type == PTYPE_ICO)		head = RES_ICOHEAD_OK;
  67:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (type == PTYPE_TTF)		head = RES_TTFHEAD_OK;
  68:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (type == PTYPE_OTF)		head = RES_OTFHEAD_OK;
  69:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (type == PTYPE_WOFF)	head = RES_WOFFHEAD_OK;
  70:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (type == PTYPE_EOT)		head = RES_EOTHEAD_OK;
  71:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (type == PTYPE_SVG)		head = RES_SVGHEAD_OK;
  72:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** #ifdef _HTTPPARSER_DEBUG_
  73:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else
  74:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	{
  75:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		head = NULL;
  76:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 		ulog_fmt("\r\n\r\n-MAKE HEAD UNKNOWN-\r\n");
  77:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	}
  78:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** #else
  79:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else head = NULL;
  80:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** #endif	
  81:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
  82:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	sprintf(tmp, "%ld", len);
  83:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	strcpy(buf, head);
  84:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	strcat(buf, tmp);
  85:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	strcat(buf, "\r\n\r\n");
  86:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** }
