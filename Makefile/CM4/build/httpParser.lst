 124:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** /**
 125:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****  @brief	parse http request from a peer
 126:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****  */ 
 127:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** void parse_http_request(
 128:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	st_http_request * request, 	/**< request to be returned */
 129:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uint8_t * buf				/**< pointer to be parsed */
 130:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	)
 131:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** {
 132:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   char * nexttok;
 133:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   //char * ptr;
 134:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 135:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   request->POST_DATA = NULL;
 136:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 137:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   nexttok = strtok((char*)buf," ");
 138:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   if(!nexttok)
 139:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   {
 140:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****     request->METHOD = METHOD_ERR;
 141:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****     return;
 142:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   }
 143:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   if(!strcmp(nexttok, "GET") || !strcmp(nexttok,"get"))
 144:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   {
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccISG8Fg.s 			page 4


 145:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****     request->METHOD = METHOD_GET;
 146:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****     nexttok = strtok(NULL," ");
 147:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 148:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   }
 149:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   else if (!strcmp(nexttok, "HEAD") || !strcmp(nexttok,"head"))
 150:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   {
 151:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****     request->METHOD = METHOD_HEAD;
 152:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****     nexttok = strtok(NULL," ");
 153:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 154:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   }
 155:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   else if (!strcmp(nexttok, "POST") || !strcmp(nexttok,"post"))
 156:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   {
 157:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****     nexttok = strtok(NULL,"\0");
 158:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****     request->METHOD = METHOD_POST;
 159:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   }
 160:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   else
 161:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   {
 162:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****     request->METHOD = METHOD_ERR;
 163:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   }
 164:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 165:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   if(!nexttok)
 166:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   {
 167:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****     request->METHOD = METHOD_ERR;
 168:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****     return;
 169:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   }
 170:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 171:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   if (request->METHOD == METHOD_POST) {
 172:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	 request->POST_DATA = (uint8_t *)strstr(nexttok, "\r\n\r\n");
 173:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	 if (request->POST_DATA) request->POST_DATA += 4;
 174:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   }
 175:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 176:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   request->URI = (uint8_t *)nexttok;
 177:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   //ptr = strstr(nexttok, " ");
 178:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****   //if (ptr) *ptr = '\0';
 179:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 180:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 181:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 182:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** }
