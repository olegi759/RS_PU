  89:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** /**
  90:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****  @brief	find MIME type of a file
  91:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c ****  */ 
  92:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** void find_http_uri_type(
  93:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uint8_t * type, 	/**< type to be returned */
  94:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	uint8_t * buff		/**< file name */
  95:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	) 
  96:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** {
  97:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	/* Decide type according to extension*/
  98:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
  99:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	char * buf;
 100:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	buf = (char *)buff;
 101:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 
 102:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	if 	(strstr(buf, ".htm")	|| strstr(buf, ".html"))	*type = PTYPE_HTML;
 103:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (strstr(buf, ".gif"))							*type = PTYPE_GIF;
 104:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (strstr(buf, ".text") 	|| strstr(buf,".txt"))	*type = PTYPE_TEXT;
 105:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (strstr(buf, ".jpeg") 	|| strstr(buf,".jpg"))	*type = PTYPE_JPEG;
 106:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (strstr(buf, ".swf")) 							*type = PTYPE_FLASH;
 107:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (strstr(buf, ".cgi") 	|| strstr(buf,".CGI"))	*type = PTYPE_CGI;
 108:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (strstr(buf, ".json") 	|| strstr(buf,".JSON"))	*type = PTYPE_JSON;
 109:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (strstr(buf, ".js") 	|| strstr(buf,".JS"))	*type = PTYPE_JS;
 110:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (strstr(buf, ".CGI") 	|| strstr(buf,".cgi"))	*type = PTYPE_CGI;
 111:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (strstr(buf, ".xml") 	|| strstr(buf,".XML"))	*type = PTYPE_XML;
 112:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (strstr(buf, ".css") 	|| strstr(buf,".CSS"))	*type = PTYPE_CSS;
 113:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (strstr(buf, ".png") 	|| strstr(buf,".PNG"))	*type = PTYPE_PNG;
 114:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (strstr(buf, ".ico") 	|| strstr(buf,".ICO"))	*type = PTYPE_ICO;
 115:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (strstr(buf, ".ttf") 	|| strstr(buf,".TTF"))	*type = PTYPE_TTF;
 116:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (strstr(buf, ".otf") 	|| strstr(buf,".OTF"))	*type = PTYPE_OTF;
 117:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (strstr(buf, ".woff") 	|| strstr(buf,".WOFF"))	*type = PTYPE_WOFF;
 118:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (strstr(buf, ".eot") 	|| strstr(buf,".EOT"))	*type = PTYPE_EOT;
 119:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else if (strstr(buf, ".svg") 	|| strstr(buf,".SVG"))	*type = PTYPE_SVG;
 120:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** 	else 													*type = PTYPE_ERR;
 121:../../w5500/ioLibrary_driver/Internet/httpServer/httpParser.c **** }
