 242:../../ws_rubetec/ws_rubetec.c **** // Преобразует один hex-символ в значение 0..15. Возвращает
 243:../../ws_rubetec/ws_rubetec.c **** static int hex_digit(char c) {
 244:../../ws_rubetec/ws_rubetec.c ****     if (c >= '0' && c <= '9') return c - '0';
 245:../../ws_rubetec/ws_rubetec.c ****     if (c >= 'a' && c <= 'f') return c - 'a' + 10;
 246:../../ws_rubetec/ws_rubetec.c ****     if (c >= 'A' && c <= 'F') return c - 'A' + 10;
 247:../../ws_rubetec/ws_rubetec.c ****     return -1;
 248:../../ws_rubetec/ws_rubetec.c **** }
 249:../../ws_rubetec/ws_rubetec.c **** 
 250:../../ws_rubetec/ws_rubetec.c **** // Разбирает hex-строку из JsonSlice в uint32_t.
 251:../../ws_rubetec/ws_rubetec.c **** // Поддерживает необязательный префикс "0x" / "0X" и любое �
 252:../../ws_rubetec/ws_rubetec.c **** //   "0x00000003", "0x03", "0x3", "3", "0XFFFFFFFF" — всё корректно.
 253:../../ws_rubetec/ws_rubetec.c **** // Возвращает true при успехе; *out не меняется при ошибке.
 254:../../ws_rubetec/ws_rubetec.c **** static bool parse_hex_uint32_slice(JsonSlice s, uint32_t *out)
 255:../../ws_rubetec/ws_rubetec.c **** {
 256:../../ws_rubetec/ws_rubetec.c ****     if (s.len == 0 || s.data == NULL) return false;
 257:../../ws_rubetec/ws_rubetec.c **** 
 258:../../ws_rubetec/ws_rubetec.c ****     size_t i = 0;
 259:../../ws_rubetec/ws_rubetec.c ****     // Пропускаем необязательный префикс 0x / 0X
 260:../../ws_rubetec/ws_rubetec.c ****     if (s.len >= 2 && s.data[0] == '0' && (s.data[1] == 'x' || s.data[1] == 'X')) {
 261:../../ws_rubetec/ws_rubetec.c ****         i = 2;
 262:../../ws_rubetec/ws_rubetec.c ****     }
 263:../../ws_rubetec/ws_rubetec.c ****     if (i >= s.len) return false; // после префикса ничего нет
 264:../../ws_rubetec/ws_rubetec.c **** 
 265:../../ws_rubetec/ws_rubetec.c ****     uint32_t acc = 0;
 266:../../ws_rubetec/ws_rubetec.c ****     for (; i < s.len; ++i) {
 267:../../ws_rubetec/ws_rubetec.c ****         int d = hex_digit(s.data[i]);
 268:../../ws_rubetec/ws_rubetec.c ****         if (d < 0) return false;
 269:../../ws_rubetec/ws_rubetec.c **** 
 270:../../ws_rubetec/ws_rubetec.c ****         // Проверка переполнения ДО сдвига:
 271:../../ws_rubetec/ws_rubetec.c ****         // если acc > 0x0FFFFFFF, то acc << 4 уже не поместится в uint32_t.
 272:../../ws_rubetec/ws_rubetec.c ****         if (acc > (UINT32_MAX >> 4)) return false;
 273:../../ws_rubetec/ws_rubetec.c ****         acc = (acc << 4) | (uint32_t)d;
 274:../../ws_rubetec/ws_rubetec.c ****     }
 275:../../ws_rubetec/ws_rubetec.c ****     *out = acc;
 276:../../ws_rubetec/ws_rubetec.c ****     return true;
 277:../../ws_rubetec/ws_rubetec.c **** }
 278:../../ws_rubetec/ws_rubetec.c **** 
 279:../../ws_rubetec/ws_rubetec.c **** static void write_hex_mask_kv(JsonWriter *w, const char *key, uint32_t value)
 280:../../ws_rubetec/ws_rubetec.c **** {
 281:../../ws_rubetec/ws_rubetec.c ****     static const char hex[] = "0123456789ABCDEF";
 282:../../ws_rubetec/ws_rubetec.c ****     char buf[12];                          // "0x" + до 8 цифр + '\0'
 283:../../ws_rubetec/ws_rubetec.c ****     char *p = buf + sizeof(buf) - 1;
 284:../../ws_rubetec/ws_rubetec.c ****     *p = '\0';
 285:../../ws_rubetec/ws_rubetec.c **** 
 286:../../ws_rubetec/ws_rubetec.c ****     int digits = 0;
 287:../../ws_rubetec/ws_rubetec.c ****     do {
 288:../../ws_rubetec/ws_rubetec.c ****         *--p = hex[value & 0xF];
 289:../../ws_rubetec/ws_rubetec.c ****         value >>= 4;
 290:../../ws_rubetec/ws_rubetec.c ****         digits++;
 291:../../ws_rubetec/ws_rubetec.c ****     } while (value > 0 || digits < 2);
 292:../../ws_rubetec/ws_rubetec.c **** 
 293:../../ws_rubetec/ws_rubetec.c ****     *--p = 'x';
 294:../../ws_rubetec/ws_rubetec.c ****     *--p = '0';
 295:../../ws_rubetec/ws_rubetec.c **** 
 296:../../ws_rubetec/ws_rubetec.c ****     json_write_key(w, key);
 297:../../ws_rubetec/ws_rubetec.c ****     json_write_str(w, p);                  // пишет с кавычками
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccP9UAxq.s 			page 86


 298:../../ws_rubetec/ws_rubetec.c **** }
 299:../../ws_rubetec/ws_rubetec.c **** 
 300:../../ws_rubetec/ws_rubetec.c **** // Разбирает "pu_id_mask" в битовую маску uint32_t.
 301:../../ws_rubetec/ws_rubetec.c **** // Поддерживает:
 302:../../ws_rubetec/ws_rubetec.c **** //   - массив:  [1, 2, 3]  -> 0x00000007 (ПУ N -> бит N-1)
 303:../../ws_rubetec/ws_rubetec.c **** //   - число 0:            -> 0xFFFFFFFF (все ПУ выбраны)
 304:../../ws_rubetec/ws_rubetec.c **** //   - число N (1..32):    -> 0x1 << (N-1) (одно ПУ)
 305:../../ws_rubetec/ws_rubetec.c **** // Ведущие пробелы/табы/CR/LF игнорируются.
 306:../../ws_rubetec/ws_rubetec.c **** static bool parse_pu_id_mask(JsonSlice s, uint32_t *out)
 307:../../ws_rubetec/ws_rubetec.c **** {
 308:../../ws_rubetec/ws_rubetec.c ****     if (s.data == NULL || s.len == 0) return false;
 309:../../ws_rubetec/ws_rubetec.c **** 
 310:../../ws_rubetec/ws_rubetec.c ****     // 1. Пропуск ведущих whitespace (корректное условие — &&)
 311:../../ws_rubetec/ws_rubetec.c ****     size_t i = 0;
 312:../../ws_rubetec/ws_rubetec.c ****     while (i < s.len &&
 313:../../ws_rubetec/ws_rubetec.c ****            (s.data[i] == ' '  || s.data[i] == '\t' ||
 314:../../ws_rubetec/ws_rubetec.c ****             s.data[i] == '\r' || s.data[i] == '\n')) {
 315:../../ws_rubetec/ws_rubetec.c ****         i++;
 316:../../ws_rubetec/ws_rubetec.c ****     }
 317:../../ws_rubetec/ws_rubetec.c ****     if (i >= s.len) return false;            // только пробелы — не значени
 318:../../ws_rubetec/ws_rubetec.c **** 
 319:../../ws_rubetec/ws_rubetec.c ****     JsonSlice trimmed = { s.data + i, s.len - i };
 320:../../ws_rubetec/ws_rubetec.c **** 
 321:../../ws_rubetec/ws_rubetec.c ****     // 2. Массив [1, 2, 3]
 322:../../ws_rubetec/ws_rubetec.c ****     if (trimmed.data[0] == '[') {
 323:../../ws_rubetec/ws_rubetec.c ****         JsonArrayIter iter;
 324:../../ws_rubetec/ws_rubetec.c ****         json_array_iter_init(trimmed, &iter);
 325:../../ws_rubetec/ws_rubetec.c **** 
 326:../../ws_rubetec/ws_rubetec.c ****         JsonSlice item;
 327:../../ws_rubetec/ws_rubetec.c ****         uint32_t mask  = 0;
 328:../../ws_rubetec/ws_rubetec.c ****         size_t   count = 0;
 329:../../ws_rubetec/ws_rubetec.c **** 
 330:../../ws_rubetec/ws_rubetec.c ****         while (json_array_iter_next(&iter, &item)) {
 331:../../ws_rubetec/ws_rubetec.c ****             uint8_t id;
 332:../../ws_rubetec/ws_rubetec.c ****             if (!parse_uint8_slice(item, &id)) return false;
 333:../../ws_rubetec/ws_rubetec.c ****             if (id < 1 || id > 32)            return false;
 334:../../ws_rubetec/ws_rubetec.c **** 
 335:../../ws_rubetec/ws_rubetec.c ****             mask |= (uint32_t)1u << (id - 1);
 336:../../ws_rubetec/ws_rubetec.c ****             count++;
 337:../../ws_rubetec/ws_rubetec.c ****         }
 338:../../ws_rubetec/ws_rubetec.c ****         if (count == 0) return false;        // пустой массив []
 339:../../ws_rubetec/ws_rubetec.c ****         *out = mask;
 340:../../ws_rubetec/ws_rubetec.c ****         return true;
 341:../../ws_rubetec/ws_rubetec.c ****     }
 342:../../ws_rubetec/ws_rubetec.c **** 
 343:../../ws_rubetec/ws_rubetec.c ****     // 3. Одиночное число: 0 или 1..32
 344:../../ws_rubetec/ws_rubetec.c ****     uint8_t val;
 345:../../ws_rubetec/ws_rubetec.c ****     if (!parse_uint8_slice(trimmed, &val)) return false;
 346:../../ws_rubetec/ws_rubetec.c **** 
 347:../../ws_rubetec/ws_rubetec.c ****     if (val == 0) {
 348:../../ws_rubetec/ws_rubetec.c ****         // 0 = выбрать все ПУ (1..32)
 349:../../ws_rubetec/ws_rubetec.c ****         *out = 0;
 350:../../ws_rubetec/ws_rubetec.c ****         for (uint8_t b = 0; b < MAX_PU_NUMBER; ++b) {
 351:../../ws_rubetec/ws_rubetec.c ****             *out |= (uint32_t)1u << b;
 352:../../ws_rubetec/ws_rubetec.c ****         }
 353:../../ws_rubetec/ws_rubetec.c ****         // Эквивалент: *out = 0xFFFFFFFFu;
 354:../../ws_rubetec/ws_rubetec.c ****         return true;
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccP9UAxq.s 			page 87


 355:../../ws_rubetec/ws_rubetec.c ****     }
 356:../../ws_rubetec/ws_rubetec.c ****     if (val > 32) return false;
 357:../../ws_rubetec/ws_rubetec.c **** 
 358:../../ws_rubetec/ws_rubetec.c ****     *out = (uint32_t)1u << (val - 1);        // одно ПУ -> один бит
 359:../../ws_rubetec/ws_rubetec.c ****     return true;
 360:../../ws_rubetec/ws_rubetec.c **** }
 361:../../ws_rubetec/ws_rubetec.c **** 
 362:../../ws_rubetec/ws_rubetec.c **** static void white_array_by_mask_kv(JsonWriter *w, const char *key, uint32_t value_mask){
 363:../../ws_rubetec/ws_rubetec.c ****     json_write_array_begin_k(w, key);
 364:../../ws_rubetec/ws_rubetec.c ****     for(uint8_t i = 0; i < 32; ++i){
 365:../../ws_rubetec/ws_rubetec.c ****         if( (value_mask & ((uint32_t)1 << i)) ){
 366:../../ws_rubetec/ws_rubetec.c ****              json_write_int(w, i + 1);
 367:../../ws_rubetec/ws_rubetec.c ****         }
 368:../../ws_rubetec/ws_rubetec.c ****     }
 369:../../ws_rubetec/ws_rubetec.c ****     json_write_array_end(w);
 370:../../ws_rubetec/ws_rubetec.c **** }
 371:../../ws_rubetec/ws_rubetec.c **** 
