 526:../../ws_rubetec/ws_rubetec.c ****     //собираем поля сообщения
 527:../../ws_rubetec/ws_rubetec.c ****     JsonSlice cmd_slice;
 528:../../ws_rubetec/ws_rubetec.c ****     if (!json_get(json_slice, "cmd", &cmd_slice)) return false;
