 204:../../ws_rubetec/libjson.h **** 
 205:../../ws_rubetec/libjson.h **** /*
 206:../../ws_rubetec/libjson.h ****  * JsonWriter — zero-allocation JSON serializer.
 207:../../ws_rubetec/libjson.h ****  *
 208:../../ws_rubetec/libjson.h ****  * Writes JSON into a caller-provided buffer. If the buffer runs out of space
 209:../../ws_rubetec/libjson.h ****  * the overflow flag is set and all subsequent writes become silent no-ops.
 210:../../ws_rubetec/libjson.h ****  * Check `json_writer_ok()` once after building the document.
 211:../../ws_rubetec/libjson.h ****  *
 212:../../ws_rubetec/libjson.h ****  * Comma insertion between values is fully automatic. Bitmasks track the
 213:../../ws_rubetec/libjson.h ****  * "needs comma" state and the container type at each nesting depth, using zero
 214:../../ws_rubetec/libjson.h ****  * extra RAM. Since the masks are 32-bit and depth 0 is the top level, nesting
 215:../../ws_rubetec/libjson.h ****  * is limited to JSON_WRITER_MAX_DEPTH levels; exceeding it sets the overflow
 216:../../ws_rubetec/libjson.h ****  * flag rather than corrupting the masks.
 217:../../ws_rubetec/libjson.h ****  *
 218:../../ws_rubetec/libjson.h ****  * Unbalanced or mismatched container ends (`json_write_array_end()` closing an
 219:../../ws_rubetec/libjson.h ****  * object, or an end with no matching begin) also set the overflow flag, so a
 220:../../ws_rubetec/libjson.h ****  * single `json_writer_ok()` check at the end catches structural mistakes as
 221:../../ws_rubetec/libjson.h ****  * well as a too-small buffer.
 222:../../ws_rubetec/libjson.h ****  */
 223:../../ws_rubetec/libjson.h **** #define JSON_WRITER_MAX_DEPTH 31
 224:../../ws_rubetec/libjson.h **** 
 225:../../ws_rubetec/libjson.h **** typedef struct {
 226:../../ws_rubetec/libjson.h ****   char *buf;
 227:../../ws_rubetec/libjson.h ****   size_t cap;
 228:../../ws_rubetec/libjson.h ****   size_t pos;
 229:../../ws_rubetec/libjson.h ****   bool overflow;
 230:../../ws_rubetec/libjson.h ****   unsigned int depth;
 231:../../ws_rubetec/libjson.h ****   unsigned int needs_comma;
 232:../../ws_rubetec/libjson.h ****   unsigned int is_array;
 233:../../ws_rubetec/libjson.h **** } JsonWriter;
 234:../../ws_rubetec/libjson.h **** 
 235:../../ws_rubetec/libjson.h **** /*
 236:../../ws_rubetec/libjson.h ****  * Initialize a writer that targets `buf` with `cap` bytes of space.
 237:../../ws_rubetec/libjson.h ****  *
 238:../../ws_rubetec/libjson.h ****  * The buffer is NOT owned by the writer; the caller manages its lifetime.
 239:../../ws_rubetec/libjson.h ****  * One byte is always reserved for a trailing NUL, so the maximum JSON payload
 240:../../ws_rubetec/libjson.h ****  * length is `cap - 1`.
 241:../../ws_rubetec/libjson.h ****  */
 242:../../ws_rubetec/libjson.h **** void json_writer_init(JsonWriter *w, char *buf, size_t cap);
 243:../../ws_rubetec/libjson.h **** 
 244:../../ws_rubetec/libjson.h **** /*
 245:../../ws_rubetec/libjson.h ****  * Return the number of JSON bytes written so far (excluding NUL terminator).
 246:../../ws_rubetec/libjson.h ****  */
 247:../../ws_rubetec/libjson.h **** size_t json_writer_len(const JsonWriter *w);
 248:../../ws_rubetec/libjson.h **** 
 249:../../ws_rubetec/libjson.h **** /*
 250:../../ws_rubetec/libjson.h ****  * Return true if the writer has not overflowed.
 251:../../ws_rubetec/libjson.h ****  */
 252:../../ws_rubetec/libjson.h **** bool json_writer_ok(const JsonWriter *w);
 253:../../ws_rubetec/libjson.h **** 
 254:../../ws_rubetec/libjson.h **** /*
 255:../../ws_rubetec/libjson.h ****  * Return the NUL-terminated output buffer. Only valid when `json_writer_ok()`
 256:../../ws_rubetec/libjson.h ****  * is true.
 257:../../ws_rubetec/libjson.h ****  */
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccrfH904.s 			page 6


