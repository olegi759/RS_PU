 419:../../ws_rubetec/ws_rubetec.c ****     //собираем поля сообщения
 420:../../ws_rubetec/ws_rubetec.c ****     JsonSlice cmd_slice;
 421:../../ws_rubetec/ws_rubetec.c ****     if (!json_get(json_slice, "cmd", &cmd_slice)) return false;
 422:../../ws_rubetec/ws_rubetec.c ****     
 423:../../ws_rubetec/ws_rubetec.c ****     JsonSlice id_slice;
 424:../../ws_rubetec/ws_rubetec.c ****     if (!json_get(json_slice, "request_id", &id_slice)) return false;
 425:../../ws_rubetec/ws_rubetec.c ****     
 426:../../ws_rubetec/ws_rubetec.c ****     JsonSlice pu_id_slice; // Номер ПУ в сети (1..32)
 427:../../ws_rubetec/ws_rubetec.c ****     if (!json_get(json_slice, "pu_id", &pu_id_slice)) return false;
 428:../../ws_rubetec/ws_rubetec.c ****     
 429:../../ws_rubetec/ws_rubetec.c ****     JsonSlice input_slice; // Номер тревожного входа этого ПУ (1..24)
 430:../../ws_rubetec/ws_rubetec.c ****     if (!json_get(json_slice, "input", &input_slice)) return false;
 431:../../ws_rubetec/ws_rubetec.c **** 
