 531:../../ws_rubetec/ws_rubetec.c ****     if (!json_get(json_slice, "request_id", &id_slice)) return false;
 532:../../ws_rubetec/ws_rubetec.c ****     
 533:../../ws_rubetec/ws_rubetec.c ****         JsonSlice pu_id_slice;
 534:../../ws_rubetec/ws_rubetec.c ****     if (!json_get(json_slice, "pu_id", &pu_id_slice)) return false;
 535:../../ws_rubetec/ws_rubetec.c **** 
