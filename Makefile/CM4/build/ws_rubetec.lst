 373:../../ws_rubetec/ws_rubetec.c **** // Успешный ответ: поля запроса + "status":"accepted"
 374:../../ws_rubetec/ws_rubetec.c **** static void make_json_accept(JsonSlice request)
 375:../../ws_rubetec/ws_rubetec.c **** {
 376:../../ws_rubetec/ws_rubetec.c **** #ifdef RUBETEC_LOG
 377:../../ws_rubetec/ws_rubetec.c ****     ulog_fmt("ACCEPT: req.len=%u req.first=0x%02X req.data=%p answer_buf=%p\r\n",
 378:../../ws_rubetec/ws_rubetec.c ****            (unsigned)request.len,
 379:../../ws_rubetec/ws_rubetec.c ****            request.len ? (unsigned char)request.data[0] : 0,
 380:../../ws_rubetec/ws_rubetec.c ****            (void*)request.data,
 381:../../ws_rubetec/ws_rubetec.c ****            (void*)answer_buf);
 382:../../ws_rubetec/ws_rubetec.c **** #endif
 383:../../ws_rubetec/ws_rubetec.c ****     JsonWriter w;
 384:../../ws_rubetec/ws_rubetec.c ****     json_writer_init(&w, answer_buf, sizeof(answer_buf));
 385:../../ws_rubetec/ws_rubetec.c **** 
 386:../../ws_rubetec/ws_rubetec.c ****     json_write_object_begin(&w);
 387:../../ws_rubetec/ws_rubetec.c **** 
 388:../../ws_rubetec/ws_rubetec.c ****     copy_request_fields(request, &w);
 389:../../ws_rubetec/ws_rubetec.c ****     json_write_str_kv(&w, "status", "accepted");
 390:../../ws_rubetec/ws_rubetec.c **** 
 391:../../ws_rubetec/ws_rubetec.c ****     json_write_object_end(&w);
 392:../../ws_rubetec/ws_rubetec.c **** }
 393:../../ws_rubetec/ws_rubetec.c **** // Ответ с ошибкой: поля запроса + status/error/message
 394:../../ws_rubetec/ws_rubetec.c **** static void make_json_err(JsonSlice request, const char *error, const char *err_msg)
 395:../../ws_rubetec/ws_rubetec.c **** {
 396:../../ws_rubetec/ws_rubetec.c ****     JsonWriter w;
 397:../../ws_rubetec/ws_rubetec.c ****     json_writer_init(&w, answer_buf, sizeof(answer_buf));
 398:../../ws_rubetec/ws_rubetec.c **** 
 399:../../ws_rubetec/ws_rubetec.c ****     json_write_object_begin(&w);
 400:../../ws_rubetec/ws_rubetec.c **** 
 401:../../ws_rubetec/ws_rubetec.c ****     copy_request_fields(request, &w);
 402:../../ws_rubetec/ws_rubetec.c ****     json_write_str_kv(&w, "status",  "rejected");
 403:../../ws_rubetec/ws_rubetec.c ****     json_write_str_kv(&w, "error",   error);
 404:../../ws_rubetec/ws_rubetec.c ****     json_write_str_kv(&w, "message", err_msg);
 405:../../ws_rubetec/ws_rubetec.c **** 
 406:../../ws_rubetec/ws_rubetec.c ****     json_write_object_end(&w);
 407:../../ws_rubetec/ws_rubetec.c **** }
