 280:../../ws_rubetec/libjson.h **** #ifndef JSON_NO_STDIO
 281:../../ws_rubetec/libjson.h **** /*
 282:../../ws_rubetec/libjson.h ****  * Write a double as a JSON number.
 283:../../ws_rubetec/libjson.h ****  *
 284:../../ws_rubetec/libjson.h ****  * The value is printed as the shortest decimal string that reads back as
 285:../../ws_rubetec/libjson.h ****  * exactly the same double, so `0.1` emits `0.1` rather than
 286:../../ws_rubetec/libjson.h ****  * `0.10000000000000001` while still round-tripping bit-for-bit.
 287:../../ws_rubetec/libjson.h ****  *
 288:../../ws_rubetec/libjson.h ****  * JSON has no representation for NaN or infinity. Those values are written as
 289:../../ws_rubetec/libjson.h ****  * `null`, mirroring how `json_write_str()` handles a NULL pointer.
 290:../../ws_rubetec/libjson.h ****  *
 291:../../ws_rubetec/libjson.h ****  * Requires `snprintf()` and `strtod()`, so this function is unavailable in
 292:../../ws_rubetec/libjson.h ****  * `JSON_NO_STDIO` builds.
 293:../../ws_rubetec/libjson.h ****  */
 294:../../ws_rubetec/libjson.h **** void json_write_double(JsonWriter *w, double value);
 295:../../ws_rubetec/libjson.h **** #endif
 296:../../ws_rubetec/libjson.h **** 
 297:../../ws_rubetec/libjson.h **** /*
 298:../../ws_rubetec/libjson.h ****  * Write a NUL-terminated C string as a JSON string with proper escaping.
