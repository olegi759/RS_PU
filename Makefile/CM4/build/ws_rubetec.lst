  95:../../ws_rubetec/libjson.h **** /*
  96:../../ws_rubetec/libjson.h ****  * Decode JSON escape sequences from `slice` into a caller-provided buffer and
  97:../../ws_rubetec/libjson.h ****  * append a trailing NUL byte.
  98:../../ws_rubetec/libjson.h ****  *
  99:../../ws_rubetec/libjson.h ****  * Parsed slices are zero-copy views of the original document, so string keys
 100:../../ws_rubetec/libjson.h ****  * and values still contain their raw escape sequences. This helper resolves
 101:../../ws_rubetec/libjson.h ****  * them: `\" \\ \/ \b \f \n \r \t` and `\uXXXX`, including surrogate pairs,
 102:../../ws_rubetec/libjson.h ****  * which are encoded as UTF-8. The decoded byte length (excluding the NUL) is
 103:../../ws_rubetec/libjson.h ****  * stored in `*out_len` when `out_len` is non-NULL.
 104:../../ws_rubetec/libjson.h ****  *
 105:../../ws_rubetec/libjson.h ****  * Decoded output is never longer than the input, so a buffer of
 106:../../ws_rubetec/libjson.h ****  * `slice.len + 1` bytes always suffices.
 107:../../ws_rubetec/libjson.h ****  *
 108:../../ws_rubetec/libjson.h ****  * Returns false if `buffer` is NULL, the buffer is too small, or the slice
 109:../../ws_rubetec/libjson.h ****  * contains an invalid escape sequence, an unpaired surrogate, or a trailing
 110:../../ws_rubetec/libjson.h ****  * lone backslash.
 111:../../ws_rubetec/libjson.h ****  */
 112:../../ws_rubetec/libjson.h **** bool json_slice_unescape(JsonSlice slice, char *buffer, size_t buffer_size,
 113:../../ws_rubetec/libjson.h ****                          size_t *out_len);
