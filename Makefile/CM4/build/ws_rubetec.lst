 229:../../ws_rubetec/ws_rubetec.c **** 
 230:../../ws_rubetec/ws_rubetec.c **** // Пишет пару "ключ": значение, сохраняя тип значения.
 231:../../ws_rubetec/ws_rubetec.c **** // key — уже готовая C-строка (выходной ключ).
 232:../../ws_rubetec/ws_rubetec.c **** static void write_typed_value(JsonWriter *w, const char *key, JsonSlice value)
 233:../../ws_rubetec/ws_rubetec.c **** {
 234:../../ws_rubetec/ws_rubetec.c ****     json_write_key(w, key);
 235:../../ws_rubetec/ws_rubetec.c **** 
 236:../../ws_rubetec/ws_rubetec.c ****     if (value.len == 0 || value.data == NULL) {
 237:../../ws_rubetec/ws_rubetec.c ****         json_write_null(w);
 238:../../ws_rubetec/ws_rubetec.c ****         return;
 239:../../ws_rubetec/ws_rubetec.c ****     }
 240:../../ws_rubetec/ws_rubetec.c **** 
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccrfH904.s 			page 85


 241:../../ws_rubetec/ws_rubetec.c ****     unsigned char first = (unsigned char)value.data[0];
 242:../../ws_rubetec/ws_rubetec.c ****     bool is_container = (first == '{') || (first == '[');
 243:../../ws_rubetec/ws_rubetec.c ****     bool is_quoted    = (first == '"');
 244:../../ws_rubetec/ws_rubetec.c **** 
 245:../../ws_rubetec/ws_rubetec.c ****     if (is_json_number(value) || is_container || is_quoted || slice_is_literal(value)) {
 246:../../ws_rubetec/ws_rubetec.c ****         json_write_raw(w, value.data, value.len);   // уже корректный JSON-токен
 247:../../ws_rubetec/ws_rubetec.c ****     } else {
 248:../../ws_rubetec/ws_rubetec.c ****         json_write_strn(w, value.data, value.len);  // всё остальное — строкой
 249:../../ws_rubetec/ws_rubetec.c ****     }
 250:../../ws_rubetec/ws_rubetec.c **** }
 251:../../ws_rubetec/ws_rubetec.c **** 
 252:../../ws_rubetec/ws_rubetec.c **** // Копирует все поля запроса, переименовывая "cmd" -> "response
 253:../../ws_rubetec/ws_rubetec.c **** // Без проверок: считается, что ключ всегда помещается �
 254:../../ws_rubetec/ws_rubetec.c **** static void copy_request_fields(JsonSlice request, JsonWriter *w)
 255:../../ws_rubetec/ws_rubetec.c **** {
 256:../../ws_rubetec/ws_rubetec.c ****     JsonObjectIter iter;
 257:../../ws_rubetec/ws_rubetec.c ****     json_object_iter_init(request, &iter);
 258:../../ws_rubetec/ws_rubetec.c **** 
 259:../../ws_rubetec/ws_rubetec.c ****     JsonSlice key, value;
 260:../../ws_rubetec/ws_rubetec.c ****     char key_buf[64]; // с запасом под любой ключ из спецификации
 261:../../ws_rubetec/ws_rubetec.c **** 
 262:../../ws_rubetec/ws_rubetec.c ****     while (json_object_iter_next(&iter, &key, &value)) {
 263:../../ws_rubetec/ws_rubetec.c ****         json_slice_copy(key, key_buf, sizeof(key_buf)); // результат игнорируем
 264:../../ws_rubetec/ws_rubetec.c ****         const char *out_key = slice_eq_str(key, "cmd") ? "response_to" : key_buf;
 265:../../ws_rubetec/ws_rubetec.c ****         write_typed_value(w, out_key, value);
 266:../../ws_rubetec/ws_rubetec.c ****     }
 267:../../ws_rubetec/ws_rubetec.c **** }
 268:../../ws_rubetec/ws_rubetec.c **** 
 269:../../ws_rubetec/ws_rubetec.c **** // Преобразует один hex-символ в значение 0..15. Возвращает
 270:../../ws_rubetec/ws_rubetec.c **** static int hex_digit(char c) {
 271:../../ws_rubetec/ws_rubetec.c ****     if (c >= '0' && c <= '9') return c - '0';
 272:../../ws_rubetec/ws_rubetec.c ****     if (c >= 'a' && c <= 'f') return c - 'a' + 10;
 273:../../ws_rubetec/ws_rubetec.c ****     if (c >= 'A' && c <= 'F') return c - 'A' + 10;
 274:../../ws_rubetec/ws_rubetec.c ****     return -1;
 275:../../ws_rubetec/ws_rubetec.c **** }
 276:../../ws_rubetec/ws_rubetec.c **** 
 277:../../ws_rubetec/ws_rubetec.c **** // Разбирает hex-строку из JsonSlice в uint32_t.
 278:../../ws_rubetec/ws_rubetec.c **** // Поддерживает необязательный префикс "0x" / "0X" и любое �
 279:../../ws_rubetec/ws_rubetec.c **** //   "0x00000003", "0x03", "0x3", "3", "0XFFFFFFFF" — всё корректно.
 280:../../ws_rubetec/ws_rubetec.c **** // Возвращает true при успехе; *out не меняется при ошибке.
 281:../../ws_rubetec/ws_rubetec.c **** static bool parse_hex_uint32_slice(JsonSlice s, uint32_t *out)
 282:../../ws_rubetec/ws_rubetec.c **** {
 283:../../ws_rubetec/ws_rubetec.c ****     if (s.len == 0 || s.data == NULL) return false;
 284:../../ws_rubetec/ws_rubetec.c **** 
 285:../../ws_rubetec/ws_rubetec.c ****     size_t i = 0;
 286:../../ws_rubetec/ws_rubetec.c ****     // Пропускаем необязательный префикс 0x / 0X
 287:../../ws_rubetec/ws_rubetec.c ****     if (s.len >= 2 && s.data[0] == '0' && (s.data[1] == 'x' || s.data[1] == 'X')) {
 288:../../ws_rubetec/ws_rubetec.c ****         i = 2;
 289:../../ws_rubetec/ws_rubetec.c ****     }
 290:../../ws_rubetec/ws_rubetec.c ****     if (i >= s.len) return false; // после префикса ничего нет
 291:../../ws_rubetec/ws_rubetec.c **** 
 292:../../ws_rubetec/ws_rubetec.c ****     uint32_t acc = 0;
 293:../../ws_rubetec/ws_rubetec.c ****     for (; i < s.len; ++i) {
 294:../../ws_rubetec/ws_rubetec.c ****         int d = hex_digit(s.data[i]);
 295:../../ws_rubetec/ws_rubetec.c ****         if (d < 0) return false;
 296:../../ws_rubetec/ws_rubetec.c **** 
 297:../../ws_rubetec/ws_rubetec.c ****         // Проверка переполнения ДО сдвига:
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccrfH904.s 			page 86


 298:../../ws_rubetec/ws_rubetec.c ****         // если acc > 0x0FFFFFFF, то acc << 4 уже не поместится в uint32_t.
 299:../../ws_rubetec/ws_rubetec.c ****         if (acc > (UINT32_MAX >> 4)) return false;
 300:../../ws_rubetec/ws_rubetec.c ****         acc = (acc << 4) | (uint32_t)d;
 301:../../ws_rubetec/ws_rubetec.c ****     }
 302:../../ws_rubetec/ws_rubetec.c ****     *out = acc;
 303:../../ws_rubetec/ws_rubetec.c ****     return true;
 304:../../ws_rubetec/ws_rubetec.c **** }
 305:../../ws_rubetec/ws_rubetec.c **** 
 306:../../ws_rubetec/ws_rubetec.c **** static void write_hex_mask_kv(JsonWriter *w, const char *key, uint32_t value)
 307:../../ws_rubetec/ws_rubetec.c **** {
 308:../../ws_rubetec/ws_rubetec.c ****     static const char hex[] = "0123456789ABCDEF";
 309:../../ws_rubetec/ws_rubetec.c ****     char buf[12];                          // "0x" + до 8 цифр + '\0'
 310:../../ws_rubetec/ws_rubetec.c ****     char *p = buf + sizeof(buf) - 1;
 311:../../ws_rubetec/ws_rubetec.c ****     *p = '\0';
 312:../../ws_rubetec/ws_rubetec.c **** 
 313:../../ws_rubetec/ws_rubetec.c ****     int digits = 0;
 314:../../ws_rubetec/ws_rubetec.c ****     do {
 315:../../ws_rubetec/ws_rubetec.c ****         *--p = hex[value & 0xF];
 316:../../ws_rubetec/ws_rubetec.c ****         value >>= 4;
 317:../../ws_rubetec/ws_rubetec.c ****         digits++;
 318:../../ws_rubetec/ws_rubetec.c ****     } while (value > 0 || digits < 2);
 319:../../ws_rubetec/ws_rubetec.c **** 
 320:../../ws_rubetec/ws_rubetec.c ****     *--p = 'x';
 321:../../ws_rubetec/ws_rubetec.c ****     *--p = '0';
 322:../../ws_rubetec/ws_rubetec.c **** 
 323:../../ws_rubetec/ws_rubetec.c ****     json_write_key(w, key);
 324:../../ws_rubetec/ws_rubetec.c ****     json_write_str(w, p);                  // пишет с кавычками
 325:../../ws_rubetec/ws_rubetec.c **** }
 326:../../ws_rubetec/ws_rubetec.c **** 
 327:../../ws_rubetec/ws_rubetec.c **** // Разбирает "pu_id_mask" в битовую маску uint32_t.
 328:../../ws_rubetec/ws_rubetec.c **** // Поддерживает:
 329:../../ws_rubetec/ws_rubetec.c **** //   - массив:  [1, 2, 3]  -> 0x00000007 (ПУ N -> бит N-1)
 330:../../ws_rubetec/ws_rubetec.c **** //   - число 0:            -> 0xFFFFFFFF (все ПУ выбраны)
 331:../../ws_rubetec/ws_rubetec.c **** //   - число N (1..32):    -> 0x1 << (N-1) (одно ПУ)
 332:../../ws_rubetec/ws_rubetec.c **** // Ведущие пробелы/табы/CR/LF игнорируются.
 333:../../ws_rubetec/ws_rubetec.c **** static bool parse_pu_id_mask(JsonSlice s, uint32_t *out)
 334:../../ws_rubetec/ws_rubetec.c **** {
 335:../../ws_rubetec/ws_rubetec.c ****     if (s.data == NULL || s.len == 0) return false;
 336:../../ws_rubetec/ws_rubetec.c **** 
 337:../../ws_rubetec/ws_rubetec.c ****     // 1. Пропуск ведущих whitespace (корректное условие — &&)
 338:../../ws_rubetec/ws_rubetec.c ****     size_t i = 0;
 339:../../ws_rubetec/ws_rubetec.c ****     while (i < s.len &&
 340:../../ws_rubetec/ws_rubetec.c ****            (s.data[i] == ' '  || s.data[i] == '\t' ||
 341:../../ws_rubetec/ws_rubetec.c ****             s.data[i] == '\r' || s.data[i] == '\n')) {
 342:../../ws_rubetec/ws_rubetec.c ****         i++;
 343:../../ws_rubetec/ws_rubetec.c ****     }
 344:../../ws_rubetec/ws_rubetec.c ****     if (i >= s.len) return false;            // только пробелы — не значени
 345:../../ws_rubetec/ws_rubetec.c **** 
 346:../../ws_rubetec/ws_rubetec.c ****     JsonSlice trimmed = { s.data + i, s.len - i };
 347:../../ws_rubetec/ws_rubetec.c **** 
 348:../../ws_rubetec/ws_rubetec.c ****     // 2. Массив [1, 2, 3]
 349:../../ws_rubetec/ws_rubetec.c ****     if (trimmed.data[0] == '[') {
 350:../../ws_rubetec/ws_rubetec.c ****         JsonArrayIter iter;
 351:../../ws_rubetec/ws_rubetec.c ****         json_array_iter_init(trimmed, &iter);
 352:../../ws_rubetec/ws_rubetec.c **** 
 353:../../ws_rubetec/ws_rubetec.c ****         JsonSlice item;
 354:../../ws_rubetec/ws_rubetec.c ****         uint32_t mask  = 0;
ARM GAS  C:\Users\oleg\AppData\Local\Temp\ccrfH904.s 			page 87


 355:../../ws_rubetec/ws_rubetec.c ****         size_t   count = 0;
 356:../../ws_rubetec/ws_rubetec.c **** 
 357:../../ws_rubetec/ws_rubetec.c ****         while (json_array_iter_next(&iter, &item)) {
 358:../../ws_rubetec/ws_rubetec.c ****             uint8_t id;
 359:../../ws_rubetec/ws_rubetec.c ****             if (!parse_uint8_slice(item, &id)) return false;
 360:../../ws_rubetec/ws_rubetec.c ****             if (id < 1 || id > 32)            return false;
 361:../../ws_rubetec/ws_rubetec.c **** 
 362:../../ws_rubetec/ws_rubetec.c ****             mask |= (uint32_t)1u << (id - 1);
 363:../../ws_rubetec/ws_rubetec.c ****             count++;
 364:../../ws_rubetec/ws_rubetec.c ****         }
 365:../../ws_rubetec/ws_rubetec.c ****         if (count == 0) return false;        // пустой массив []
 366:../../ws_rubetec/ws_rubetec.c ****         *out = mask;
 367:../../ws_rubetec/ws_rubetec.c ****         return true;
 368:../../ws_rubetec/ws_rubetec.c ****     }
 369:../../ws_rubetec/ws_rubetec.c **** 
 370:../../ws_rubetec/ws_rubetec.c ****     // 3. Одиночное число: 0 или 1..32
 371:../../ws_rubetec/ws_rubetec.c ****     uint8_t val;
 372:../../ws_rubetec/ws_rubetec.c ****     if (!parse_uint8_slice(trimmed, &val)) return false;
 373:../../ws_rubetec/ws_rubetec.c **** 
 374:../../ws_rubetec/ws_rubetec.c ****     if (val == 0) {
 375:../../ws_rubetec/ws_rubetec.c ****         // 0 = выбрать все ПУ (1..32)
 376:../../ws_rubetec/ws_rubetec.c ****         *out = 0;
 377:../../ws_rubetec/ws_rubetec.c ****         for (uint8_t b = 0; b < MAX_PU_NUMBER; ++b) {
 378:../../ws_rubetec/ws_rubetec.c ****             *out |= (uint32_t)1u << b;
 379:../../ws_rubetec/ws_rubetec.c ****         }
 380:../../ws_rubetec/ws_rubetec.c ****         // Эквивалент: *out = 0xFFFFFFFFu;
 381:../../ws_rubetec/ws_rubetec.c ****         return true;
 382:../../ws_rubetec/ws_rubetec.c ****     }
 383:../../ws_rubetec/ws_rubetec.c ****     if (val > 32) return false;
 384:../../ws_rubetec/ws_rubetec.c **** 
 385:../../ws_rubetec/ws_rubetec.c ****     *out = (uint32_t)1u << (val - 1);        // одно ПУ -> один бит
 386:../../ws_rubetec/ws_rubetec.c ****     return true;
 387:../../ws_rubetec/ws_rubetec.c **** }
 388:../../ws_rubetec/ws_rubetec.c **** 
 389:../../ws_rubetec/ws_rubetec.c **** static void white_array_by_mask_kv(JsonWriter *w, const char *key, uint32_t value_mask){
 390:../../ws_rubetec/ws_rubetec.c ****     json_write_array_begin_k(w, key);
 391:../../ws_rubetec/ws_rubetec.c ****     for(uint8_t i = 0; i < 32; ++i){
 392:../../ws_rubetec/ws_rubetec.c ****         if( (value_mask & ((uint32_t)1 << i)) ){
 393:../../ws_rubetec/ws_rubetec.c ****              json_write_int(w, i + 1);
 394:../../ws_rubetec/ws_rubetec.c ****         }
 395:../../ws_rubetec/ws_rubetec.c ****     }
 396:../../ws_rubetec/ws_rubetec.c ****     json_write_array_end(w);
 397:../../ws_rubetec/ws_rubetec.c **** }
