 202:../../ws_rubetec/ws_rubetec.c **** 
 203:../../ws_rubetec/ws_rubetec.c **** // Пишет пару "ключ": значение, сохраняя тип значения.
 204:../../ws_rubetec/ws_rubetec.c **** // key — уже готовая C-строка (выходной ключ).
 205:../../ws_rubetec/ws_rubetec.c **** static void write_typed_value(JsonWriter *w, const char *key, JsonSlice value)
 206:../../ws_rubetec/ws_rubetec.c **** {
 207:../../ws_rubetec/ws_rubetec.c ****     json_write_key(w, key);
 208:../../ws_rubetec/ws_rubetec.c **** 
 209:../../ws_rubetec/ws_rubetec.c ****     if (value.len == 0 || value.data == NULL) {
 210:../../ws_rubetec/ws_rubetec.c ****         json_write_null(w);
 211:../../ws_rubetec/ws_rubetec.c ****         return;
 212:../../ws_rubetec/ws_rubetec.c ****     }
 213:../../ws_rubetec/ws_rubetec.c **** 
 214:../../ws_rubetec/ws_rubetec.c ****     unsigned char first = (unsigned char)value.data[0];
 215:../../ws_rubetec/ws_rubetec.c ****     bool is_container = (first == '{') || (first == '[');
 216:../../ws_rubetec/ws_rubetec.c ****     bool is_quoted    = (first == '"');
 217:../../ws_rubetec/ws_rubetec.c **** 
 218:../../ws_rubetec/ws_rubetec.c ****     if (is_json_number(value) || is_container || is_quoted || slice_is_literal(value)) {
 219:../../ws_rubetec/ws_rubetec.c ****         json_write_raw(w, value.data, value.len);   // уже корректный JSON-токен
 220:../../ws_rubetec/ws_rubetec.c ****     } else {
 221:../../ws_rubetec/ws_rubetec.c ****         json_write_strn(w, value.data, value.len);  // всё остальное — строкой
 222:../../ws_rubetec/ws_rubetec.c ****     }
 223:../../ws_rubetec/ws_rubetec.c **** }
 224:../../ws_rubetec/ws_rubetec.c **** 
 225:../../ws_rubetec/ws_rubetec.c **** // Копирует все поля запроса, переименовывая "cmd" -> "response
 226:../../ws_rubetec/ws_rubetec.c **** // Без проверок: считается, что ключ всегда помещается �
 227:../../ws_rubetec/ws_rubetec.c **** static void copy_request_fields(JsonSlice request, JsonWriter *w)
 228:../../ws_rubetec/ws_rubetec.c **** {
 229:../../ws_rubetec/ws_rubetec.c ****     JsonObjectIter iter;
 230:../../ws_rubetec/ws_rubetec.c ****     json_object_iter_init(request, &iter);
 231:../../ws_rubetec/ws_rubetec.c **** 
 232:../../ws_rubetec/ws_rubetec.c ****     JsonSlice key, value;
 233:../../ws_rubetec/ws_rubetec.c ****     char key_buf[64]; // с запасом под любой ключ из спецификации
 234:../../ws_rubetec/ws_rubetec.c **** 
 235:../../ws_rubetec/ws_rubetec.c ****     while (json_object_iter_next(&iter, &key, &value)) {
 236:../../ws_rubetec/ws_rubetec.c ****         json_slice_copy(key, key_buf, sizeof(key_buf)); // результат игнорируем
 237:../../ws_rubetec/ws_rubetec.c ****         const char *out_key = slice_eq_str(key, "cmd") ? "response_to" : key_buf;
 238:../../ws_rubetec/ws_rubetec.c ****         write_typed_value(w, out_key, value);
 239:../../ws_rubetec/ws_rubetec.c ****     }
 240:../../ws_rubetec/ws_rubetec.c **** }
