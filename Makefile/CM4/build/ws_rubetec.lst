 446:../../ws_rubetec/ws_rubetec.c ****         make_json_err(json_slice, "param_err", "internal input");
 447:../../ws_rubetec/ws_rubetec.c ****         send_answer();
 448:../../ws_rubetec/ws_rubetec.c ****         return true;
 449:../../ws_rubetec/ws_rubetec.c ****     }
 450:../../ws_rubetec/ws_rubetec.c ****     if(input_line_id == 0 || input_line_id > 24) {
 451:../../ws_rubetec/ws_rubetec.c ****         make_json_err(json_slice, "param_err", "input должен быть от (1..24)");
 452:../../ws_rubetec/ws_rubetec.c ****         send_answer();
 453:../../ws_rubetec/ws_rubetec.c ****         return true;
 454:../../ws_rubetec/ws_rubetec.c ****     }
 455:../../ws_rubetec/ws_rubetec.c **** 
 456:../../ws_rubetec/ws_rubetec.c ****     rubetec_on_start_alert_rec(pu_id, input_line_id);
 457:../../ws_rubetec/ws_rubetec.c **** 
 458:../../ws_rubetec/ws_rubetec.c ****     return true;
 459:../../ws_rubetec/ws_rubetec.c **** }
