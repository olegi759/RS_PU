 302:../../CM4/Core/Src/cm4core.c **** 	int16_t packet_len;
 303:../../CM4/Core/Src/cm4core.c **** 	uint8_t packet[SM_MAX_PACKET_SIZE];
 304:../../CM4/Core/Src/cm4core.c **** 
 305:../../CM4/Core/Src/cm4core.c **** 	sm->rb_cm7_to_cm4.busy = 1;
 306:../../CM4/Core/Src/cm4core.c **** 	packet_len = ringbuff_read_packet(&sm->rb_cm7_to_cm4, packet, sizeof(packet));
 307:../../CM4/Core/Src/cm4core.c **** 	sm->rb_cm7_to_cm4.busy = 0;
