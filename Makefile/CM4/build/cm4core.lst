 323:../../CM4/Core/Src/cm4core.c **** BOOL cm4core_wait_cmd_from_CM7(uint8_t cmd, uint8_t * cmd_data, uint16_t cmd_data_size, uint32_t ti
 324:../../CM4/Core/Src/cm4core.c **** {
 325:../../CM4/Core/Src/cm4core.c **** 	uint32_t start_tick;
 326:../../CM4/Core/Src/cm4core.c **** 	uint16_t packet_len, len;
 327:../../CM4/Core/Src/cm4core.c **** 	uint8_t packet[SM_MAX_PACKET_SIZE];
 328:../../CM4/Core/Src/cm4core.c **** 
 329:../../CM4/Core/Src/cm4core.c **** 	start_tick = HAL_GetTick();
 330:../../CM4/Core/Src/cm4core.c **** 
 331:../../CM4/Core/Src/cm4core.c **** 	while (HAL_DiffTick(start_tick) < timeout) {
 332:../../CM4/Core/Src/cm4core.c **** 		if ( (!sm->rb_cm7_to_cm4.busy) && (ringbuff_get_full(&sm->rb_cm7_to_cm4) > 4) ) {
 333:../../CM4/Core/Src/cm4core.c **** 			sm->rb_cm7_to_cm4.busy = 1;
 334:../../CM4/Core/Src/cm4core.c **** 			packet_len = ringbuff_read_packet(&sm->rb_cm7_to_cm4, packet, sizeof(packet));
 335:../../CM4/Core/Src/cm4core.c **** 			sm->rb_cm7_to_cm4.busy = 0;
 336:../../CM4/Core/Src/cm4core.c **** 			if (packet_len)  {
 337:../../CM4/Core/Src/cm4core.c **** 				if (packet[0] == cmd) {
 338:../../CM4/Core/Src/cm4core.c **** 					len = packet_len - 1;
 339:../../CM4/Core/Src/cm4core.c **** 					if (len > cmd_data_size) len = cmd_data_size;
 340:../../CM4/Core/Src/cm4core.c **** 					if (len) memcpy(cmd_data, &packet[1], len);
 341:../../CM4/Core/Src/cm4core.c **** 					*cmd_data_len = len;
 342:../../CM4/Core/Src/cm4core.c **** 					return TRUE;
 343:../../CM4/Core/Src/cm4core.c **** 				}
 344:../../CM4/Core/Src/cm4core.c **** 				cm4core_rcv_from_CM7(packet, packet_len);
 345:../../CM4/Core/Src/cm4core.c **** 			}
 346:../../CM4/Core/Src/cm4core.c **** 
 347:../../CM4/Core/Src/cm4core.c **** 		}
 348:../../CM4/Core/Src/cm4core.c **** 		HAL_IWDG_Refresh(&hiwdg2);
 349:../../CM4/Core/Src/cm4core.c **** 	}
 350:../../CM4/Core/Src/cm4core.c **** 	return FALSE;
 351:../../CM4/Core/Src/cm4core.c **** }
