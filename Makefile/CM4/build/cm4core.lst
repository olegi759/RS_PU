  36:../../CM4/Core/Src/cm4core.c **** //Установка транслирующих линий на МКК
  37:../../CM4/Core/Src/cm4core.c **** void cm4core_enable_lines(uint32_t lines)
  38:../../CM4/Core/Src/cm4core.c **** {
  39:../../CM4/Core/Src/cm4core.c **** 	int i;
  40:../../CM4/Core/Src/cm4core.c **** 	uint32_t um1, um2, res;
  41:../../CM4/Core/Src/cm4core.c **** 	uint8_t line_on, um1_on, um2_on;
  42:../../CM4/Core/Src/cm4core.c **** 
  43:../../CM4/Core/Src/cm4core.c **** 
  44:../../CM4/Core/Src/cm4core.c **** 	um1 = 0;
  45:../../CM4/Core/Src/cm4core.c **** 	um2 = 0;
  46:../../CM4/Core/Src/cm4core.c **** 
  47:../../CM4/Core/Src/cm4core.c **** 	for (i = 0; i < 24; i++) {
  48:../../CM4/Core/Src/cm4core.c **** 		line_on = GETBIT(lines, i); //включена ли линия
  49:../../CM4/Core/Src/cm4core.c **** 		um1_on = GETBIT(setting.mkk_um1, i); //включен на УМ1
  50:../../CM4/Core/Src/cm4core.c **** 		um2_on = GETBIT(setting.mkk_um2, i); //включен на УМ2
  51:../../CM4/Core/Src/cm4core.c **** 		if (line_on && um1_on) {
  52:../../CM4/Core/Src/cm4core.c **** 			SETBIT(um1, i);
  53:../../CM4/Core/Src/cm4core.c **** 		}
  54:../../CM4/Core/Src/cm4core.c **** 		if (line_on && um2_on) {
  55:../../CM4/Core/Src/cm4core.c **** 			SETBIT(um2, i);
  56:../../CM4/Core/Src/cm4core.c **** 		}
  57:../../CM4/Core/Src/cm4core.c **** 	}
  58:../../CM4/Core/Src/cm4core.c **** 
  59:../../CM4/Core/Src/cm4core.c **** 	mkk_send_lin(UART2_MUX_MKKL_1, um1 & 0xFFF, um2 & 0xFFF);
  60:../../CM4/Core/Src/cm4core.c **** 	HAL_Delay(50);
  61:../../CM4/Core/Src/cm4core.c **** 	mkk_send_lin(UART2_MUX_MKKL_2, (um1 >> 12) & 0xFFF, (um2 >> 12) & 0xFFF);
  62:../../CM4/Core/Src/cm4core.c **** 	HAL_Delay(50);
  63:../../CM4/Core/Src/cm4core.c **** 	um_snd_modes_all(um1 ? CH_MODE_TRANSLATION : CH_MODE_STANDBY, um2 ? CH_MODE_TRANSLATION :CH_MODE_S
  64:../../CM4/Core/Src/cm4core.c **** 
  65:../../CM4/Core/Src/cm4core.c **** 	res = um1 | um2;
  66:../../CM4/Core/Src/cm4core.c **** 
  67:../../CM4/Core/Src/cm4core.c **** 	if (res != pu_enable_lines) ulog_fmt(CONM"pu: enable sound lines %s"CRLF, u24l2bitstr(res));
  68:../../CM4/Core/Src/cm4core.c **** 
  69:../../CM4/Core/Src/cm4core.c **** 	pu_enable_lines = res;
  70:../../CM4/Core/Src/cm4core.c **** 
  71:../../CM4/Core/Src/cm4core.c **** 	if (pu_option == PU_OPTION_NONE) {
  72:../../CM4/Core/Src/cm4core.c **** 
  73:../../CM4/Core/Src/cm4core.c **** 		mki_enable_led_from_lines(pu_enable_lines, pu_mode2ledcolor(pu_mode));
  74:../../CM4/Core/Src/cm4core.c **** 	}
